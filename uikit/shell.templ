package uikit

import (
	"github.com/housecat-inc/scratch/ui/app"
	codexui "github.com/housecat-inc/scratch/ui/components/codex"
)

templ Shell(p ShellProps) {
	@app.Body(withRail(ctx, shellIn(p))) {
		<div class={ mainClass(p.MainClass) }>
			{ children... }
		</div>
	}
}

templ chatRailContent() {
	<section id={ codexui.MailContentID } class="flex min-h-0 min-w-0 flex-1 flex-col" data-chat aria-label="Chat transcript"></section>
}
