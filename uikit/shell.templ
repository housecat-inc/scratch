package uikit

templ Shell(p ShellProps) {
 <script src="/static/updates.js" defer></script>
 <button type="button" class="app-restart" data-app-restart hidden title="Apply the latest build. Active chats will be interrupted." aria-live="polite">Pending changes — Restart</button>
	<div class={ shellClass(p.Class) }>
		<header class="mail-mobile-header">
			<button type="button" class="mail-mobile-nav" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mail-navigation" data-nav-toggle>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
			</button>
			<a class="mail-mobile-brand" href={ templ.SafeURL(p.BrandHref) }>{ p.AppName }</a>
		</header>
		<div class="mail-body">
			<button type="button" class="mail-nav-backdrop" data-nav-close aria-label="Close navigation"></button>
 <aside class="mail-sidebar" id="mail-navigation">

				<nav class="mail-labels" aria-label="Primary">
					{{ sectionHref := "" }}
					for i, item := range p.Nav {
                        if !item.Child {
                            {{ sectionHref = item.Href }}
                        }
						if item.Group != "" {
							<div class="mail-label-group">{ item.Group }</div>
						}
						<a href={ templ.SafeURL(item.Href) } class={ "gm-label", templ.KV("active", item.Active && creationNavigation(ctx) == ""), templ.KV("gm-label-section", item.Section), templ.KV("gm-label-child", item.Child) }>
							if item.Icon != "" {
								<span class="gm-label-icon">@Icon(item.Icon)</span>
							}
							<span class="gm-label-name" data-label={ item.Label }>{ item.Label }</span>
							if item.CountURL != "" {
								<span class="gm-label-count" title="Running workflows" aria-label="Running workflows" aria-live="polite" hx-get={ item.CountURL } hx-trigger="load, every 5s" hx-swap="innerHTML">{ countLabel(item.Count) }</span>
							} else if item.Count > 0 {
								<span class="gm-label-count">{ countLabel(item.Count) }</span>
							}
						</a>
						if item.Sidebar && p.Sidebar != nil {
							<div class="mail-nav-children">@p.Sidebar</div>
						}
                        if item.Sidebar {
                            @sidebarChatAction(p)
                        }
                        if sectionHref == "/pages" && (i+1 == len(p.Nav) || !p.Nav[i+1].Child) {
                            <div class="mail-create-actions">
                                <a class={ "gm-label gm-label-child", templ.KV("active", creationNavigation(ctx) == "page") } href="/pages/new" data-new-item="page"><span>+ New page</span></a>
                            </div>
                        }
                        if item.Href == "/inbox/workflows" {
                            <div class="mail-create-actions">
                                <a class={ "gm-label gm-label-child", templ.KV("active", creationNavigation(ctx) == "workflow") } href="/inbox/workflows/new" data-new-item="workflow"><span>+ New workflow</span></a>
                            </div>
                        }
					}
                    if !hasSidebarItem(p.Nav) {
                        if p.Sidebar != nil {
                            @p.Sidebar
                        }
                        @sidebarChatAction(p)
                    }
                </nav>
			</aside>
			<main class={ mainClass(p.MainClass, p.Footer) }>
				if ShellHeader(ctx) != nil {
 @ShellHeader(ctx)
 }
 { children... }
			</main>
		</div>
		if p.Footer != nil {
			<footer class="mail-footer">
				@p.Footer
			</footer>
		}
        <button type="button" class="chat-collapse-tab" data-chat-collapse aria-label="Collapse chat sidebar" aria-expanded="true" aria-controls="floating-chat" title="Collapse chat sidebar">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
        </button>
        <button type="button" class="chat-launcher" data-chat-launcher aria-label="Open chat sidebar" aria-controls="floating-chat">
            @Icon("chat")
            <span>Chat</span>
        </button>
		<div class="mail-mobile-switch" role="group" aria-label="Workspace view">
			<button type="button" class="mail-mobile-menu" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mail-navigation" data-nav-toggle>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
				<span>Menu</span>
			</button>
			<button type="button" data-mobile-view="work" aria-pressed="true">Work</button>
			<button type="button" data-mobile-view="chat" aria-pressed="false">Chat</button>
		</div>
	</div>
}

templ Icon(name string) {
	switch name {
		case "archive":
			@lucide(`<rect width="20" height="5" x="2" y="3" rx="1"></rect><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path><path d="M10 12h4"></path>`)
		case "chart":
			@lucide(`<path d="M3 3v18h18"></path><path d="M7 14v3M12 9v8M17 5v12"></path>`)
		case "chat":
			@lucide(`<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>`)
		case "check":
			@lucide(`<path d="M20 6 9 17l-5-5"></path>`)
		case "chevron-down":
			@lucide(`<path d="m6 9 6 6 6-6"></path>`)
		case "code":
			@lucide(`<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>`)
		case "edit":
			@lucide(`<path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>`)
		case "file":
			@lucide(`<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path>`)
		case "history":
			@lucide(`<path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 3v6h6"></path><path d="M12 7v5l3 2"></path>`)
		case "home":
			@lucide(`<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"></path><path d="M9 21v-9h6v9"></path>`)
		case "inbox":
			@lucide(`<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>`)
		case "play":
			@lucide(`<polygon points="6 3 20 12 6 21 6 3"></polygon>`)
		case "reopen":
			@lucide(`<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path>`)
		case "settings":
			@lucide(`<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.52a2 2 0 0 1-1 1.72l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.72v-.52a2 2 0 0 1 1-1.72l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle>`)
		case "star":
			@lucide(`<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>`)
		case "task":
			@lucide(`<path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>`)
		case "trash":
			@lucide(`<path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line>`)
		default:
			@lucide(`<circle cx="12" cy="12" r="10"></circle>`)
	}
}

templ lucide(paths string) {
	@templ.Raw(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">` + paths + `</svg>`)
}

 templ sidebarChatAction(p ShellProps) {
    <div class="mail-create-actions">
        if p.Actions != nil {
            @p.Actions
        } else {
            @NewChatAction(NewChatActionProps{})
        }
    </div>
 }
