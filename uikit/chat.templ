package uikit

templ ChatPluginScripts() {
	<script src="/static/htmx.min.js"></script>
	<script src="/static/htmx-ext-sse.min.js"></script>
	<script src="/static/html2canvas.min.js" defer></script>
	<script src="/static/chat.js" defer></script>
}

templ NewChatAction(p NewChatActionProps) {
	<form class="mail-create-combo" method="get" action={ newChatAction(p.Action) } data-chat-popout-new>
		if p.Label != "" {
			<input type="hidden" name="chat_label" value={ p.Label }/>
		}
		<button class="mail-create-btn" type="submit" data-new-chat title="New chat" aria-label="New chat">
			@Icon("plus")
			<span>Chat</span>
		</button>
		if len(p.Options) > 0 {
			<span class="mail-create-select-wrap mail-model-select-wrap">
				<select class="mail-create-select" name="provider_model" aria-label="Provider and model" data-submit-on-change>
					for _, option := range p.Options {
						<option value={ option.Value }>{ option.Label }</option>
					}
				</select>
				<span class="mail-create-chevron">@Icon("chevron-down")</span>
			</span>
		}
	</form>
}

templ ChatHistoryAction(href string) {
	<a aria-label="Chat history" class="mail-create-btn" data-chat-history href={ templ.SafeURL(historyHref(href)) } title="Chat history">
		@Icon("history")
	</a>
}
