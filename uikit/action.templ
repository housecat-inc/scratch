package uikit

templ ActionIcon(p ActionIconProps) {
	<button type="button" class={ "gm-row-action", templ.KV("danger", p.Danger) } title={ p.Label } aria-label={ p.Label } onclick="event.stopPropagation()" { p.Attrs... }>
		@p.Icon
	</button>
}

templ ActionIcons() {
	<div class="gm-row-actions gm-row-actions-inline">
		{ children... }
	</div>
}
