package ui

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/housecat-inc/scratch/pkg/db"
	"github.com/housecat-inc/scratch/uikit"
	lucide "github.com/wux4an/lucide-templ/icons"
)

templ InboxPage(p InboxProps) {
	<!DOCTYPE html>
	<html lang="en">
		@MailHead(inboxTitle(p)) {
			<script src="/static/inbox.js" defer></script>
		}
		<body>
			@uikit.Shell(uikit.ShellProps{
				Actions: InboxActions(p),
				AppName: "scratch",
				BrandHref: "/",
				Footer: MailComposer(p),
				Nav: inboxNavItems(p),
				SidebarTop: ComposeActions(),
			}) {
				if p.Task != nil {
					@InboxTaskReader(*p.Task)
				} else if p.Draft != nil {
					@InboxDraftReader(*p.Draft)
				} else if p.Schedule != nil {
					@InboxScheduleReader(*p.Schedule)
				} else if p.Workflow != nil {
					@InboxWorkflowReader(*p.Workflow)
				} else if p.Thread != nil {
					@InboxThreadReader(*p.Thread)
				} else {
					@InboxListView(p)
				}
			}
		</body>
	</html>
}

templ InboxActions(p InboxProps) {
	@uikit.NewChatAction(uikit.NewChatActionProps{Options: p.ChatOptions})
}

templ ComposeActions() {
	<div class="mail-compose-actions">
		@composeButton("task", "Task", "New task")
		@createWorkflowButton()
	</div>
}

templ composeButton(mode, label, aria string) {
	<form class="mail-compose-btn-form" method="post" action="/compose">
		<input type="hidden" name="mode" value={ mode }/>
		<input type="hidden" name="create_only" value="true"/>
		<button class="mail-compose-btn" type="submit" title={ aria } aria-label={ aria }>
			@lucide.Plus()
			<span>{ label }</span>
		</button>
	</form>
}

templ MailShell(p InboxProps) {
	<div class="mail-shell">
		<header class="mail-topbar">
			<a class="mail-brand" href="/">
				<img class="mail-brand-logo" src="/static/icon.svg" alt="" aria-hidden="true"/>
				<span>scratch</span>
			</a>
			<div class="mail-create-actions">
				@uikit.NewChatAction(uikit.NewChatActionProps{Options: p.ChatOptions})
				@createButton("task", "New task", lucide.ListChecks())
				@createWorkflowButton()
			</div>
		</header>
		<div class="mail-body">
			<aside class="mail-sidebar">
				<nav class="mail-labels" aria-label="Mail">
					@mailLabel("/", "inbox", p.View, "Inbox", p.Counts.Inbox, lucide.Inbox())
					@mailLabel("/starred", "starred", p.View, "Starred", p.Counts.Starred, lucide.Star())
					<div class="mail-label-group">More</div>
					@mailLabel("/inbox/chats", "chats", p.View, "Chats", p.Counts.Chats, lucide.MessageSquare())
					@mailLabel("/inbox/tasks", "tasks", p.View, "Tasks", p.Counts.Tasks, lucide.ListChecks())
					@mailLabel("/inbox/workflows", "workflows", p.View, "Workflows", p.Counts.Workflows, lucide.Workflow())
				</nav>
			</aside>
			<main class="mail-main">
				{ children... }
			</main>
		</div>
		<footer class="mail-footer">
			@MailComposer(p)
		</footer>
	</div>
}

templ MailComposer(p InboxProps) {
	if p.Thread != nil {
		@ChatComposer(threadComposerProps(*p.Thread))
	} else {
		@ChatComposer(composeComposerProps(p))
	}
}

templ InboxListView(p InboxProps) {
	<header class="mail-mainbar">
		<div class="mail-mainbar-title">
			<h1>{ inboxTitle(p) }</h1>
			if showArchiveFilters(p.View) {
				<nav class="mail-filter-tabs" aria-label="Archive filter">
					@archiveFilterTab(p.View, p.ArchiveFilter, "all", "All")
					@archiveFilterTab(p.View, p.ArchiveFilter, "active", "Active")
					@archiveFilterTab(p.View, p.ArchiveFilter, "archived", "Archived")
				</nav>
			}
		</div>
		<span>{ strconv.Itoa(inboxListCount(p)) }</span>
	</header>
	if len(p.Items) == 0 && (p.View != "workflows" || len(p.Schedules) == 0) {
		<div class="mail-empty">Nothing here.</div>
	} else {
		<div class="mail-list">
			if p.View == "workflows" {
				for _, sc := range p.Schedules {
					@ScheduleRow(sc)
				}
			}
			for _, item := range p.Items {
				@InboxRow(item, p.View, p.ArchiveFilter)
			}
		</div>
	}
}

templ ScheduleRow(sc WorkflowScheduleView) {
	@uikit.ListRow(uikit.ListRowProps{
		Actions: ScheduleRowActions(sc),
		Href: scheduleInboxURL(sc.Name),
		ID: sc.Name,
		Kind: "workflow",
		Labels: scheduleRowLabels(sc),
		Primary: ScheduleRowPrimary(sc),
		Subject: sc.Cron,
		What: sc.Name,
		When: sc.LastFired,
	})
}

templ ScheduleRowPrimary(sc WorkflowScheduleView) {
	<button type="button" class="gm-star" title="Star" aria-label="Star" onclick="event.stopPropagation()">
		@lucide.Star()
	</button>
}

templ ScheduleRowActions(sc WorkflowScheduleView) {
	@scheduleButton(sc.Name, "trigger", "Run now", lucide.Send())
	if sc.Paused {
		@scheduleButton(sc.Name, "resume", "Resume", lucide.Play())
	} else {
		@scheduleButton(sc.Name, "pause", "Pause", lucide.Pause())
	}
}

templ scheduleButton(name, action, label string, icon templ.Component) {
	<form method="post" action={ templ.SafeURL("/inbox/schedules/" + url.PathEscape(name) + "/" + action) }>
		<input type="hidden" name="back" value="/inbox/workflows"/>
		<button type="submit" class="gm-row-action" title={ label } aria-label={ label } data-schedule-btn={ action } onclick="event.stopPropagation()">
			@icon
		</button>
	</form>
}

templ archiveFilterTab(view, active, value, label string) {
	<a href={ templ.SafeURL(archiveFilterHref(view, value)) } class={ "mail-filter-tab", templ.KV("active", active == value) }>{ label }</a>
}

templ InboxRow(item InboxItem, view, filter string) {
	@uikit.ListRow(uikit.ListRowProps{
		Actions: InboxRowActions(item, view, filter),
		Archived: item.Archived,
		Done: item.Done,
		Href: item.Href,
		ID: strconv.FormatInt(item.ID, 10),
		Kind: item.Kind,
		Labels: rowLabels(item, view),
		Primary: InboxRowPrimary(item, view, filter),
		PrimaryMeta: rowPrimaryMeta(item, view),
		Subject: item.Snippet,
		What: item.Title,
		When: item.When,
	})
}

templ InboxRowActions(item InboxItem, view, filter string) {
	if item.Kind == "workflow" && workflowRowRunning(item.Status) {
		@rowPostButton(itemActionURL(item, "cancel"), view, filter, "Cancel", lucide.SquareStop(), "gm-row-action danger", "Cancel")
	}
	if item.Kind == "workflow" && workflowResumable(item.Status) {
		@rowPostButton(itemActionURL(item, "resume"), view, filter, "Resume", lucide.Play(), "gm-row-action", "Resume")
	}
	if item.Archived {
		@rowPostButton(itemActionURL(item, "archive"), view, filter, archiveActionLabel(item), lucide.ArchiveRestore(), "gm-row-action", "Unarchive")
		@rowTrashButton(itemActionURL(item, "trash"), view, filter, trashActionLabel(item), "gm-row-action")
	} else {
		@rowPostButton(itemActionURL(item, "archive"), view, filter, archiveActionLabel(item), lucide.Archive(), "gm-row-action", "Archive")
	}
}

templ InboxRowPrimary(item InboxItem, view, filter string) {
	if item.Kind == "task" {
		@rowPostButton(itemActionURL(item, "done"), view, filter, doneActionLabel(item), doneIcon(item.Done), "gm-row-action", "Mark done")
	} else {
		@rowPostButton(itemActionURL(item, "star"), view, filter, starActionLabel(item), lucide.Star(), starClass(item.Starred), "Star")
	}
}

templ InboxTaskReader(d InboxTaskDetail) {
	@ReaderHeader(ReaderHeaderProps{
		BackHref: "/inbox/tasks",
		Description: d.Task.Description,
		Labels: []string{taskStatusLabel(taskInboxItem(d.Task))},
		Title: d.Task.Title,
	}) {
			@readerPostButton(taskInboxActionURL(d.Task.ID, "done"), doneActionLabel(taskInboxItem(d.Task)), doneIcon(d.Task.Completed))
			if d.Task.Archived {
				@readerPostButton(taskInboxActionURL(d.Task.ID, "archive"), archiveActionLabel(taskInboxItem(d.Task)), lucide.ArchiveRestore())
				@readerTrashButton(taskInboxActionURL(d.Task.ID, "trash"), trashActionLabel(taskInboxItem(d.Task)))
			} else {
				@readerPostButton(taskInboxActionURL(d.Task.ID, "archive"), archiveActionLabel(taskInboxItem(d.Task)), lucide.Archive())
			}
			@readerPostButton(taskInboxActionURL(d.Task.ID, "star"), starActionLabel(taskInboxItem(d.Task)), lucide.Star())
	}
	<div class="mail-reader-body">
		<form class="mail-card mail-task-editor" method="post" action={ taskInboxActionURL(d.Task.ID, "") }>
			<label>
				<span>Title</span>
				<input name="title" value={ d.Task.Title } autocomplete="off"/>
			</label>
			<label>
				<span>Description</span>
				<textarea name="description" rows="6" placeholder="Add task details...">{ d.Task.Description }</textarea>
			</label>
			<button class="mail-save-btn" type="submit">Save</button>
		</form>
	</div>
}

templ InboxDraftReader(d InboxDraftDetail) {
	@ReaderHeader(ReaderHeaderProps{
		BackHref: "/inbox/chats",
		Description: draftAgentLabel(d),
		Title: d.Title,
	})
	<div class="mail-reader-body mail-chat-body">
		<div id="chat-messages" data-chat-messages class="chat-messages mail-chat-messages">
			<div class="mail-empty">No messages yet.</div>
		</div>
	</div>
}

templ InboxThreadReader(d InboxThreadDetail) {
	@ReaderHeader(ReaderHeaderProps{
		BackHref: "/" + inboxBackPath(d.Kind),
		Description: d.Description,
		Title: d.Title,
	}) {
			if d.Kind == "chat" {
				@ChatAccessToggle(d.ID, d.Access)
			}
			<button type="button" class="gm-icon-btn" data-chat-popout-thread={ itoa64(d.ID) } title="Open chat popout" aria-label="Open chat popout">
				@lucide.ExternalLink()
			</button>
			if d.Streaming && d.Kind != "chat" {
				@readerStopButton(d.Kind, d.ID)
			}
			if d.Archived {
				@readerPostButton(threadInboxActionURL(d.Kind, d.ID, "archive"), archiveActionLabel(threadInboxItem(d)), lucide.ArchiveRestore())
				@readerTrashButton(threadInboxActionURL(d.Kind, d.ID, "trash"), trashActionLabel(threadInboxItem(d)))
			} else {
				@readerPostButton(threadInboxActionURL(d.Kind, d.ID, "archive"), archiveActionLabel(threadInboxItem(d)), lucide.Archive())
			}
			@readerPostButton(threadInboxActionURL(d.Kind, d.ID, "star"), starActionLabel(threadInboxItem(d)), lucide.Star())
	}
	<div hx-ext="sse" sse-connect={ "/chat/" + strconv.FormatInt(d.ID, 10) + "/events" } class="mail-reader-body mail-chat-body">
		<div id="chat-messages" data-chat-messages class="chat-messages mail-chat-messages" sse-swap="message">
			@ChatMessages(ChatThreadProps{Agent: d.Agent, ID: d.ID, Messages: d.Messages, Title: d.Title})
		</div>
	</div>
}

templ InboxScheduleReader(d InboxScheduleDetail) {
	@ReaderHeader(ReaderHeaderProps{
		BackHref: "/inbox/workflows",
		Description: d.Cron,
		Labels: []string{"Scheduled", scheduleStatusLabel(WorkflowScheduleView{Paused: d.Paused})},
		Title: d.Name,
	})
	<div class="mail-reader-body mail-chat-body">
		<div id="wf-body" data-chat-messages class="chat-messages mail-chat-messages">
			if len(d.Runs) == 0 {
				<div class="mail-empty">No executions yet.</div>
			}
			for i, run := range d.Runs {
				@scheduleRunItem(i, run)
			}
		</div>
	</div>
}

templ InboxWorkflowReader(d InboxWorkflowDetail) {
	<div id="wf-reader" data-events-url={ workflowEventsURL(d) }>
		@WorkflowStatus(d)
		<div class="mail-reader-body mail-chat-body">
			<div id="wf-body" data-chat-messages class="chat-messages mail-chat-messages">
				<div id="wf-steps">
					for _, item := range d.Items {
						if item.Durable {
							@WorkflowStep(item)
						}
					}
				</div>
				@WorkflowPending(d)
			</div>
		</div>
	</div>
}

templ WorkflowStatus(d InboxWorkflowDetail) {
	<div id="wf-status">
		@ReaderHeader(ReaderHeaderProps{
			BackHref: "/inbox/workflows",
			Description: workflowStatusLabel(d.Status),
			Title: d.Title,
		}) {
			if d.Running {
				@readerPostButton(threadInboxActionURL("workflow", d.ID, "cancel"), "Cancel", lucide.SquareStop())
			}
			if workflowResumable(d.Status) {
				@readerPostButton(threadInboxActionURL("workflow", d.ID, "resume"), "Resume", lucide.Play())
			}
			if d.Archived {
				@readerPostButton(threadInboxActionURL("workflow", d.ID, "archive"), "Unarchive", lucide.ArchiveRestore())
				@readerTrashButton(threadInboxActionURL("workflow", d.ID, "trash"), "Delete workflow")
			} else {
				@readerPostButton(threadInboxActionURL("workflow", d.ID, "archive"), "Archive", lucide.Archive())
			}
			@readerPostButton(threadInboxActionURL("workflow", d.ID, "star"), "Star", lucide.Star())
		}
	</div>
}

templ WorkflowStep(item WorkflowItemProps) {
	<div id={ workflowStepID(item.ID) }>
		@workflowItem(workflowStepID(item.ID), item)
	</div>
}

templ WorkflowPending(d InboxWorkflowDetail) {
	<div id="wf-pending">
		for i, item := range d.Items {
			if !item.Durable {
				@workflowItem("wf-pending-" + strconv.Itoa(i), item)
			}
		}
	</div>
}

templ scheduleRunItem(i int, run ScheduleRunProps) {
	@ChatTurn("assistant") {
		@chatRow(chatRowProps{
			Failed:  run.Status == "ERROR",
			Detail:  run.ID,
			Key:     "schedule-run-" + strconv.Itoa(i),
			Kind:    "tool",
			Label:   "Execution " + run.CreatedAt,
			Summary: workflowStatusLabel(run.Status),
		})
	}
	for j, item := range run.Items {
		@workflowItem("sched-" + strconv.Itoa(i) + "-" + strconv.Itoa(j), item)
	}
}

templ workflowItem(key string, item WorkflowItemProps) {
	@ChatTurn("assistant") {
		@chatRow(chatRowProps{
			Failed:  item.Failed,
			Key:     key,
			Kind:    "tool",
			Label:   item.Title,
			Shimmer: item.Running,
			Summary: item.Duration,
		}) {
			@workflowStepDetail(item)
		}
	}
	if item.Kind == "response" && item.Detail != "" {
		@ChatTurn("assistant") {
			<div class="chat-md">
				@Markdown(item.Detail)
				if item.Copy != "" {
					<button type="button" class="mail-copy-btn" data-copy={ item.Copy } onclick="navigator.clipboard.writeText(this.dataset.copy);this.textContent='Copied'">Copy</button>
				}
			</div>
		}
	}
	if item.Kind == "form" {
		@ChatTurn("user") {
			if item.Form != nil {
				@ChatForm(*item.Form)
			} else if item.Answer != "" {
				<div class="chat-bubble">{ item.Answer }</div>
			}
		}
	}
}

templ workflowStepDetail(item WorkflowItemProps) {
	if item.Input != "" {
		<div class="wf-io">
			<span class="wf-io-label">Input</span>
			<pre class="wf-io-value">{ item.Input }</pre>
		</div>
	}
	if item.Kind != "response" && item.Detail != "" {
		<div class="wf-io">
			<span class="wf-io-label">Output</span>
			<pre class="wf-io-value">{ item.Detail }</pre>
		</div>
	}
	if item.Kind == "form" && item.Answer != "" {
		<div class="wf-io">
			<span class="wf-io-label">Answer</span>
			<pre class="wf-io-value">{ item.Answer }</pre>
		</div>
	}
}

templ ReaderHeader(p ReaderHeaderProps) {
	<header class="mail-reader-head">
		<a class="gm-icon-btn" href={ templ.SafeURL(p.BackHref) } aria-label="Back">
			@lucide.ArrowLeft()
		</a>
		<div class="mail-reader-title">
			<h1>{ p.Title }</h1>
			if p.Description != "" {
				<p>{ p.Description }</p>
			}
		</div>
		if len(p.Labels) > 0 {
			<div class="mail-reader-labels">
				for _, label := range p.Labels {
					<span class="mail-reader-label">{ label }</span>
				}
			</div>
		}
		<div class="mail-reader-actions">
			{ children... }
		</div>
	</header>
}

templ mailLabel(href, name, active, label string, count int, icon templ.Component) {
	<a href={ templ.SafeURL(href) } class={ "gm-label", templ.KV("active", active == name) }>
		<span class="gm-label-icon">
			@icon
		</span>
		<span class="gm-label-name">{ label }</span>
		<span class="gm-label-count">{ strconv.Itoa(count) }</span>
	</a>
}

templ createButton(mode, label string, icon templ.Component) {
	<form method="post" action="/compose">
		<input type="hidden" name="mode" value={ mode }/>
		<input type="hidden" name="create_only" value="true"/>
		<button class="mail-create-btn" type="submit">
			@icon
			<span>{ label }</span>
		</button>
	</form>
}

templ createWorkflowButton() {
	<form class="mail-compose-combo" method="post" action="/compose">
		<input type="hidden" name="mode" value="workflow"/>
		<input type="hidden" name="create_only" value="true"/>
		<button class="mail-compose-btn" type="submit" data-new-workflow title="New workflow" aria-label="New workflow">
			@lucide.Plus()
			<span>Flow</span>
		</button>
		<span class="mail-create-select-wrap mail-model-select-wrap">
			<select class="mail-create-select" name="workflow_type" aria-label="Workflow type" data-submit-on-change>
				<option value="" selected disabled hidden>Workflow type</option>
				for _, typ := range workflowTypeOptions() {
					<option value={ typ }>{ workflowTypeLabel(typ) }</option>
				}
			</select>
			<span class="mail-create-chevron">@lucide.ChevronDown()</span>
		</span>
	</form>
}

templ readerPostButton(action, label string, icon templ.Component) {
	<form method="post" action={ action }>
		<input type="hidden" name="back" value={ currentBackFallback(action) }/>
		<button type="submit" class="gm-icon-btn" title={ label } aria-label={ label }>
			@icon
		</button>
	</form>
}

templ readerStopButton(kind string, id int64) {
	<form method="post" action={ threadInboxActionURL(kind, id, "stop") }>
		<input type="hidden" name="back" value={ threadInboxDetailURL(kind, id) }/>
		<button type="submit" class="gm-icon-btn" title="Stop chat" aria-label="Stop chat">
			@lucide.SquareStop()
		</button>
	</form>
}

templ readerTrashButton(action, label string) {
	<form class="mail-trash-form" method="post" action={ action } data-trash-form>
		<input type="hidden" name="back" value={ currentBackFallback(action) }/>
		<button type="button" class="gm-icon-btn danger mail-trash-trigger" title={ label } aria-label={ label } data-trash-trigger>
			@lucide.Trash2()
		</button>
		<span class="mail-trash-confirm" aria-label="Confirm permanent delete">
			<button type="button" class="mail-trash-text-btn" data-trash-cancel>
				Cancel
			</button>
			<button type="submit" class="mail-trash-text-btn danger" data-trash-submit>
				Delete
			</button>
		</span>
	</form>
}

templ rowPostButton(action, view, filter, label string, icon templ.Component, class string, fallback string) {
	<form method="post" action={ action }>
		<input type="hidden" name="back" value={ archiveFilterHref(view, filter) }/>
		<button type="submit" class={ class } title={ label } aria-label={ fallback } onclick="event.stopPropagation()">
			@icon
		</button>
	</form>
}

templ rowTrashButton(action, view, filter, label, class string) {
	<form class="mail-trash-form" method="post" action={ action } data-trash-form>
		<input type="hidden" name="back" value={ archiveFilterHref(view, filter) }/>
		<button type="button" class={ class + " danger mail-trash-trigger" } title={ label } aria-label={ label } data-trash-trigger>
			@lucide.Trash2()
		</button>
		<span class="mail-trash-confirm" aria-label="Confirm permanent delete">
			<button type="button" class="mail-trash-text-btn" data-trash-cancel>
				Cancel
			</button>
			<button type="submit" class="mail-trash-text-btn danger" data-trash-submit>
				Delete
			</button>
		</span>
	</form>
}

func archiveActionLabel(item InboxItem) string {
	if item.Archived {
		return "Unarchive"
	}
	return "Archive"
}

func archiveFilterHref(view, filter string) string {
	base := inboxViewHref(view)
	if filter == "all" {
		return base
	}
	return base + "?archived=" + filter
}

func agentLabel(agent string) string {
	if agent == "" {
		return "Agent"
	}
	return strings.ToUpper(agent[:1]) + agent[1:]
}

func rowKindLabel(kind string) string {
	switch kind {
	case "chat":
		return "Chat"
	case "task":
		return "Task"
	case "workflow":
		return "Workflow"
	default:
		return "Item"
	}
}

func rowKindIcon(kind string) templ.Component {
	switch kind {
	case "chat":
		return lucide.MessageSquare()
	case "task":
		return lucide.ListChecks()
	case "workflow":
		return lucide.Workflow()
	default:
		return lucide.Inbox()
	}
}

func rowPrimaryMeta(item InboxItem, view string) templ.Component {
	if view != "inbox" {
		return nil
	}
	return inboxRowKindIcon(item)
}

func rowLabels(item InboxItem, view string) []string {
	labels := []string{}
	if view != "inbox" && showRowKindLabel(view) {
		labels = append(labels, rowKindLabel(item.Kind))
	}
	if item.Kind == "task" {
		labels = append(labels, taskStatusLabel(item))
	}
	return labels
}

func showRowKindLabel(view string) bool {
	return view == "inbox" || view == "starred"
}

func workflowTypeLabel(typ string) string {
	switch typ {
	case "contact-note":
		return "Contact note"
	case "countdown":
		return "Countdown"
	case "create-pr":
		return "Create pull request"
	case "deploy":
		return "Deploy"
	case "fan-out":
		return "Parallel jobs"
	case "greet":
		return "Greet"
	case "stream":
		return "Log stream"
	case "update-claude":
		return "Update Claude Code"
	case "webhook":
		return "Webhook"
	default:
		return agentLabel(typ)
	}
}

func scheduleStatusLabel(sc WorkflowScheduleView) string {
	if sc.Paused {
		return "Paused"
	}
	return "Active"
}

func scheduleRowLabels(sc WorkflowScheduleView) []string {
	return []string{"Scheduled", scheduleStatusLabel(sc)}
}

func scheduleInboxURL(name string) string {
	return "/inbox/schedules/" + url.PathEscape(name)
}

func workflowStepID(id int) string {
	return "wf-step-" + strconv.Itoa(id)
}

func workflowEventsURL(d InboxWorkflowDetail) string {
	return fmt.Sprintf("/inbox/workflows/%d/events?after=%d", d.ID, workflowLastStepID(d.Items))
}

func workflowLastStepID(items []WorkflowItemProps) int {
	last := 0
	for _, item := range items {
		if item.Durable && item.ID > last {
			last = item.ID
		}
	}
	return last
}

func workflowRowRunning(status string) bool {
	return status == "PENDING" || status == "ENQUEUED"
}

func workflowResumable(status string) bool {
	return status == "CANCELLED" || status == "MAX_RECOVERY_ATTEMPTS_EXCEEDED"
}

func workflowStatusLabel(status string) string {
	switch status {
	case "SUCCESS":
		return "Completed"
	case "ERROR":
		return "Failed"
	case "CANCELLED":
		return "Cancelled"
	case "ENQUEUED", "PENDING":
		return "Running"
	default:
		return status
	}
}

func workflowTypeOptions() []string {
	return []string{"greet", "contact-note", "update-claude", "create-pr", "countdown", "fan-out", "stream", "deploy", "webhook"}
}

func currentBackFallback(action string) string {
	if strings.Contains(action, "/workflows/") {
		return "/inbox/workflows"
	}
	if strings.Contains(action, "/chats/") {
		return "/inbox/chats"
	}
	return "/inbox/tasks"
}

func composeComposerProps(p InboxProps) ChatComposerProps {
	var hidden []ChatComposerHiddenProps
	if p.Draft != nil {
		hidden = append(hidden,
			ChatComposerHiddenProps{Name: "agent", Value: p.Draft.Agent},
			ChatComposerHiddenProps{Name: "model", Value: p.Draft.Model},
		)
	}
	return ChatComposerProps{
		Action:      "/compose",
		FileName:    "file",
		Hidden:      hidden,
		Placeholder: "Chat with agent",
	}
}

func draftAgentLabel(d InboxDraftDetail) string {
	if d.Model != "" {
		return agentLabel(d.Agent) + " " + d.Model
	}
	return agentLabel(d.Agent)
}

func threadComposerProps(d InboxThreadDetail) ChatComposerProps {
	action := "/chat/" + strconv.FormatInt(d.ID, 10) + "/messages"
	return ChatComposerProps{
		Action:      action,
		FileName:   "",
		HXPost:     action,
		Placeholder: threadComposePlaceholder(d),
		StopAction:  "/chat/" + strconv.FormatInt(d.ID, 10) + "/stop",
		UploadURL:   "/chat/" + strconv.FormatInt(d.ID, 10) + "/attachments",
	}
}

func doneActionLabel(item InboxItem) string {
	if item.Done {
		return "Mark not done"
	}
	return "Mark done"
}

func doneIcon(done bool) templ.Component {
	if done {
		return lucide.CircleCheck()
	}
	return lucide.Circle()
}

func inboxBackPath(kind string) string {
	if kind == "workflow" {
		return "inbox/workflows"
	}
	return "inbox/chats"
}

func inboxNavItems(p InboxProps) []uikit.NavItem {
	return []uikit.NavItem{
		{Active: p.View == "inbox", Count: p.Counts.Inbox, Href: "/", Icon: lucide.Inbox(), Label: "Inbox", ShowCount: true},
		{Active: p.View == "starred", Count: p.Counts.Starred, Href: "/starred", Icon: lucide.Star(), Label: "Starred", ShowCount: true},
		{Active: p.View == "chats", Count: p.Counts.Chats, Group: "More", Href: "/inbox/chats", Icon: lucide.MessageSquare(), Label: "Chats", ShowCount: true},
		{Active: p.View == "tasks", Count: p.Counts.Tasks, Href: "/inbox/tasks", Icon: lucide.ListChecks(), Label: "Tasks", ShowCount: true},
		{Active: p.View == "workflows", Count: p.Counts.Workflows, Href: "/inbox/workflows", Icon: lucide.Play(), Label: "Workflows", ShowCount: true},
		{Group: "Tools", Href: "/setup", Icon: lucide.Settings(), Label: "Setup"},
		{Href: "/sessions", Icon: lucide.MessageSquare(), Label: "Sessions"},
		{Href: "/code/", Icon: lucide.CodeXml(), Label: "Code review"},
		{Href: "/files/", Icon: lucide.File(), Label: "Files"},
		{Href: "/sql/", Icon: lucide.Database(), Label: "SQL"},
	}
}

templ inboxRowKindIcon(item InboxItem) {
	<span class="gm-row-kind-icon" title={ rowKindLabel(item.Kind) } aria-label={ rowKindLabel(item.Kind) } role="img">
		@rowKindIcon(item.Kind)
	</span>
}

func inboxViewHref(view string) string {
	switch view {
	case "chats":
		return "/inbox/chats"
	case "tasks":
		return "/inbox/tasks"
	case "workflows":
		return "/inbox/workflows"
	default:
		return "/" + view
	}
}

func inboxTitle(p InboxProps) string {
	if p.Draft != nil {
		return p.Draft.Title
	}
	if p.Schedule != nil {
		return p.Schedule.Name
	}
	switch p.View {
	case "chats":
		return "Chats"
	case "starred":
		return "Starred"
	case "tasks":
		return "Tasks"
	case "workflows":
		return "Workflows"
	default:
		return "Inbox"
	}
}

func inboxListCount(p InboxProps) int {
	if p.View == "workflows" {
		return len(p.Items) + len(p.Schedules)
	}
	return len(p.Items)
}

func itemActionURL(item InboxItem, action string) string {
	switch item.Kind {
	case "task":
		return taskInboxActionURL(item.ID, action)
	case "workflow":
		return threadInboxActionURL("workflow", item.ID, action)
	default:
		return threadInboxActionURL("chat", item.ID, action)
	}
}

func starActionLabel(item InboxItem) string {
	if item.Starred {
		return "Unstar"
	}
	return "Star"
}

func starClass(on bool) string {
	if on {
		return "gm-star on"
	}
	return "gm-star"
}

func showArchiveFilters(view string) bool {
	return view == "chats" || view == "tasks" || view == "workflows"
}

func trashActionLabel(item InboxItem) string {
	switch item.Kind {
	case "task":
		return "Delete task permanently"
	case "workflow":
		return "Delete workflow"
	default:
		return "Delete chat"
	}
}

func taskInboxActionURL(id int64, action string) string {
	if action == "" {
		return fmt.Sprintf("/inbox/tasks/%d", id)
	}
	return fmt.Sprintf("/inbox/tasks/%d/%s", id, action)
}

func taskInboxItem(t db.Task) InboxItem {
	return InboxItem{Archived: t.Archived, Done: t.Completed, ID: t.ID, Kind: "task", Starred: t.Starred}
}

func taskStatusLabel(item InboxItem) string {
	if item.Archived {
		return "Archived"
	}
	if item.Done {
		return "Done"
	}
	return "Active"
}

func threadComposePlaceholder(d InboxThreadDetail) string {
	return "Chat with agent"
}

func threadInboxActionURL(kind string, id int64, action string) string {
	if kind == "workflow" {
		return fmt.Sprintf("/inbox/workflows/%d/%s", id, action)
	}
	return fmt.Sprintf("/inbox/chats/%d/%s", id, action)
}

func threadInboxDetailURL(kind string, id int64) string {
	if kind == "workflow" {
		return fmt.Sprintf("/inbox/workflows/%d", id)
	}
	return fmt.Sprintf("/inbox/chats/%d", id)
}

func threadInboxItem(d InboxThreadDetail) InboxItem {
	return InboxItem{Archived: d.Archived, ID: d.ID, Kind: d.Kind, Starred: d.Starred}
}
