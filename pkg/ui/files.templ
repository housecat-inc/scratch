package ui

import (
	"github.com/housecat-inc/scratch/uikit"
	"github.com/templui/templui/components/button"
	lucide "github.com/wux4an/lucide-templ/icons"
)

templ FilesPage(v FilesProps) {
	<!DOCTYPE html>
	<html lang="en">
		@MailHead("Files") {
			@FilesHeadExtras()
		}
		<body>
			@uikit.Shell(uikit.ShellProps{
				Actions:    toolActions(v.Shell),
				AppName:    "scratch",
				BrandHref:  "/",
				Footer:     ToolComposer(),
				MainClass:  "mail-files-main",
				Nav:        toolNavItems("files", v.Shell.Counts),
				SidebarTop: ComposeActions(),
			}) {
				@uikit.SplitPane(uikit.SplitPaneProps{
					ID:     "files-wrap",
					Tree:   FilesTreePane(v),
					Editor: FilesEditorPane(),
				})
			}
			<script src="/static/cm.bundle.js"></script>
			<script src="/static/files.js"></script>
		</body>
	</html>
}

templ FilesHeadExtras() {
	<style>
		html, body { height: 100%; }
		#editor-area { height: 100%; }
		#editor-area .cm-editor { height: 100%; }
		#editor-area .cm-editor.cm-focused { outline: none; }
		#editor-area .cm-scroller { -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
		@media (max-width: 767px) {
			#editor-area .cm-content { font-size: 16px; }
		}
	</style>
}

templ FilesTreePane(v FilesProps) {
	<header class="mail-mainbar">
		<div class="relative">
			<button type="button" data-files-browse class="inline-flex items-center gap-1.5 px-2 py-1 -ml-2 rounded hover:bg-slate-100 text-slate-700" title="Browse folders" aria-label="Browse folders">
				@lucide.Folder(templ.Attributes{"class": "w-4 h-4 flex-shrink-0 text-slate-400"})
				<span class="font-mono text-sm truncate max-w-[12rem]">{ dirName(v.Dir) }</span>
				@lucide.ChevronDown(templ.Attributes{"class": "w-3 h-3 flex-shrink-0 text-slate-400"})
			</button>
			<div id="files-browse-menu" class="hidden absolute left-0 z-40 mt-1 w-72 max-h-80 overflow-auto rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
				<div class="px-3 py-1 font-mono text-[11px] text-slate-400 truncate" title={ v.Dir }>{ v.Dir }</div>
				if v.Parent != "" {
					<a href={ templ.SafeURL(filesDirHref(v.Parent)) } class="block px-3 py-1.5 font-mono text-sm text-slate-500 hover:bg-slate-50">../</a>
				}
				for _, e := range v.Entries {
					if e.Dir {
						<a href={ templ.SafeURL(filesChildDirHref(v.Dir, e.Name)) } class="block px-3 py-1.5 font-mono text-sm text-slate-700 hover:bg-slate-50 truncate">{ e.Name }/</a>
					}
				}
			</div>
		</div>
	</header>
	if v.Error != "" {
		<div class="px-3 py-2 text-xs text-destructive break-all flex-shrink-0">{ v.Error }</div>
	}
	<div class="flex-1 min-h-0 overflow-auto py-1" id="file-tree" data-dir={ v.Dir }>
		@FileTreeList(FileTreeProps{Dir: v.Dir, Entries: v.Entries})
	</div>
}

templ FilesEditorPane() {
	<header class="mail-mainbar">
		<button id="back-btn" type="button"
			class="md:hidden -ml-1 rounded text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1"
			aria-label="Back to files">
			@lucide.ChevronLeft(templ.Attributes{"class": "w-3.5 h-3.5"})
			<span>Files</span>
		</button>
		<span id="editor-path" class="font-mono flex-1 truncate">Select a file</span>
		<span id="editor-status" class="hidden sm:inline"></span>
		@button.Button(button.Props{Disabled: true, ID: "editor-save", Size: button.SizeSm, Type: button.TypeButton}) {
			Save
		}
	</header>
	<div id="editor-area" class="flex-1 min-h-0 bg-white"></div>
}

templ FileTreeList(t FileTreeProps) {
	<ul>
		for _, e := range t.Entries {
			if e.Dir {
				<li>
					<details class="group/dir"
						data-dir={ e.Path }
						hx-get={ filesTreeHref(t.Dir, e.Path) }
						hx-trigger="toggle once"
						hx-target="find .tree-children"
						hx-swap="innerHTML">
						<summary class="px-2 py-2 md:py-0.5 cursor-pointer list-none flex items-center gap-2 md:gap-1 hover:bg-slate-50 active:bg-slate-100 text-slate-700">
							@lucide.ChevronRight(templ.Attributes{"class": "w-4 h-4 md:w-3 md:h-3 text-slate-400 transition-transform group-open/dir:rotate-90 flex-shrink-0"})
							<span class="font-mono text-base md:text-xs truncate">{ e.Name }/</span>
						</summary>
						<div class="pl-4 md:pl-3 tree-children">
							<div class="px-2 py-2 md:py-0.5 text-sm md:text-xs text-slate-400 italic">loading…</div>
						</div>
					</details>
				</li>
			} else {
				<li>
					<a href="#" data-file={ e.Path } class="flex items-center gap-2 md:gap-1 px-2 py-2 md:py-0.5 pl-8 md:pl-5 hover:bg-slate-50 active:bg-slate-100 text-slate-600">
						<span class="font-mono text-base md:text-xs truncate">{ e.Name }</span>
					</a>
				</li>
			}
		}
		if len(t.Entries) == 0 {
			<li class="px-2 py-2 md:py-0.5 text-sm md:text-xs text-slate-400 italic">empty</li>
		}
	</ul>
}
