package ui

import (
	"github.com/housecat-inc/scratch/pkg/db"
	"github.com/housecat-inc/scratch/uikit"
	"github.com/templui/templui/components/button"
	"strconv"
)

templ SQLPage(v SQLProps) {
	<!DOCTYPE html>
	<html lang="en">
		@SQLHead()
		<body>
			@uikit.Shell(uikit.ShellProps{
				Actions:    toolActions(),
				AppName:    "scratch",
				BrandHref:  "/",
				MainClass:  "mail-files-main",
				Nav:        toolNavItems("sql"),
				SidebarTop: ComposeActions(),
			}) {
				<div id="sql-wrap" class="mail-tool-content flex flex-col flex-1 min-h-0">
					<header class="mail-mainbar gap-2">
						<button id="sql-back-btn" type="button" class="md:hidden -ml-1 rounded text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1" aria-label="Back to tables">
							<svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3L5 8l5 5"></path></svg>
							<span>Tables</span>
						</button>
						<form method="get" action="/sql/" class="flex-shrink-0">
							<select name="path" onchange="this.form.submit()" aria-label="Database file" class="font-mono text-xs w-48 max-w-full px-2 py-1 rounded border border-slate-200 bg-slate-50">
								for _, f := range v.DBFiles {
									<option value={ f } selected?={ f == v.Path }>{ dbLabel(f) }</option>
								}
							</select>
						</form>
						<span class="flex-1"></span>
						<span id="sql-running" class="htmx-indicator text-xs text-slate-400">running…</span>
						@button.Button(button.Props{Attributes: templ.Attributes{"data-sql-save-open": "true"}, Size: button.SizeSm, Type: button.TypeButton, Variant: button.VariantOutline}) {
							Save
						}
						@button.Button(button.Props{Form: "sql-run-form", Size: button.SizeSm, Type: button.TypeSubmit}) {
							Run ▸
						}
					</header>
					<div class="flex flex-1 min-h-0">
						<aside class="tree-pane w-full md:w-72 md:flex-shrink-0 bg-white md:border-r border-slate-200 flex flex-col min-h-0">
							if v.Error != "" {
								<div class="px-3 py-2 text-xs text-destructive break-all flex-shrink-0">{ v.Error }</div>
							}
							<div class="flex flex-col flex-1 min-h-0">
								<div class="flex-1 min-h-0 flex flex-col border-b border-slate-200">
									<div class="px-3 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400 flex-shrink-0">Tables</div>
									<div class="flex-1 min-h-0 overflow-auto">
										@SQLTableList(v.Tables)
									</div>
								</div>
								<div class="flex-1 min-h-0 flex flex-col">
									<div class="px-3 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400 flex-shrink-0">Saved</div>
									<div id="sql-query-list" class="flex-1 min-h-0 overflow-auto">
										@SQLQueryList(v.Saved)
									</div>
								</div>
							</div>
						</aside>
						<main class="editor-pane flex-1 flex flex-col min-w-0 w-full min-h-0">
							<form id="sql-run-form" hx-post="/sql/query" hx-target="#sql-results" hx-swap="innerHTML" hx-indicator="#sql-running" class="border-b border-slate-200">
								<input type="hidden" name="path" value={ v.Path }/>
								<textarea id="sql-editor" name="sql" spellcheck="false">{ v.Query }</textarea>
								<div id="sql-cm" class="sql-cm"></div>
							</form>
							<div id="sql-results" class="flex-1 min-h-0 overflow-auto bg-white">
								@SQLResults(v.Result)
							</div>
						</main>
					</div>
				</div>
				@SQLSaveModal()
			}
			<script src="/static/sql.js"></script>
			<script src="/static/cm-sql.bundle.js"></script>
			<script src="/static/sql-editor.js"></script>
		</body>
	</html>
}

templ SQLSaveModal() {
	<div id="sql-save-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
		<div class="absolute inset-0 bg-slate-900/30" data-sql-save-close></div>
		<div class="relative w-80 rounded-lg bg-white p-4 shadow-xl flex flex-col gap-3">
			<h2 class="text-sm font-medium text-slate-800">Save query</h2>
			<input id="sql-save-name" name="name" placeholder="Query name" spellcheck="false" autocomplete="off" class="font-mono text-sm w-full px-2 py-1.5 rounded border border-slate-200 bg-slate-50"/>
			<div class="flex justify-end gap-2">
				@button.Button(button.Props{Attributes: templ.Attributes{"data-sql-save-close": "true"}, Size: button.SizeSm, Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{
					ID:   "sql-save-confirm",
					Size: button.SizeSm,
					Type: button.TypeButton,
					Attributes: templ.Attributes{
						"hx-include": "#sql-editor, #sql-save-name",
						"hx-post":    "/sql/queries",
						"hx-swap":    "innerHTML",
						"hx-target":  "#sql-query-list",
					},
				}) {
					Save
				}
			</div>
		</div>
	</div>
}

templ SQLHead() {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<meta name="color-scheme" content="light"/>
		<title>SQL · scratch</title>
		<link rel="manifest" href="/manifest.webmanifest"/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-title" content="scratch"/>
		<meta name="mobile-web-app-capable" content="yes"/>
		<meta name="application-name" content="scratch"/>
		<meta name="theme-color" content="#0f172a"/>
		<link rel="apple-touch-icon" href="/static/icon-180.png"/>
		<link rel="icon" type="image/svg+xml" href="/static/icon.svg"/>
		@InboxCSS()
		@ChatCSS()
		@TempluiCSS()
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<script src="/static/htmx.min.js"></script>
		<script src="/static/register-sw.js" defer></script>
		<style>
			html, body { height: 100%; }
			#sql-editor { display: block; width: 100%; height: 180px; resize: none; border: 0; outline: none; padding: 8px 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
			.sql-cm { flex-shrink: 0; }
			.sql-cm .cm-editor { height: 180px; }
			.sql-cm .cm-editor.cm-focused { outline: none; }
			.sql-cm .cm-scroller { -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
			.sql-table { border-collapse: collapse; font-size: 12px; width: 100%; }
			.sql-table th, .sql-table td { border: 1px solid #e2e8f0; padding: 3px 8px; text-align: left; white-space: pre; vertical-align: top; }
			.sql-table th { background: #f8fafc; position: sticky; top: 0; }
			.sql-table td.is-null { color: #94a3b8; font-style: italic; }
			@media (max-width: 767px) {
				#sql-editor { font-size: 16px; }
				#sql-wrap:not(.show-editor) .editor-pane { display: none; }
				#sql-wrap.show-editor .tree-pane { display: none; }
			}
		</style>
	</head>
}

templ SQLTableList(tables []SQLTable) {
	<ul>
		for _, t := range tables {
			<li>
				<button type="button" class="w-full text-left flex items-center gap-1 px-3 py-2 md:py-0.5 hover:bg-slate-50 active:bg-slate-100 text-slate-700" data-sql={ tableSelect(t.Name) }>
					<span class="font-mono text-base md:text-xs truncate">{ t.Name }</span>
					<span class="ml-auto text-[10px] text-slate-400">{ strconv.Itoa(len(t.Columns)) }</span>
				</button>
			</li>
		}
		if len(tables) == 0 {
			<li class="px-3 py-2 md:py-0.5 text-sm md:text-xs text-slate-400 italic">no tables</li>
		}
	</ul>
}

templ SQLQueryList(saved []db.SQLQuery) {
	<ul>
		for _, q := range saved {
			<li class="group flex items-center">
				<button type="button" class="flex-1 min-w-0 text-left px-3 py-2 md:py-0.5 hover:bg-slate-50 active:bg-slate-100 text-slate-700" data-sql={ q.SQL }>
					<span class="font-mono text-base md:text-xs truncate block">{ q.Name }</span>
				</button>
				<button type="button" class="px-2 py-1 text-slate-300 hover:text-destructive md:opacity-0 group-hover:opacity-100" title="Delete query" aria-label="Delete query" hx-delete={ "/sql/queries/" + q.ID } hx-target="#sql-query-list" hx-swap="innerHTML" hx-confirm="Delete this saved query?">
					<span class="block w-3 h-3">
						@uikit.Icon("trash")
					</span>
				</button>
			</li>
		}
		if len(saved) == 0 {
			<li class="px-3 py-2 md:py-0.5 text-sm md:text-xs text-slate-400 italic">none saved</li>
		}
	</ul>
}

templ SQLResults(r *SQLResult) {
	if r == nil {
		<div class="p-4 text-xs text-slate-400 italic">Run a query to see results.</div>
	} else if r.Error != "" {
		<div class="m-3 rounded border border-destructive/30 bg-destructive/5 px-3 py-2 text-xs font-mono text-destructive whitespace-pre-wrap">{ r.Error }</div>
	} else {
		<div class="px-3 py-1 text-[11px] text-slate-400 flex items-center gap-2">
			<span>{ strconv.Itoa(len(r.Rows)) } rows</span>
			<span>·</span>
			<span>{ r.Elapsed }</span>
			if r.Truncated {
				<span class="text-amber-600">· truncated</span>
			}
		</div>
		<div class="overflow-auto">
			<table class="sql-table">
				<thead>
					<tr>
						for _, c := range r.Columns {
							<th>{ c }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range r.Rows {
						<tr>
							for _, cell := range row {
								if cell.Null {
									<td class="is-null">NULL</td>
								} else {
									<td>{ cell.Value }</td>
								}
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ toolActions() {
	@uikit.NewChatAction(uikit.NewChatActionProps{})
}
