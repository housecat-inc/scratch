package ui

import (
	"strconv"

	"github.com/housecat-inc/scratch/uikit"
)

templ WorkflowsPage(p WorkflowsProps) {
	<!DOCTYPE html>
	<html lang="en">
		@MailHead("Workflows") {
			<script src="/static/inbox.js" defer></script>
		}
		<body>
			@uikit.Shell(uikit.ShellProps{
				Actions: AppActions(p.ChatOptions, p.ChatLabel),
				AppName: "todos",
				BrandHref: "/",
				Nav: appNav("workflows", p.Counts),
			}) {
				<header class="mail-mainbar">
					<div class="mail-mainbar-title">
						<h1>Workflows</h1>
						<span>{ strconv.Itoa(len(p.Runs)) }</span>
					</div>
					@WorkflowStartForm(p)
				</header>
				if len(p.Runs) == 0 {
					<div class="mail-empty">No workflow runs yet. Start one above.</div>
				} else {
					<div class="mail-list">
						for _, run := range p.Runs {
							@workflowRunRow(run)
						}
					</div>
				}
			}
		</body>
	</html>
}

templ WorkflowStartForm(p WorkflowsProps) {
	<form class="todo-topbar-actions" method="post" action="/workflows">
		<select class="wf-start-select" name="workflow_type">
			for _, opt := range TaskWorkflowOptions() {
				<option value={ opt.Type }>{ opt.Label }</option>
			}
		</select>
		<button class="mail-create-btn" type="submit">
			@uikit.Icon("play")
			<span>Run</span>
		</button>
	</form>
}

templ workflowRunRow(run WorkflowRunItem) {
	@uikit.ListRow(uikit.ListRowProps{
		Href: run.Href,
		ID: strconv.FormatInt(run.ID, 10),
		Kind: "workflow",
		Labels: []string{workflowStatusLabel(run.Status)},
		Subject: workflowStatusLabel(run.Status),
		What: run.Title,
		When: run.When,
	})
}

templ WorkflowRunPage(p WorkflowRunProps) {
	<!DOCTYPE html>
	<html lang="en">
		@MailHead("Workflow") {
			<script src="/static/inbox.js" defer></script>
		}
		<body>
			@uikit.Shell(uikit.ShellProps{
				Actions: AppActions(p.ChatOptions, p.ChatLabel),
				AppName: "todos",
				BrandHref: "/",
				Nav: appNav("workflows", p.Counts),
			}) {
				@WorkflowRunBody(p.Detail)
			}
		</body>
	</html>
}

templ TaskWorkflowStatus(d InboxWorkflowDetail) {
	<div id="wf-status">
		@ReaderHeader(ReaderHeaderProps{
			BackHref: "/workflows",
			Description: workflowStatusLabel(d.Status),
			Title: d.Title,
		}) {
		}
	</div>
}

templ WorkflowRunBody(d InboxWorkflowDetail) {
	<div id="wf-reader" data-events-url={ "/workflows/" + strconv.FormatInt(d.ID, 10) + "/events" }>
		@TaskWorkflowStatus(d)
		<div class="mail-reader-body mail-chat-body">
			<div id="wf-body" data-chat-messages class="chat-messages mail-chat-messages">
				<div id="wf-steps">
					for _, item := range d.Items {
						if item.Durable {
							@WorkflowStep(item)
						}
					}
				</div>
				@WorkflowPending(d)
			</div>
		</div>
	</div>
}
