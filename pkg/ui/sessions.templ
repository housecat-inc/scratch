package ui

import (
	"fmt"

	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
)

templ SetupPage(v SessionsProps) {
	@Layout("Setup", "setup") {
		<ol class="space-y-2">
			@InstallCard(v)
			@LoginCard(v)
			@ConfigureCard(v)
		</ol>
	}
}

templ SessionsPage(v SessionsProps) {
	@Layout("Sessions", "sessions") {
		@SessionsCard(v)
	}
}

templ InstallCard(v SessionsProps) {
	<li id="card-install"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		@stepCard("1", v.Installed, "Install", "Run claude.ai/install.sh") {
			if !v.Installed {
				@button.Button(button.Props{
					Attributes: templ.Attributes{
						"hx-post":         "/install",
						"hx-target":       "#card-install",
						"hx-swap":         "outerHTML",
						"hx-disabled-elt": "this",
					},
				}) {
					Install
				}
			}
			if v.InstallError != "" {
				<div class="text-destructive text-xs mt-2 break-all">{ v.InstallError }</div>
			}
		}
	</li>
}

templ stepCard(num string, done bool, title, hint string) {
	@card.Card(card.Props{Class: "rounded-xl shadow-sm gap-3"}) {
		@card.Header(card.HeaderProps{Class: "flex flex-row items-start justify-between gap-2 space-y-0"}) {
			<div class="flex-1 min-w-0 space-y-1.5">
				@card.Title(card.TitleProps{Class: "text-base"}) {
					{ title }
				}
				if !done && hint != "" {
					@card.Description() {
						{ hint }
					}
				}
			</div>
			@stepBadge(num, done)
		}
		if !done {
			@card.Content(card.ContentProps{Class: "flex flex-wrap items-center gap-2"}) {
				{ children... }
			}
		}
	}
}

templ stepBadge(num string, done bool) {
	if done {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "bg-emerald-100 text-emerald-900"}) {
			done
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			step { num }
		}
	}
}


templ LoginCard(v SessionsProps) {
	<li id="card-login"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		@stepCard("2", v.Authenticated, "Pay", "Connect Anthropic subscription") {
			if !v.Authenticated {
				if v.LoginURL != "" {
					@button.Button(button.Props{
						Variant: button.VariantSecondary,
						Href:    v.LoginURL,
						Target:  "_blank",
						Attributes: templ.Attributes{"rel": "noopener"},
					}) {
						Open claude.com →
					}
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Type:    button.TypeButton,
						Attributes: templ.Attributes{
							"data-url": v.LoginURL,
							"onclick":  "navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied'",
						},
					}) {
						Copy URL
					}
					<form hx-post="/login/code" hx-target="#card-login" hx-swap="outerHTML" class="flex gap-2 mt-2 basis-full">
						<input type="text" name="code" placeholder="paste code" autocomplete="off" autofocus required
							class="flex-1 px-3 py-2 text-sm border border-input rounded-md bg-background shadow-xs focus-visible:ring-2 focus-visible:ring-ring/40 outline-none"/>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Submit
						}
					</form>
				} else if v.Installed {
					@button.Button(button.Props{
						Attributes: templ.Attributes{
							"hx-post":         "/login",
							"hx-target":       "#card-login",
							"hx-swap":         "outerHTML",
							"hx-disabled-elt": "this",
						},
					}) {
						Connect
					}
				}
			}
			if v.LoginError != "" {
				<div class="text-destructive text-xs mt-2 break-all basis-full">{ v.LoginError }</div>
			}
		}
	</li>
}

templ ConfigureCard(v SessionsProps) {
	<li id="card-configure"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		@stepCard("3", configureDone(v), "Configure", configureHint(v)) {
			if !v.Configured && v.Authenticated {
				@button.Button(button.Props{
					Attributes: templ.Attributes{
						"hx-post":         "/configure",
						"hx-target":       "#card-configure",
						"hx-swap":         "outerHTML",
						"hx-disabled-elt": "this",
					},
				}) {
					Configure
				}
			} else if v.Configured {
				if v.AgentsDirty {
					@button.Button(button.Props{Href: "/"}) {
						Commit &amp; Push from Sessions →
					}
				}
				if v.AgentsBehind > 0 {
					@button.Button(button.Props{Href: "/"}) {
						Pull from Sessions →
					}
				}
			}
			if v.ConfigureError != "" {
				<div class="text-destructive text-xs mt-2 break-all basis-full">{ v.ConfigureError }</div>
			}
		}
	</li>
}

func configureDone(v SessionsProps) bool {
	return v.Configured && !v.AgentsDirty && v.AgentsBehind <= 0
}

func configureHint(v SessionsProps) string {
	switch {
	case !v.Authenticated:
		return ""
	case !v.Configured:
		return "Write claude markdown and settings in $HOME"
	case v.AgentsDirty:
		return "Local changes in ./scratch"
	case v.AgentsBehind > 0:
		return "Upstream changes to ./scratch"
	}
	return ""
}

templ SessionsCard(v SessionsProps) {
	<section
		id="card-sessions"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		if !v.Configured {
			@card.Card(card.Props{Class: "rounded-xl shadow-sm bg-amber-50 border-amber-200"}) {
				@card.Content() {
					<p class="text-sm text-foreground">Finish <a href="/setup" class="text-blue-700 underline">Setup</a> to start sessions.</p>
				}
			}
		} else {
			<style>
				.session-form .session-spinner { display: none; }
				.session-form.htmx-request .session-spinner { display: inline-flex; }
				.session-form.htmx-request .session-idle-label { display: none; }
				.session-form.htmx-request .session-busy-label { display: inline; }
				.session-busy-label { display: none; }
				.session-form.htmx-request fieldset { opacity: 0.6; pointer-events: none; }
				@keyframes session-spin { to { transform: rotate(360deg); } }
				.session-spinner svg { animation: session-spin 0.8s linear infinite; }
			</style>
			<form id="session-form" class="session-form mb-3"
				hx-post="/sessions" hx-target="#card-sessions" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]">
				@card.Card(card.Props{Class: "rounded-xl shadow-sm gap-3"}) {
					@card.Header(card.HeaderProps{Class: "pb-0"}) {
						@card.Title(card.TitleProps{Class: "text-base"}) {
							New session
						}
						@card.Description() {
							Spawn a claude-code session in a working directory
						}
					}
					@card.Content() {
						<fieldset class="space-y-4 p-0 m-0 border-0">
							<div class="space-y-2">
								<label class="block text-sm font-medium text-foreground">Working directory</label>
								<div class="flex items-center gap-2">
									<span id="dir-text" class="flex-1 font-mono text-sm text-foreground truncate bg-muted px-3 py-2 border border-border rounded-md">{ v.SessionDir }</span>
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Type:    button.TypeButton,
										Attributes: templ.Attributes{
											"hx-get":    fmt.Sprintf("/sessions/picker?dir=%s", v.SessionDir),
											"hx-target": "#dir-picker",
											"hx-swap":   "innerHTML",
										},
									}) {
										Browse
									}
								</div>
								<input type="hidden" name="dir" id="session-dir" value={ v.SessionDir } required/>
								<div id="dir-picker"></div>
							</div>
							<div class="space-y-2">
								<label class="block text-sm font-medium text-foreground">Prompt <span class="text-muted-foreground font-normal">(optional)</span></label>
								<textarea name="prompt" rows="3" placeholder="What should this session do?"
									class="w-full px-3 py-2 text-sm border border-input rounded-md bg-background shadow-xs resize-y focus-visible:ring-2 focus-visible:ring-ring/40 outline-none"></textarea>
							</div>
						</fieldset>
					}
					@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
						<span class="session-spinner items-center gap-1.5 text-xs text-muted-foreground">
							<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" stroke-opacity="0.25"></circle>
								<path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
							</svg>
							<span>Starting session…</span>
						</span>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							<span class="session-idle-label">Start session</span>
							<span class="session-busy-label">Starting…</span>
						}
					}
				}
			</form>
			if v.SessionError != "" {
				<div class="text-red-700 text-xs mb-3 break-all">{ v.SessionError }</div>
			}
			if len(v.Sessions) > 0 {
				<ul class="space-y-2">
					for _, s := range v.Sessions {
						@sessionItem(s)
					}
				</ul>
			} else {
				<p class="text-sm text-slate-500">No sessions running yet.</p>
			}
		}
	</section>
}

templ sessionItem(s SessionProps) {
	<li id={ fmt.Sprintf("session-%s", s.ID) }>
		@card.Card(card.Props{Class: "rounded-xl shadow-sm gap-3"}) {
			@card.Header(card.HeaderProps{Class: "pb-0 flex flex-row items-start gap-4 space-y-0"}) {
				<img class="w-16 h-16 flex-shrink-0 border border-border rounded-md"
					src={ fmt.Sprintf("/sessions/%s/qr", s.ID) }
					alt={ fmt.Sprintf("QR code for %s", s.Name) }/>
				<div class="flex-1 min-w-0 space-y-1.5">
					@card.Title(card.TitleProps{Class: "text-base truncate"}) {
						{ s.Name }
					}
					@card.Description(card.DescriptionProps{Class: "truncate font-mono"}) {
						{ s.Dir }
					}
					<a class="block text-xs text-blue-700 break-all hover:underline" href={ templ.SafeURL(s.URL) } target="_blank" rel="noopener">{ s.URL }</a>
				</div>
				<div class="flex flex-col gap-1 flex-shrink-0">
					@button.Button(button.Props{
						Size:    button.SizeSm,
						Variant: button.VariantOutline,
						Type:    button.TypeButton,
						Attributes: templ.Attributes{
							"data-url": s.URL,
							"onclick":  "navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied'",
						},
					}) {
						Copy
					}
					@button.Button(button.Props{
						Size:    button.SizeSm,
						Variant: button.VariantDestructive,
						Type:    button.TypeButton,
						Attributes: templ.Attributes{
							"hx-delete":       fmt.Sprintf("/sessions/%s", s.ID),
							"hx-target":       "#card-sessions",
							"hx-swap":         "outerHTML",
							"hx-disabled-elt": "this",
						},
					}) {
						Stop
					}
				</div>
			}
			if s.Prompt != "" || s.LastMessage != "" {
				@card.Content(card.ContentProps{Class: "space-y-2"}) {
					if s.Prompt != "" {
						<div class="text-xs text-foreground line-clamp-2" title={ s.Prompt }>› { s.Prompt }</div>
					}
					if s.LastMessage != "" {
						<div class="bg-muted border border-border rounded-md text-xs text-muted-foreground px-2 py-1 line-clamp-2" title={ s.LastMessage }>{ s.LastMessage }</div>
					}
				}
			}
		}
	</li>
}

templ SessionDirPicker(p PickerProps) {
	<div class="bg-white border border-slate-200 rounded-lg mt-2 p-2">
		<div class="flex items-center gap-2 mb-2">
			if p.HasUp {
				<button type="button" class="text-xs px-2 py-1 bg-slate-100 hover:bg-slate-200 rounded"
					hx-get={ fmt.Sprintf("/sessions/picker?dir=%s", p.Parent) } hx-target="#dir-picker" hx-swap="innerHTML">↑ Up</button>
			}
			<span class="font-mono text-xs text-slate-700 truncate flex-1">{ p.Dir }</span>
			<button type="button" class="text-xs px-2 py-1 text-slate-500 hover:text-slate-900"
				onclick="document.getElementById('dir-picker').innerHTML=''">Close</button>
		</div>
		if p.Error != "" {
			<div class="text-red-700 text-xs mb-1">{ p.Error }</div>
		}
		if len(p.Entries) > 0 {
			<ul class="space-y-0.5 max-h-64 overflow-y-auto">
				for _, name := range p.Entries {
					<li>
						<button type="button" class="w-full text-left px-2 py-1 text-xs font-mono text-slate-700 hover:bg-slate-100 rounded"
							hx-get={ fmt.Sprintf("/sessions/picker?dir=%s/%s", p.Dir, name) } hx-target="#dir-picker" hx-swap="innerHTML">{ name }/</button>
					</li>
				}
			</ul>
		} else if p.Error == "" {
			<p class="text-xs text-slate-400 px-2 py-1">No subdirectories.</p>
		}
	</div>
	<span id="dir-text" hx-swap-oob="true" class="flex-1 font-mono text-xs text-slate-700 truncate bg-slate-50 px-2 py-1.5 border border-slate-200 rounded">{ p.Dir }</span>
	<input type="hidden" id="session-dir" name="dir" form="session-form" value={ p.Dir } hx-swap-oob="true" required/>
}
