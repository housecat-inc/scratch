package ui

import (
	"fmt"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
)

templ SetupPage(v SessionsProps) {
	@Layout("Setup", "setup", v.Shell) {
		<div class="setup-list">
			<div class="setup-group-title">Claude Code</div>
			@InstallCard(v)
			@LoginCard(v)
			<div class="setup-group-title">Codex</div>
			@CodexInstallRow(v)
			@CodexLoginRow(v)
			<div class="setup-group-title">Workspace</div>
			@ConfigureCard(v)
		</div>
	}
}

templ SessionsPage(v SessionsProps) {
	@Layout("Sessions", "sessions", v.Shell) {
		@SessionsCard(v)
	}
}

templ setupRow(id string, oob, done bool, title, hint string) {
	<div id={ id }
		if oob {
			hx-swap-oob="true"
		}
		class={ "setup-row", templ.KV("is-done", done) }
	>
		<span class="setup-check" aria-hidden="true">
			@doneIcon(done)
		</span>
		<div class="setup-body">
			<div class="setup-title">{ title }</div>
			if hint != "" {
				<div class="setup-hint">{ hint }</div>
			}
		</div>
		{ children... }
	</div>
}

templ stepError(msg string) {
	<div class="text-destructive text-xs mt-2 break-all basis-full">{ msg }</div>
}

func hxAction(method, url, target string) templ.Attributes {
	return templ.Attributes{
		"hx-" + method:    url,
		"hx-target":       target,
		"hx-swap":         "outerHTML",
		"hx-disabled-elt": "this",
	}
}

templ InstallCard(v SessionsProps) {
	@setupRow("card-install", v.Oob, v.Installed, "Install Claude Code", claudeInstallHint(v)) {
		if !v.Installed {
			@button.Button(button.Props{Size: button.SizeSm, Attributes: hxAction("post", "/install", "#card-install")}) {
				Install
			}
		} else {
			@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: hxAction("post", "/install", "#card-install")}) {
				Update
			}
		}
		if v.InstallError != "" {
			@stepError(v.InstallError)
		}
	}
}

func claudeInstallHint(v SessionsProps) string {
	if !v.Installed {
		return "claude + tmux · claude.ai/install.sh"
	}
	if v.ClaudeVersion != "" {
		return "claude v" + v.ClaudeVersion
	}
	return "Installed"
}

templ LoginCard(v SessionsProps) {
	@setupRow("card-login", v.Oob, v.Authenticated, "Sign in", "Anthropic subscription") {
		if !v.Authenticated {
			if v.LoginURL != "" {
				@button.Button(button.Props{
					Size:       button.SizeSm,
					Variant:    button.VariantSecondary,
					Href:       v.LoginURL,
					Target:     "_blank",
					Attributes: templ.Attributes{"rel": "noopener"},
				}) {
					Open claude.com →
				}
				@button.Button(button.Props{
					Size:    button.SizeSm,
					Variant: button.VariantOutline,
					Type:    button.TypeButton,
					Attributes: templ.Attributes{
						"data-url": v.LoginURL,
						"onclick":  "navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied'",
					},
				}) {
					Copy URL
				}
				<form hx-post="/login/code" hx-target="#card-login" hx-swap="outerHTML" class="flex gap-2 mt-2 basis-full">
					<input type="text" name="code" placeholder="paste code" autocomplete="off" autofocus required
						class="flex-1 px-3 py-2 text-sm border border-input rounded-md bg-background shadow-xs focus-visible:ring-2 focus-visible:ring-ring/40 outline-none"/>
					@button.Button(button.Props{Size: button.SizeSm, Type: button.TypeSubmit}) {
						Submit
					}
				</form>
			} else if v.Installed {
				@button.Button(button.Props{Size: button.SizeSm, Attributes: hxAction("post", "/login", "#card-login")}) {
					Connect
				}
			}
		}
		if v.LoginError != "" {
			@stepError(v.LoginError)
		}
	}
}

templ CodexInstallRow(v SessionsProps) {
	@setupRow("card-codex-install", false, v.CodexInstalled, "Install Codex", codexInstallHint(v)) {
		if !v.CodexInstalled {
			@button.Button(button.Props{
				Size:       button.SizeSm,
				Variant:    button.VariantOutline,
				Href:       "https://github.com/openai/codex",
				Target:     "_blank",
				Attributes: templ.Attributes{"rel": "noopener"},
			}) {
				Get Codex
			}
		}
	}
}

func codexInstallHint(v SessionsProps) string {
	if !v.CodexInstalled {
		return "codex CLI not installed"
	}
	if v.CodexVersion != "" {
		return "codex v" + v.CodexVersion
	}
	return "Installed"
}

templ CodexLoginRow(v SessionsProps) {
	@setupRow("card-codex-login", false, v.CodexAuthenticated, "Sign in", codexLoginHint(v)) {
		if !v.CodexAuthenticated {
			if v.CodexLoginURL != "" {
				@button.Button(button.Props{
					Size:       button.SizeSm,
					Variant:    button.VariantSecondary,
					Href:       v.CodexLoginURL,
					Target:     "_blank",
					Attributes: templ.Attributes{"rel": "noopener"},
				}) {
					Open auth.openai.com →
				}
				<code class="setup-cmd">{ v.CodexLoginCode }</code>
				<span class="setup-hint basis-full inline-flex items-center gap-1"
					hx-get="/codex/login" hx-trigger="every 3s" hx-target="#card-codex-login" hx-swap="outerHTML">
					Waiting for authorization…
				</span>
			} else if v.CodexInstalled {
				@button.Button(button.Props{Size: button.SizeSm, Attributes: hxAction("post", "/codex/login", "#card-codex-login")}) {
					Connect
				}
			}
		}
		if v.CodexLoginError != "" {
			@stepError(v.CodexLoginError)
		}
	}
}

func codexLoginHint(v SessionsProps) string {
	switch {
	case v.CodexAuthenticated:
		return "OpenAI subscription"
	case v.CodexLoginURL != "":
		return "Enter this code at auth.openai.com"
	case !v.CodexInstalled:
		return "Install Codex first"
	}
	return "OpenAI subscription"
}

templ ConfigureCard(v SessionsProps) {
	@setupRow("card-configure", v.Oob, configureDone(v), "Configure", configureHint(v)) {
		if !v.Configured && v.Authenticated {
			@button.Button(button.Props{Size: button.SizeSm, Attributes: hxAction("post", "/configure", "#card-configure")}) {
				Configure
			}
		} else if v.Configured {
			if v.AgentsDirty {
				@button.Button(button.Props{Size: button.SizeSm, Href: "/"}) {
					Commit &amp; Push →
				}
			}
			if v.AgentsBehind > 0 {
				@button.Button(button.Props{Size: button.SizeSm, Href: "/"}) {
					Pull →
				}
			}
		}
		if v.ConfigureError != "" {
			@stepError(v.ConfigureError)
		}
	}
}

func configureDone(v SessionsProps) bool {
	return v.Configured && !v.AgentsDirty && v.AgentsBehind <= 0
}

func sessionsReady(v SessionsProps) bool {
	return v.Installed && v.Authenticated
}

func configureHint(v SessionsProps) string {
	switch {
	case !v.Authenticated:
		return ""
	case !v.Configured:
		return "Write AGENTS.md and settings in $HOME"
	case v.AgentsDirty:
		return "Local changes in ./scratch"
	case v.AgentsBehind > 0:
		return "Upstream changes to ./scratch"
	}
	return ""
}

templ SessionsCard(v SessionsProps) {
	<section
		id="card-sessions"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		if !sessionsReady(v) {
			@AppCard("bg-amber-50 border-amber-200") {
				@card.Content() {
					<p class="text-sm text-foreground">Finish <a href="/setup" class="text-blue-700 underline">Setup</a> to start sessions.</p>
				}
			}
		} else {
			<style>
				.session-form .session-spinner { display: none; }
				.session-form.htmx-request .session-spinner { display: inline-flex; }
				.session-form.htmx-request .session-idle-label { display: none; }
				.session-form.htmx-request .session-busy-label { display: inline; }
				.session-busy-label { display: none; }
				.session-form.htmx-request fieldset { opacity: 0.6; pointer-events: none; }
				@keyframes session-spin { to { transform: rotate(360deg); } }
				.session-spinner svg { animation: session-spin 0.8s linear infinite; }
			</style>
			<form id="session-form" class="session-form mb-3"
				hx-post="/sessions" hx-target="#card-sessions" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]">
				@AppCard() {
					@card.Header(card.HeaderProps{Class: "pb-0"}) {
						@AppTitle() {
							New session
						}
						@card.Description() {
							Spawn a claude-code session in a working directory
						}
					}
					@card.Content() {
						<fieldset class="space-y-4 p-0 m-0 border-0 min-w-0">
							<div class="space-y-2">
								<label class="block text-sm font-medium text-foreground">Working directory</label>
								<div class="flex items-center gap-2">
									<span id="dir-text" class="flex-1 min-w-0 font-mono text-sm text-foreground truncate bg-muted px-3 py-2 border border-border rounded-md">{ v.SessionDir }</span>
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Type:    button.TypeButton,
										Attributes: templ.Attributes{
											"hx-get":    fmt.Sprintf("/sessions/picker?dir=%s", v.SessionDir),
											"hx-target": "#dir-picker",
											"hx-swap":   "innerHTML",
										},
									}) {
										Browse
									}
								</div>
								<input type="hidden" name="dir" id="session-dir" value={ v.SessionDir } required/>
								<div id="dir-picker"></div>
							</div>
							<div class="space-y-2">
								<label class="block text-sm font-medium text-foreground">Prompt <span class="text-muted-foreground font-normal">(optional)</span></label>
								<textarea name="prompt" rows="3" placeholder="What should this session do?"
									class="w-full px-3 py-2 text-sm border border-input rounded-md bg-background shadow-xs resize-y focus-visible:ring-2 focus-visible:ring-ring/40 outline-none"></textarea>
							</div>
						</fieldset>
					}
					@card.Footer(card.FooterProps{Class: "justify-end gap-2"}) {
						<span class="session-spinner items-center gap-1.5 text-xs text-muted-foreground">
							<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" stroke-opacity="0.25"></circle>
								<path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
							</svg>
							<span>Starting session…</span>
						</span>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							<span class="session-idle-label">Start session</span>
							<span class="session-busy-label">Starting…</span>
						}
					}
				}
			</form>
			if v.SessionError != "" {
				<div class="text-red-700 text-xs mb-3 break-all">{ v.SessionError }</div>
			}
			if len(v.Sessions) > 0 {
				<ul class="space-y-2">
					for _, s := range v.Sessions {
						@sessionItem(s)
					}
				</ul>
			} else {
				<p class="text-sm text-slate-500">No sessions running yet.</p>
			}
		}
	</section>
}

templ sessionItem(s SessionProps) {
	<li id={ fmt.Sprintf("session-%s", s.ID) }>
		@AppCard() {
			@card.Header(card.HeaderProps{Class: "pb-0 flex flex-row items-start gap-4 space-y-0"}) {
				<img class="w-16 h-16 flex-shrink-0 border border-border rounded-md"
					src={ fmt.Sprintf("/sessions/%s/qr", s.ID) }
					alt={ fmt.Sprintf("QR code for %s", s.Name) }/>
				<div class="flex-1 min-w-0 space-y-1.5">
					@AppTitle("truncate") {
						{ s.Name }
					}
					@card.Description(card.DescriptionProps{Class: "truncate font-mono"}) {
						{ s.Dir }
					}
					<a class="block text-xs text-blue-700 break-all hover:underline" href={ templ.SafeURL(s.URL) } target="_blank" rel="noopener">{ s.URL }</a>
				</div>
				<div class="flex flex-col gap-1 flex-shrink-0">
					@button.Button(button.Props{
						Size:    button.SizeSm,
						Variant: button.VariantOutline,
						Type:    button.TypeButton,
						Attributes: templ.Attributes{
							"data-url": s.URL,
							"onclick":  "navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied'",
						},
					}) {
						Copy
					}
					@button.Button(button.Props{
						Size:    button.SizeSm,
						Variant: button.VariantDestructive,
						Type:    button.TypeButton,
						Attributes: templ.Attributes{
							"hx-delete":       fmt.Sprintf("/sessions/%s", s.ID),
							"hx-target":       "#card-sessions",
							"hx-swap":         "outerHTML",
							"hx-disabled-elt": "this",
						},
					}) {
						Stop
					}
				</div>
			}
			if s.Prompt != "" || s.LastMessage != "" {
				@card.Content(card.ContentProps{Class: "space-y-2"}) {
					if s.Prompt != "" {
						<div class="text-xs text-foreground line-clamp-2" title={ s.Prompt }>› { s.Prompt }</div>
					}
					if s.LastMessage != "" {
						<div class="bg-muted border border-border rounded-md text-xs text-muted-foreground px-2 py-1 line-clamp-2" title={ s.LastMessage }>{ s.LastMessage }</div>
					}
				}
			}
		}
	</li>
}

templ SessionDirPicker(p PickerProps) {
	<div class="bg-card text-card-foreground border border-border rounded-md mt-2 p-2 shadow-xs">
		<div class="flex items-center gap-2 mb-2">
			if p.HasUp {
				@button.Button(button.Props{
					Size:    button.SizeSm,
					Variant: button.VariantOutline,
					Type:    button.TypeButton,
					Attributes: templ.Attributes{
						"hx-get":    fmt.Sprintf("/sessions/picker?dir=%s", p.Parent),
						"hx-target": "#dir-picker",
						"hx-swap":   "innerHTML",
					},
				}) {
					↑ Up
				}
			}
			<span class="font-mono text-xs text-foreground truncate flex-1">{ p.Dir }</span>
			@button.Button(button.Props{
				Size:    button.SizeSm,
				Variant: button.VariantGhost,
				Type:    button.TypeButton,
				Attributes: templ.Attributes{"onclick": "document.getElementById('dir-picker').innerHTML=''"},
			}) {
				Close
			}
		</div>
		if p.Error != "" {
			<div class="text-destructive text-xs mb-1">{ p.Error }</div>
		}
		if len(p.Entries) > 0 {
			<ul class="space-y-0.5 max-h-64 overflow-y-auto">
				for _, name := range p.Entries {
					<li>
						<button type="button" class="w-full text-left px-2 py-1 text-xs font-mono text-foreground hover:bg-accent hover:text-accent-foreground rounded-md"
							hx-get={ fmt.Sprintf("/sessions/picker?dir=%s/%s", p.Dir, name) } hx-target="#dir-picker" hx-swap="innerHTML">{ name }/</button>
					</li>
				}
			</ul>
		} else if p.Error == "" {
			<p class="text-xs text-muted-foreground px-2 py-1">No subdirectories.</p>
		}
	</div>
	<span id="dir-text" hx-swap-oob="true" class="flex-1 font-mono text-sm text-foreground truncate bg-muted px-3 py-2 border border-border rounded-md">{ p.Dir }</span>
	<input type="hidden" id="session-dir" name="dir" form="session-form" value={ p.Dir } hx-swap-oob="true" required/>
}
