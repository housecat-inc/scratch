package ui

import (
	"fmt"

	"github.com/templui/templui/components/card"
)

templ SetupPage(v SessionsProps) {
	@Layout("Setup", "setup") {
		<ol class="space-y-2">
			@InstallCard(v)
			@LoginCard(v)
			@ConfigureCard(v)
		</ol>
	}
}

templ SessionsPage(v SessionsProps) {
	@Layout("Sessions", "sessions") {
		@SessionsCard(v)
	}
}

templ InstallCard(v SessionsProps) {
	<li id="card-install"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		@card.Card(card.Props{Class: "px-4 py-3 flex items-start gap-3 " + installCardTone(v)}) {
			<span class={ "w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold", installBadgeTone(v) }>
				if v.Installed {
					✓
				} else {
					1
				}
			</span>
			<div class="flex-1 min-w-0">
				<div class="font-semibold">Install</div>
				if !v.Installed {
					<p class="text-xs text-muted-foreground mt-0.5">Run claude.ai/install.sh</p>
					<button hx-post="/install" hx-target="#card-install" hx-swap="outerHTML" hx-disabled-elt="this"
						class="mt-2 px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded disabled:opacity-50">
						Install
					</button>
				}
				if v.InstallError != "" {
					<div class="text-destructive text-xs mt-2 break-all">{ v.InstallError }</div>
				}
			</div>
		}
	</li>
}

func installCardTone(v SessionsProps) string {
	if v.Installed {
		return "bg-emerald-50 border border-emerald-200"
	}
	return "bg-amber-50 border border-amber-200"
}

func installBadgeTone(v SessionsProps) string {
	if v.Installed {
		return "bg-emerald-600 text-white"
	}
	return "bg-white border-2 border-amber-300 text-amber-700"
}

templ LoginCard(v SessionsProps) {
	<li id="card-login"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		@card.Card(card.Props{Class: "px-4 py-3 flex items-start gap-3 " + loginCardTone(v)}) {
			<span class={ "w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold", loginBadgeTone(v) }>
				if v.Authenticated {
					✓
				} else {
					2
				}
			</span>
			<div class="flex-1 min-w-0">
				<div class="font-semibold">Pay</div>
				if !v.Authenticated {
					if v.LoginURL != "" {
						<p class="text-xs text-muted-foreground mt-0.5">Open the authorize page and paste the code below</p>
						<div class="flex gap-2 mt-2 flex-wrap">
							<a href={ templ.SafeURL(v.LoginURL) } target="_blank" rel="noopener"
								class="px-3 py-1.5 text-sm bg-secondary rounded text-blue-700 hover:bg-secondary/80">
								Open claude.com →
							</a>
							<button type="button" class="px-3 py-1.5 text-sm bg-secondary rounded text-secondary-foreground hover:bg-secondary/80"
								data-url={ v.LoginURL }
								onclick="navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied'">
								Copy URL
							</button>
						</div>
						<form hx-post="/login/code" hx-target="#card-login" hx-swap="outerHTML" class="flex gap-2 mt-2">
							<input type="text" name="code" placeholder="paste code" autocomplete="off" autofocus required
								class="flex-1 px-2 py-1.5 text-sm border border-input rounded bg-background"/>
							<button type="submit" class="px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded">Submit</button>
						</form>
					} else if v.Installed {
						<p class="text-xs text-muted-foreground mt-0.5">Connect Anthropic subscription</p>
						<button hx-post="/login" hx-target="#card-login" hx-swap="outerHTML" hx-disabled-elt="this"
							class="mt-2 px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded disabled:opacity-50">
							Connect
						</button>
					}
				}
				if v.LoginError != "" {
					<div class="text-destructive text-xs mt-2 break-all">{ v.LoginError }</div>
				}
			</div>
		}
	</li>
}

func loginCardTone(v SessionsProps) string {
	switch {
	case v.Authenticated:
		return "bg-emerald-50 border border-emerald-200"
	case v.Installed:
		return "bg-amber-50 border border-amber-200"
	}
	return "bg-white border border-slate-200 opacity-60"
}

func loginBadgeTone(v SessionsProps) string {
	switch {
	case v.Authenticated:
		return "bg-emerald-600 text-white"
	case v.Installed:
		return "bg-white border-2 border-amber-300 text-amber-700"
	}
	return "bg-white border-2 border-slate-300 text-slate-500"
}

templ ConfigureCard(v SessionsProps) {
	<li id="card-configure"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		@card.Card(card.Props{Class: "px-4 py-3 flex items-start gap-3 " + configureCardTone(v)}) {
			<span class={ "w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold", configureBadgeTone(v) }>
				if configureDone(v) {
					✓
				} else {
					3
				}
			</span>
			<div class="flex-1 min-w-0">
				<div class="font-semibold">Configure</div>
				if !v.Configured && v.Authenticated {
					<p class="text-xs text-muted-foreground mt-0.5">Write claude markdown and settings in $HOME</p>
					<button hx-post="/configure" hx-target="#card-configure" hx-swap="outerHTML" hx-disabled-elt="this"
						class="mt-2 px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded disabled:opacity-50">
						Configure
					</button>
				} else if v.Configured {
					if v.AgentsDirty {
						<p class="text-xs text-muted-foreground mt-0.5">Local changes in ./scratch</p>
						<a href="/" class="inline-block mt-2 px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded">Commit &amp; Push from Sessions →</a>
					}
					if v.AgentsBehind > 0 {
						<p class="text-xs text-muted-foreground mt-0.5">Upstream changes to ./scratch</p>
						<a href="/" class="inline-block mt-2 px-3 py-1.5 text-sm bg-primary text-primary-foreground rounded">Pull from Sessions →</a>
					}
				}
				if v.ConfigureError != "" {
					<div class="text-destructive text-xs mt-2 break-all">{ v.ConfigureError }</div>
				}
			</div>
		}
	</li>
}

func configureDone(v SessionsProps) bool {
	return v.Configured && !v.AgentsDirty && v.AgentsBehind <= 0
}

func configureCardTone(v SessionsProps) string {
	switch {
	case configureDone(v):
		return "bg-emerald-50 border border-emerald-200"
	case v.Authenticated:
		return "bg-amber-50 border border-amber-200"
	}
	return "bg-white border border-slate-200 opacity-60"
}

func configureBadgeTone(v SessionsProps) string {
	switch {
	case configureDone(v):
		return "bg-emerald-600 text-white"
	case v.Authenticated:
		return "bg-white border-2 border-amber-300 text-amber-700"
	}
	return "bg-white border-2 border-slate-300 text-slate-500"
}

templ SessionsCard(v SessionsProps) {
	<section
		id="card-sessions"
		if v.Oob {
			hx-swap-oob="true"
		}
	>
		if !v.Configured {
			<div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
				<p class="text-sm text-slate-700">Finish <a href="/setup" class="text-blue-700 underline">Setup</a> to start sessions.</p>
			</div>
		} else {
			<form id="session-form" class="bg-card text-card-foreground border border-border rounded-lg shadow-xs p-3 space-y-2 mb-3 session-form"
				hx-post="/sessions" hx-target="#card-sessions" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]">
				<style>
					.session-form .session-spinner { display: none; }
					.session-form.htmx-request .session-spinner { display: inline-flex; }
					.session-form.htmx-request .session-idle-label { display: none; }
					.session-form.htmx-request .session-busy-label { display: inline; }
					.session-busy-label { display: none; }
					.session-form.htmx-request fieldset { opacity: 0.6; pointer-events: none; }
					@keyframes session-spin { to { transform: rotate(360deg); } }
					.session-spinner svg { animation: session-spin 0.8s linear infinite; }
				</style>
				<fieldset class="space-y-2 p-0 m-0 border-0">
					<div>
						<label class="block text-xs font-medium text-slate-600 mb-1">Working directory</label>
						<div class="flex items-center gap-2">
							<span id="dir-text" class="flex-1 font-mono text-xs text-slate-700 truncate bg-slate-50 px-2 py-1.5 border border-slate-200 rounded">{ v.SessionDir }</span>
							<button type="button" class="text-xs px-2 py-1.5 bg-slate-100 hover:bg-slate-200 rounded border border-slate-200"
								hx-get={ fmt.Sprintf("/sessions/picker?dir=%s", v.SessionDir) }
								hx-target="#dir-picker" hx-swap="innerHTML">Browse</button>
						</div>
						<input type="hidden" name="dir" id="session-dir" value={ v.SessionDir } required/>
						<div id="dir-picker"></div>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-600 mb-1">Prompt <span class="text-slate-400 font-normal">(optional)</span></label>
						<textarea name="prompt" rows="3" placeholder="What should this session do?"
							class="w-full px-2 py-1.5 text-sm border border-slate-300 rounded resize-y"></textarea>
					</div>
				</fieldset>
				<div class="flex justify-end items-center gap-2">
					<span class="session-spinner items-center gap-1.5 text-xs text-slate-500">
						<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" stroke-opacity="0.25"></circle>
							<path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
						</svg>
						<span>Starting session…</span>
					</span>
					<button type="submit" class="px-3 py-1.5 text-sm bg-slate-900 text-white rounded disabled:opacity-60 inline-flex items-center gap-1.5">
						<span class="session-idle-label">Start session</span>
						<span class="session-busy-label">Starting…</span>
					</button>
				</div>
			</form>
			if v.SessionError != "" {
				<div class="text-red-700 text-xs mb-3 break-all">{ v.SessionError }</div>
			}
			if len(v.Sessions) > 0 {
				<ul class="space-y-2">
					for _, s := range v.Sessions {
						@sessionItem(s)
					}
				</ul>
			} else {
				<p class="text-sm text-slate-500">No sessions running yet.</p>
			}
		}
	</section>
}

templ sessionItem(s SessionProps) {
	<li id={ fmt.Sprintf("session-%s", s.ID) }>
		@card.Card(card.Props{Class: "p-3 space-y-2"}) {
			<div class="flex gap-3 items-start">
				<img class="w-24 h-24 flex-shrink-0 border border-border rounded"
					src={ fmt.Sprintf("/sessions/%s/qr", s.ID) }
					alt={ fmt.Sprintf("QR code for %s", s.Name) }/>
				<div class="flex-1 min-w-0">
					<div class="font-semibold truncate">{ s.Name }</div>
					<div class="text-xs text-muted-foreground truncate">{ s.Dir }</div>
					<a class="text-xs text-blue-700 break-all hover:underline" href={ templ.SafeURL(s.URL) } target="_blank" rel="noopener">{ s.URL }</a>
					if s.Prompt != "" {
						<div class="mt-1 text-xs text-card-foreground line-clamp-2" title={ s.Prompt }>› { s.Prompt }</div>
					}
				</div>
				<div class="flex flex-col gap-1 flex-shrink-0">
					<button type="button" class="text-xs px-2 py-1 bg-secondary hover:bg-secondary/80 rounded text-blue-700"
						data-url={ s.URL }
						onclick="navigator.clipboard.writeText(this.dataset.url);this.textContent='Copied'">Copy</button>
					<button class="text-xs px-2 py-1 bg-red-50 hover:bg-red-100 text-destructive border border-red-200 rounded"
						hx-delete={ fmt.Sprintf("/sessions/%s", s.ID) } hx-target="#card-sessions" hx-swap="outerHTML" hx-disabled-elt="this">Stop</button>
				</div>
			</div>
			if s.LastMessage != "" {
				<div class="bg-muted border border-border rounded text-xs text-card-foreground px-2 py-1 line-clamp-2" title={ s.LastMessage }>{ s.LastMessage }</div>
			}
		}
	</li>
}

templ SessionDirPicker(p PickerProps) {
	<div class="bg-white border border-slate-200 rounded-lg mt-2 p-2">
		<div class="flex items-center gap-2 mb-2">
			if p.HasUp {
				<button type="button" class="text-xs px-2 py-1 bg-slate-100 hover:bg-slate-200 rounded"
					hx-get={ fmt.Sprintf("/sessions/picker?dir=%s", p.Parent) } hx-target="#dir-picker" hx-swap="innerHTML">↑ Up</button>
			}
			<span class="font-mono text-xs text-slate-700 truncate flex-1">{ p.Dir }</span>
			<button type="button" class="text-xs px-2 py-1 text-slate-500 hover:text-slate-900"
				onclick="document.getElementById('dir-picker').innerHTML=''">Close</button>
		</div>
		if p.Error != "" {
			<div class="text-red-700 text-xs mb-1">{ p.Error }</div>
		}
		if len(p.Entries) > 0 {
			<ul class="space-y-0.5 max-h-64 overflow-y-auto">
				for _, name := range p.Entries {
					<li>
						<button type="button" class="w-full text-left px-2 py-1 text-xs font-mono text-slate-700 hover:bg-slate-100 rounded"
							hx-get={ fmt.Sprintf("/sessions/picker?dir=%s/%s", p.Dir, name) } hx-target="#dir-picker" hx-swap="innerHTML">{ name }/</button>
					</li>
				}
			</ul>
		} else if p.Error == "" {
			<p class="text-xs text-slate-400 px-2 py-1">No subdirectories.</p>
		}
	</div>
	<span id="dir-text" hx-swap-oob="true" class="flex-1 font-mono text-xs text-slate-700 truncate bg-slate-50 px-2 py-1.5 border border-slate-200 rounded">{ p.Dir }</span>
	<input type="hidden" id="session-dir" name="dir" form="session-form" value={ p.Dir } hx-swap-oob="true" required/>
}
