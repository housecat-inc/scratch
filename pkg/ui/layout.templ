package ui

import (
	"strconv"
	"strings"

	"github.com/housecat-inc/scratch/uikit"
	"github.com/templui/templui/components/card"
	lucide "github.com/wux4an/lucide-templ/icons"
)

templ AppCard(extra ...string) {
	@card.Card(card.Props{Class: strings.TrimSpace("rounded-xl shadow-sm gap-3 " + strings.Join(extra, " "))}) {
		{ children... }
	}
}

templ AppTitle(extra ...string) {
	@card.Title(card.TitleProps{Class: strings.TrimSpace("text-base " + strings.Join(extra, " "))}) {
		{ children... }
	}
}

templ InboxBrand() {
	<div class="inbox-brand">
		<span class="inbox-brand-mark">s</span>
		<span>scratch</span>
	</div>
}

templ InboxNav(active string, tasks, chats int) {
	<nav class="inbox-nav" aria-label="Primary">
		@inboxNavLink("/inbox/tasks", "todo", active, "Tasks", tasks)
		@inboxNavLink("/inbox/chats", "chat", active, "Chat", chats)
		@inboxNavLink("/code/", "code", active, "Code", 0)
		@inboxNavLink("/files/", "files", active, "Files", 0)
		@inboxNavLink("/setup", "setup", active, "Setup", 0)
	</nav>
}

templ InboxLayout(active string, tasks, chats int) {
	<div class="inbox-shell">
		<aside class="inbox-sidebar">
			@InboxBrand()
			@InboxNav(active, tasks, chats)
		</aside>
		<main class="inbox-main">
			{ children... }
		</main>
	</div>
}

templ MailHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<meta name="color-scheme" content="light"/>
		<title>{ title } · scratch</title>
		<link rel="manifest" href="/manifest.webmanifest"/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
		<meta name="apple-mobile-web-app-title" content="scratch"/>
		<meta name="mobile-web-app-capable" content="yes"/>
		<meta name="application-name" content="scratch"/>
		<meta name="theme-color" content="#0f172a"/>
		<link rel="apple-touch-icon" href="/static/icon-180.png"/>
		<link rel="icon" type="image/svg+xml" href="/static/icon.svg"/>
		@InboxCSS()
		@ChatCSS()
		@DataTableCSS()
		@TempluiCSS()
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		@ToolShellCSS()
		<script src="/static/htmx.min.js"></script>
		<script src="/static/htmx-ext-sse.min.js"></script>
		<script src="/static/register-sw.js" defer></script>
		<script src="/static/ptr.js" defer></script>
		<script src="/static/html2canvas.min.js" defer></script>
		<script src="/static/chat.js" defer></script>
		<script src="/static/contacts.js" defer></script>
		{ children... }
	</head>
}

templ Head(title string) {
	@MailHead(title)
}

templ ToolShellCSS() {
	<style>
		.mail-shell svg { display: inline; vertical-align: baseline; }
		@media (max-width: 767px) {
			.split-pane:not(.show-editor) .editor-pane { display: none; }
			.split-pane.show-editor .tree-pane { display: none; }
		}
	</style>
}

templ Layout(title, nav string, shells ...ToolShellProps) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(title)
		<body>
			@uikit.Shell(uikit.ShellProps{
				Actions:    toolActions(toolShell(shells)),
				AppName:    "scratch",
				BrandHref:  "/",
				Footer:     ToolComposer(),
				MainClass:  "mail-tool-main",
				Nav:        toolNavItems(nav, toolShell(shells).Counts),
				SidebarTop: ComposeActions(),
			}) {
				<div class="mail-tool-content">
					<header class="mail-mainbar">
						<div class="mail-mainbar-title">
							<h1>{ title }</h1>
						</div>
					</header>
					<div class="mail-tool-body">
						{ children... }
					</div>
				</div>
			}
		</body>
	</html>
}

func toolNavItems(active string, counts InboxCounts) []uikit.NavItem {
	return []uikit.NavItem{
		{Active: active == "inbox", Count: counts.Inbox, Href: "/", Icon: lucide.Inbox(), Label: "Inbox", ShowCount: true},
		{Active: active == "starred", Count: counts.Starred, Href: "/starred", Icon: lucide.Star(), Label: "Starred", ShowCount: true},
		{Active: active == "chats", Count: counts.Chats, Group: "More", Href: "/inbox/chats", Icon: lucide.MessageSquare(), Label: "Chats", ShowCount: true},
		{Active: active == "tasks", Count: counts.Tasks, Href: "/inbox/tasks", Icon: lucide.ListChecks(), Label: "Tasks", ShowCount: true},
		{Active: active == "workflows", Count: counts.Workflows, Href: "/inbox/workflows", Icon: lucide.Play(), Label: "Workflows", ShowCount: true},
		{Active: active == "setup", Group: "Tools", Href: "/setup", Icon: lucide.Settings(), Label: "Setup"},
		{Active: active == "sessions", Href: "/sessions", Icon: lucide.MessageSquare(), Label: "Sessions"},
		{Active: active == "code", Href: "/code/", Icon: lucide.CodeXml(), Label: "Code review"},
		{Active: active == "files", Href: "/files/", Icon: lucide.File(), Label: "Files"},
		{Active: active == "sql", Href: "/sql/", Icon: lucide.Database(), Label: "SQL"},
	}
}

templ ToolComposer() {
	@ChatComposer(ChatComposerProps{
		Action:      "/compose",
		FileName:    "file",
		Placeholder: "Chat with agent",
	})
}

templ toolActions(p ToolShellProps) {
	@uikit.NewChatAction(uikit.NewChatActionProps{Options: p.ChatOptions})
}

func toolShell(shells []ToolShellProps) ToolShellProps {
	if len(shells) == 0 {
		return ToolShellProps{}
	}
	return shells[0]
}

templ inboxNavLink(href, name, active, label string, count int) {
	<a href={ templ.SafeURL(href) } class={ "inbox-nav-item", templ.KV("active", name == active) }>
		<span>{ label }</span>
		if count > 0 {
			<span class="inbox-nav-count">{ strconv.Itoa(count) }</span>
		}
	</a>
}
