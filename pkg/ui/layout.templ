package ui

import (
	"strconv"
	"strings"

	"github.com/housecat-inc/scratch/uikit"
	"github.com/templui/templui/components/card"
)

templ AppCard(extra ...string) {
	@card.Card(card.Props{Class: strings.TrimSpace("rounded-xl shadow-sm gap-3 " + strings.Join(extra, " "))}) {
		{ children... }
	}
}

templ AppTitle(extra ...string) {
	@card.Title(card.TitleProps{Class: strings.TrimSpace("text-base " + strings.Join(extra, " "))}) {
		{ children... }
	}
}

templ InboxBrand() {
	<div class="inbox-brand">
		<span class="inbox-brand-mark">s</span>
		<span>scratch</span>
	</div>
}

templ InboxNav(active string, tasks, chats int) {
	<nav class="inbox-nav" aria-label="Primary">
		@inboxNavLink("/inbox/tasks", "todo", active, "Tasks", tasks)
		@inboxNavLink("/inbox/chats", "chat", active, "Chat", chats)
		@inboxNavLink("/code/", "code", active, "Code", 0)
		@inboxNavLink("/files/", "files", active, "Files", 0)
		@inboxNavLink("/setup", "setup", active, "Setup", 0)
	</nav>
}

templ InboxLayout(active string, tasks, chats int) {
	<div class="inbox-shell">
		<aside class="inbox-sidebar">
			@InboxBrand()
			@InboxNav(active, tasks, chats)
		</aside>
		<main class="inbox-main">
			{ children... }
		</main>
	</div>
}

templ Head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<meta name="color-scheme" content="light"/>
		<title>{ title } · scratch</title>
		<link rel="manifest" href="/manifest.webmanifest"/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
		<meta name="apple-mobile-web-app-title" content="scratch"/>
		<meta name="mobile-web-app-capable" content="yes"/>
		<meta name="application-name" content="scratch"/>
		<meta name="theme-color" content="#0f172a"/>
		<link rel="apple-touch-icon" href="/static/icon-180.png"/>
		<link rel="icon" type="image/svg+xml" href="/static/icon.svg"/>
		@InboxCSS()
		@TempluiCSS()
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"></script>
		<script src="/static/register-sw.js" defer></script>
		<script src="/static/ptr.js" defer></script>
	</head>
}

templ TopNav(active string) {
	<nav class="bg-white sticky top-0 z-20" style="padding-top:env(safe-area-inset-top)">
		<div class="max-w-2xl mx-auto flex">
			@navLink("/", "sessions", active, "Sessions")
			@navLink("/code/", "code", active, "Code")
			@navLink("/files/", "files", active, "Files")
			@navLink("/setup", "setup", active, "Setup")
		</div>
	</nav>
}

templ navLink(href, name, active, label string) {
	if name == active {
		<a href={ templ.SafeURL(href) } class="flex-1 text-center py-3 text-sm font-medium text-slate-900 border-b-2 border-slate-900">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="flex-1 text-center py-3 text-sm font-medium text-slate-500 hover:text-slate-900">{ label }</a>
	}
}

templ Layout(title, nav string) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(title)
		<body>
			@uikit.Shell(uikit.ShellProps{
				AppName: "scratch",
				BrandHref: "/",
				MainClass: "mail-tool-main",
				Nav: toolNavItems(nav),
			}) {
				<div class="mail-tool-content">
					<header class="mail-mainbar">
						<div class="mail-mainbar-title">
							<h1>{ title }</h1>
						</div>
					</header>
					<div class="mail-tool-body">
						{ children... }
					</div>
				</div>
			}
		</body>
	</html>
}

func toolNavItems(active string) []uikit.NavItem {
	return []uikit.NavItem{
		{Active: active == "sessions", Href: "/sessions", Icon: "chat", Label: "Sessions"},
		{Active: active == "setup", Href: "/setup", Icon: "settings", Label: "Setup"},
		{Active: active == "code", Href: "/code/", Icon: "code", Label: "Code review"},
		{Active: active == "files", Href: "/files/", Icon: "file", Label: "Files"},
		{Group: "App", Href: "/", Icon: "inbox", Label: "Inbox"},
	}
}

templ inboxNavLink(href, name, active, label string, count int) {
	<a href={ templ.SafeURL(href) } class={ "inbox-nav-item", templ.KV("active", name == active) }>
		<span>{ label }</span>
		if count > 0 {
			<span class="inbox-nav-count">{ strconv.Itoa(count) }</span>
		}
	</a>
}
