package ui

templ Head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<title>{ title } · claude-control</title>
		<link rel="manifest" href="/manifest.webmanifest"/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
		<meta name="apple-mobile-web-app-title" content="claude-control"/>
		<meta name="mobile-web-app-capable" content="yes"/>
		<meta name="application-name" content="claude-control"/>
		<meta name="theme-color" content="#0f172a"/>
		<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"></script>
		<style type="text/tailwindcss">
		@theme inline {
			--color-background: #f8fafc;
			--color-foreground: #0f172a;
			--color-card: #ffffff;
			--color-card-foreground: #0f172a;
			--color-popover: #ffffff;
			--color-popover-foreground: #0f172a;
			--color-primary: #0f172a;
			--color-primary-foreground: #ffffff;
			--color-secondary: #f1f5f9;
			--color-secondary-foreground: #0f172a;
			--color-muted: #f1f5f9;
			--color-muted-foreground: #64748b;
			--color-accent: #f1f5f9;
			--color-accent-foreground: #0f172a;
			--color-destructive: #b91c1c;
			--color-border: #e2e8f0;
			--color-input: #e2e8f0;
			--color-ring: #94a3b8;
		}
		</style>
	</head>
}

templ TopNav(active string) {
	<nav class="bg-white sticky top-0 z-20" style="padding-top:env(safe-area-inset-top)">
		<div class="max-w-2xl mx-auto flex">
			@navLink("/", "sessions", active, "Sessions")
			@navLink("/code/", "code", active, "Code")
			@navLink("/files/", "files", active, "Files")
			@navLink("/setup", "setup", active, "Setup")
		</div>
	</nav>
}

templ navLink(href, name, active, label string) {
	if name == active {
		<a href={ templ.SafeURL(href) } class="flex-1 text-center py-3 text-sm font-medium text-slate-900 border-b-2 border-slate-900">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="flex-1 text-center py-3 text-sm font-medium text-slate-500 hover:text-slate-900">{ label }</a>
	}
}

templ Layout(title, nav string) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(title)
		<body class="bg-slate-50 text-slate-900 min-h-screen">
			@TopNav(nav)
			<main class="max-w-2xl mx-auto px-4 py-4">
				{ children... }
			</main>
		</body>
	</html>
}
