package ui

import "strconv"

templ ChatComposer(p ChatComposerProps) {
	if p.UploadURL != "" {
		<form
			id={ chatDOMID(p, "chat-form") }
			class="chat-compose"
			action={ p.Action }
			method="post"
			hx-post={ p.HXPost }
			hx-swap="none"
			hx-on::after-request="this.reset()"
			data-chat-form
			data-upload-url={ p.UploadURL }
		>
			@chatComposerBody(p)
		</form>
	} else {
		<form
			id={ chatDOMID(p, "chat-form") }
			class="chat-compose mail-universal-compose"
			action={ p.Action }
			method="post"
			enctype="multipart/form-data"
			data-chat-form
		>
			@chatComposerBody(p)
		</form>
	}
}

templ chatComposerBody(p ChatComposerProps) {
	for _, hidden := range p.Hidden {
		<input type="hidden" name={ hidden.Name } value={ hidden.Value }/>
	}
	<textarea
		id={ chatDOMID(p, "chat-input") }
		data-chat-input
		name="prompt"
		rows="1"
		placeholder={ p.Placeholder }
		autocomplete="off"
		autofocus
	></textarea>
	<div class="chat-compose-row">
		<label class="chat-icon-circle" title="Attach files" aria-label="Attach files">
			@paperclipIcon()
			<input id={ chatDOMID(p, "chat-file") } data-chat-file name={ p.FileName } type="file" multiple hidden/>
		</label>
		<button type="button" id={ chatDOMID(p, "chat-snap") } data-chat-snap class="chat-icon-circle" title="Inspect a section of the page" aria-label="Inspect a section of the page">
			@crosshairIcon()
		</button>
		if p.StopAction != "" {
			<button type="button" class="chat-icon-circle" title="Stop chat" aria-label="Stop chat" hx-post={ p.StopAction } hx-swap="none">
				@stopIcon()
			</button>
		}
		<div id={ chatDOMID(p, "chat-attachments") } data-chat-attachments class="chat-attachments"></div>
		<button id={ chatDOMID(p, "chat-send") } data-chat-send class="mail-send-btn" type="submit" aria-label="Send">
			@sendIcon()
			<span>Send</span>
		</button>
	</div>
}

templ ChatMessages(p ChatThreadProps) {
	if len(p.Messages) == 0 {
		<p class="chat-empty">Say something to get started</p>
	}
	for _, m := range p.Messages {
		@ChatMessage(m)
	}
}

templ FloatingChatPanel(p FloatingChatProps) {
	<section
		id="floating-chat"
		class="floating-chat"
		data-chat-popout
		data-thread-id={ itoa64(p.ID) }
		data-empty={ strconv.FormatBool(len(p.Messages) == 0) }
		aria-label="Chat popout"
	>
		<header class="floating-chat-head">
			<div class="floating-chat-title">
				<span>{ p.Title }</span>
				if p.Description != "" {
					<small>{ p.Description }</small>
				}
			</div>
			<div class="floating-chat-actions">
				<button type="button" class="floating-chat-icon" data-chat-minimize title="Minimize" aria-label="Minimize chat">
					@minusIcon()
				</button>
				<button type="button" class="floating-chat-icon" data-chat-restore title="Restore floating chat" aria-label="Restore floating chat">
					@restoreIcon()
				</button>
				<button type="button" class="floating-chat-icon" data-chat-fullscreen title="Fullscreen" aria-label="Fullscreen chat">
					@fullscreenIcon()
				</button>
				<button type="button" class="floating-chat-icon" data-chat-close title="Close" aria-label="Close chat">
					@closeIcon()
				</button>
			</div>
		</header>
		<div hx-ext="sse" sse-connect={ "/chat/" + itoa64(p.ID) + "/events" } class="floating-chat-body" data-chat-scroller>
			<div id={ "floating-chat-" + itoa64(p.ID) + "-messages" } data-chat-messages class="chat-messages floating-chat-messages" sse-swap="message">
				@ChatMessages(ChatThreadProps{Agent: p.Agent, ID: p.ID, Messages: p.Messages, Title: p.Title})
			</div>
		</div>
		<footer class="floating-chat-compose">
			@ChatComposer(ChatComposerProps{
				Action:      "/chat/" + itoa64(p.ID) + "/messages",
				FileName:   "",
				HXPost:     "/chat/" + itoa64(p.ID) + "/messages",
				IDPrefix:    "floating-chat-" + itoa64(p.ID),
				Placeholder: "Message " + p.Agent + "...",
				StopAction:  "/chat/" + itoa64(p.ID) + "/stop",
				UploadURL:   "/chat/" + itoa64(p.ID) + "/attachments",
			})
		</footer>
	</section>
}

templ ChatMessage(m ChatMessageProps) {
	<div
		id={ "message-" + itoa64(m.ID) }
		class={ "chat-turn", "role-" + m.Role, "status-" + m.Status }
		sse-swap={ "message-" + itoa64(m.ID) }
		hx-swap="outerHTML"
	>
		if m.Role == "assistant" {
			for _, group := range chatPartGroups(m.Parts) {
				if group.Kind == "tools" {
					@chatToolGroup(m, group)
				} else {
					@chatPart(m, group.Part, group.Last)
				}
			}
			if m.Form != nil {
				@ChatForm(*m.Form)
			}
			if m.Status == "streaming" && m.Form == nil {
				<span class="chat-cursor"></span>
			}
		} else {
			@userBubble(m)
		}
	</div>
}

templ userBubble(m ChatMessageProps) {
	if len(m.Attachments) > 0 {
		<div class="chat-bubble-attachments">
			for _, a := range m.Attachments {
				<a class="chat-attachment-chip" href={ templ.SafeURL(attachmentURL(a)) } target="_blank">
					if a.IsImage {
						@imageIcon()
						<img class="chat-chip-preview" src={ attachmentURL(a) } alt={ a.Name } loading="lazy"/>
					} else {
						@paperclipIcon()
					}
					<span class="chat-chip-name">{ a.Name }</span>
				</a>
			}
		</div>
	}
	<div class="chat-bubble">{ m.Body }</div>
}

templ ChatTurn(role string) {
	<div class={ "chat-turn", "role-" + role }>
		{ children... }
	</div>
}

templ ChatAttachmentChip(a ChatAttachmentProps) {
	<span class="chat-attachment-chip" data-id={ itoa64(a.ID) }>
		<input type="hidden" name="attachment_id" value={ itoa64(a.ID) }/>
		if a.IsImage {
			@imageIcon()
			<img class="chat-chip-preview" src={ attachmentURL(a) } alt={ a.Name } loading="lazy"/>
		} else {
			@paperclipIcon()
		}
		<span class="chat-chip-name">{ a.Name }</span>
		<button type="button" class="chat-attachment-remove" data-id={ itoa64(a.ID) } aria-label={ "Remove " + a.Name }>×</button>
	</span>
}

templ imageIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="M21 15l-4.6-4.6a2 2 0 00-2.8 0L5 19"></path></svg>
}

templ ChatAccessToggle(threadID int64, access string) {
	<button
		type="button"
		class={ "chat-access-switch", templ.KV("on", access == "full") }
		role="switch"
		aria-checked={ strconv.FormatBool(access == "full") }
		hx-post={ "/chat/" + itoa64(threadID) + "/access" }
		hx-swap="outerHTML"
		title={ accessLabel(access) }
		aria-label={ accessLabel(access) }
	>
		<span class="chat-switch-icon">
			@boltIcon()
		</span>
		<span class="chat-switch-track">
			<span class="chat-switch-knob"></span>
		</span>
	</button>
}

templ paperclipIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"></path></svg>
}

templ boltIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
}

templ crosshairIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path></svg>
}

templ closeIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
}

templ fullscreenIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M21 16v3a2 2 0 0 1-2 2h-3"></path></svg>
}

templ minusIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14"></path></svg>
}

templ restoreIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14"></path></svg>
}

templ editIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
}

templ forkIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M18 9a9 9 0 0 1-12 0"></path><path d="M12 15V9"></path></svg>
}

templ chatPart(m ChatMessageProps, part ChatPartProps, last bool) {
	switch part.Kind {
		case "text":
			<div class="chat-md">
				@Markdown(part.Text)
			</div>
		case "thinking":
			@chatRow(chatRowProps{
				Detail:  part.Text,
				Key:     "m" + itoa64(m.ID) + "-thinking",
				Label:   "Thinking",
				Live:    last && m.Status == "streaming",
				Summary: part.Summary,
				Kind:    "thinking",
			})
		case "tool":
			@chatRow(chatRowProps{
				Detail:  part.Tool.Detail,
				Failed:  part.Tool.Status == "failed",
				Key:     "m" + itoa64(m.ID) + "-tool-" + part.Tool.ID,
				Kind:    "tool",
				Label:   part.Tool.Title,
				Live:    part.Tool.Status == "in_progress" || part.Tool.Status == "pending",
				Summary: part.Tool.Summary,
			})
		case "error":
			@chatRow(chatRowProps{
				Detail:  part.Text,
				Failed:  true,
				Key:     "m" + itoa64(m.ID) + "-error",
				Label:   "Error",
				Summary: part.Summary,
				Kind:    "error",
			})
		case "plan":
			<ul class="chat-plan">
				for _, entry := range part.Plan {
					<li class={ "chat-plan-entry", "plan-" + entry.Status }>
						<span class="chat-plan-icon">{ planStatusIcon(entry.Status) }</span>
						{ entry.Content }
					</li>
				}
			</ul>
	}
}

templ chatRow(r chatRowProps) {
	<details class={ "chat-row", "row-" + r.Kind, templ.KV("row-failed", r.Failed) } data-key={ r.Key }>
		<summary>
			if r.Live {
				<span class="chat-spinner"></span>
			} else {
				<span class="chat-row-icon">
					@rowIcon(r.Kind, r.Failed)
				</span>
			}
			if r.Shimmer || (r.Live && r.Kind == "thinking") {
				<span class="chat-row-label chat-shimmer">{ r.Label }</span>
			} else {
				<span class="chat-row-label">{ r.Label }</span>
			}
			if r.Summary != "" {
				<span class="chat-row-chip">{ r.Summary }</span>
			}
		</summary>
		if r.Detail != "" {
			<pre class="chat-row-detail">{ r.Detail }</pre>
		}
		{ children... }
	</details>
}

templ chatToolGroup(m ChatMessageProps, g chatPartGroup) {
	<details class={ "chat-row", "chat-tool-group", "row-tool", templ.KV("row-failed", chatToolGroupFailed(g.Tools)) } data-key={ "m" + itoa64(m.ID) + "-" + g.Key }>
		<summary>
			if chatToolGroupLive(g.Tools) {
				<span class="chat-spinner"></span>
			} else {
				<span class="chat-row-icon">
					@rowIcon("tool", chatToolGroupFailed(g.Tools))
				</span>
			}
			<span class="chat-row-label">{ chatToolGroupLabel(g.Tools) }</span>
			if g.Summary != "" {
				<span class="chat-row-chip">{ g.Summary }</span>
			}
		</summary>
		<div class="chat-tool-list">
			for _, part := range g.Tools {
				if part.Tool != nil {
					@chatRow(chatRowProps{
						Detail:  part.Tool.Detail,
						Failed:  part.Tool.Status == "failed",
						Key:     "m" + itoa64(m.ID) + "-tool-" + part.Tool.ID,
						Kind:    "tool",
						Label:   part.Tool.Title,
						Live:    part.Tool.Status == "in_progress" || part.Tool.Status == "pending",
						Summary: part.Tool.Summary,
					})
				}
			}
		</div>
	</details>
}

templ rowIcon(kind string, failed bool) {
	if failed {
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="6.2"></circle><path d="M5.8 5.8l4.4 4.4M10.2 5.8l-4.4 4.4"></path></svg>
	} else if kind == "thinking" {
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="6.2"></circle><path d="M8 1.8v12.4M1.8 8h12.4M3.6 3.6c2.6 2.6 6.2 2.6 8.8 0M3.6 12.4c2.6-2.6 6.2-2.6 8.8 0"></path></svg>
	} else {
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2.5 3.5l4 4-4 4M8.5 12h5"></path></svg>
	}
}

templ ChatForm(f ChatFormProps) {
	if f.Editable {
		<form class="chat-elicit chat-elicit-editable" method="post" action={ templ.SafeURL(f.Action) }>
			<input type="hidden" name="elicitation_id" value={ f.ElicitationID }/>
			@chatFormBody(f)
		</form>
	} else if f.Disabled {
		<div class="chat-elicit chat-elicit-filled">
			@chatFormBody(f)
		</div>
	} else if f.Plain {
		<form id="elicit-form" class="chat-elicit" method="post" action={ templ.SafeURL(f.Action) }>
			<input type="hidden" name="elicitation_id" value={ f.ElicitationID }/>
			@chatFormBody(f)
		</form>
	} else {
		<form id="elicit-form" class="chat-elicit" hx-post={ f.Action } hx-swap="none">
			<input type="hidden" name="elicitation_id" value={ f.ElicitationID }/>
			<input type="hidden" name="message_id" value={ itoa64(f.MessageID) }/>
			@chatFormBody(f)
		</form>
	}
}

templ chatFormBody(f ChatFormProps) {
	if !f.HideMessage {
		<p class="chat-elicit-message">{ f.Message }</p>
	}
	if f.Editable {
		<div class="chat-elicit-header">
			<div class="chat-elicit-actions">
				<button class="gm-icon-btn" type="button" title="Edit and re-run" aria-label="Edit and re-run" data-elicit-edit>
					@editIcon()
				</button>
				<button class="gm-icon-btn" formaction={ string(templ.SafeURL(f.ForkAction)) } formmethod="post" type="submit" formnovalidate title="Fork" aria-label="Fork" data-elicit-fork>
					@forkIcon()
				</button>
			</div>
		</div>
	}
	for _, field := range f.Fields {
		<label class="chat-elicit-field">
			<span>{ field.Label }</span>
			switch field.Type {
				case "select":
					<select name={ "f_" + field.Name } disabled?={ f.Disabled || f.Editable }>
						for _, option := range field.Options {
							<option value={ option } selected?={ option == field.Value }>{ option }</option>
						}
					</select>
				case "checkbox":
					<input type="checkbox" name={ "f_" + field.Name } checked?={ field.Value == "true" } disabled?={ f.Disabled || f.Editable }/>
				case "textarea":
					<textarea class="chat-elicit-textarea" name={ "f_" + field.Name } rows="8" required?={ field.Required } disabled?={ f.Disabled || f.Editable }>{ field.Value }</textarea>
				case "contact":
					@contactField(field, f.Disabled || f.Editable)
				default:
					<input
						type={ field.Type }
						name={ "f_" + field.Name }
						value={ field.Value }
						required?={ field.Required }
						disabled?={ f.Disabled || f.Editable }
					/>
			}
		</label>
	}
	if f.Editable {
		<div class="chat-elicit-edit-controls">
			<button name="action" value="accept" type="submit" data-elicit-submit>Submit</button>
			<button type="button" data-elicit-cancel>Cancel</button>
		</div>
	}
	if !f.Editable && !f.Disabled {
		<div class="chat-elicit-actions chat-elicit-decisions">
			<button id="elicit-decline" name="action" value="decline" type="submit" formnovalidate>{ declineLabel(f) }</button>
			<button id="elicit-accept" name="action" value="accept" type="submit">{ acceptLabel(f) }</button>
		</div>
	}
}
