package ui

templ chatHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title }</title>
		@InboxCSS()
		@ChatCSS()
		<script src="/static/htmx.min.js"></script>
		<script src="/static/htmx-ext-sse.min.js"></script>
		<script src="/static/chat.js" defer></script>
	</head>
}

templ ChatIndexPage(p ChatIndexProps) {
	<!DOCTYPE html>
	<html lang="en">
		@chatHead("chat")
		<body>
			<div class="chatapp">
				@InboxLayout("chat", 0, p.Chats) {
					@ChatListPane(p)
					<section class="inbox-detail-pane">
						<div class="inbox-empty">Select a thread or start a new chat.</div>
					</section>
				}
			</div>
		</body>
	</html>
}

templ ChatListPane(p ChatIndexProps) {
	<section class="inbox-list-pane">
		<header class="inbox-list-header">
			<h1>Chat</h1>
			<div class="chat-new-row">
				for i, agent := range p.Agents {
					<form action="/chat" method="post">
						<input type="hidden" name="agent" value={ agent }/>
						if i == 0 {
							<button id="new-thread" class="chat-new" type="submit">New chat</button>
						} else {
							<button id={ "new-thread-" + agent } class="chat-new chat-new-alt" type="submit">New { agent }</button>
						}
					</form>
				}
			</div>
		</header>
		@ChatThreadList(p.Threads, p.ActiveID)
	</section>
}

templ ChatThreadList(threads []ChatThreadItemProps, activeID int64) {
	if len(threads) == 0 {
		<p class="chat-empty">No chats yet</p>
	} else {
		<ul id="thread-list" class="inbox-list thread-list">
			for _, t := range threads {
				<li>
					<a href={ templ.SafeURL(chatPath(t.ID)) } class={ "inbox-row", templ.KV("active", t.ID == activeID) }>
						<span class="inbox-pill">{ t.Agent }</span>
						<span class="inbox-row-main">
							<span class="inbox-row-title">{ t.Title }</span>
							<span class="inbox-row-subtitle">Agent thread</span>
						</span>
						<span class="inbox-row-meta">{ t.When }</span>
					</a>
				</li>
			}
		</ul>
	}
}

templ ChatThreadPage(p ChatThreadProps) {
	<!DOCTYPE html>
	<html lang="en">
		@chatHead(p.Title)
		<body>
			<div class="chatapp">
				@InboxLayout("chat", 0, p.Chats) {
					@ChatListPane(ChatIndexProps{ActiveID: p.ID, Agents: p.Agents, Chats: p.Chats, Threads: p.Threads})
					<section class="inbox-detail-pane">
						<header class="inbox-detail-header">
							<a class="inbox-pill" href="/chat">Chat</a>
							<div class="inbox-detail-title">
								<h2 id="thread-heading">{ p.Title }</h2>
								<p><span id="thread-agent">{ p.Agent }</span></p>
							</div>
							<div class="chat-thread-actions">
								<button type="button" hx-patch={ chatPath(p.ID) } hx-vals='{"state":"resolved"}' hx-disabled-elt="this">Done</button>
								<button type="button" hx-patch={ chatPath(p.ID) } hx-vals='{"state":"archived"}' hx-disabled-elt="this">Archive</button>
							</div>
						</header>
						<div hx-ext="sse" sse-connect={ chatPath(p.ID) + "/events" } class="inbox-detail-pane">
							<div id="chat-messages" class="chat-messages" sse-swap="message">
								@ChatMessages(p)
							</div>
						</div>
						<form
							id="chat-form"
							class="chat-form"
							hx-post={ chatPath(p.ID) + "/messages" }
							hx-swap="none"
							hx-on::after-request="this.reset()"
						>
							<input
								id="chat-input"
								name="prompt"
								placeholder="Message the agent..."
								autocomplete="off"
								autofocus
							/>
							<button id="chat-send" type="submit">Send</button>
						</form>
					</section>
				}
			</div>
		</body>
	</html>
}

templ ChatMessages(p ChatThreadProps) {
	if len(p.Messages) == 0 {
		<p class="chat-empty">Say something to get started</p>
	}
	for _, m := range p.Messages {
		@chatMessage(m)
	}
}

templ chatMessage(m ChatMessageProps) {
	<div id={ "message-" + itoa64(m.ID) } class={ "chat-message", "role-" + m.Role, "status-" + m.Status }>
		<div class="chat-author">{ m.Author }</div>
		if len(m.Tools) > 0 {
			<details class="chat-tools">
				<summary>{ toolSummary(m.Tools) }</summary>
				for _, tool := range m.Tools {
					<span class="chat-tool">{ tool }</span>
				}
			</details>
		}
		<div class="chat-body">{ m.Body }</div>
		if m.Form != nil {
			@chatForm(*m.Form)
		}
		if m.Status == "streaming" && m.Form == nil {
			<span class="chat-cursor"></span>
		}
	</div>
}

templ chatForm(f ChatFormProps) {
	<form id="elicit-form" class="chat-elicit" hx-post={ f.Action } hx-swap="none">
		<input type="hidden" name="elicitation_id" value={ f.ElicitationID }/>
		<input type="hidden" name="message_id" value={ itoa64(f.MessageID) }/>
		<p class="chat-elicit-message">{ f.Message }</p>
		for _, field := range f.Fields {
			<label class="chat-elicit-field">
				<span>{ field.Label }</span>
				switch field.Type {
					case "select":
						<select name={ "f_" + field.Name }>
							for _, option := range field.Options {
								<option value={ option } selected?={ option == field.Value }>{ option }</option>
							}
						</select>
					case "checkbox":
						<input type="checkbox" name={ "f_" + field.Name } checked?={ field.Value == "true" }/>
					default:
						<input
							type={ field.Type }
							name={ "f_" + field.Name }
							value={ field.Value }
							required?={ field.Required }
						/>
				}
			</label>
		}
		<div class="chat-elicit-actions">
			<button id="elicit-accept" name="action" value="accept" type="submit">Accept</button>
			<button id="elicit-decline" name="action" value="decline" type="submit" formnovalidate>Decline</button>
		</div>
	</form>
}
