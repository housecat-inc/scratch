package copychip

import (
	"github.com/housecat-inc/scratch/ui/components/tooltip"
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

type Props struct {
	// After and Before render inside the button, hard against the value with
	// nothing between them and its first or last character. They are for a
	// caller that wants punctuation to travel with a text selection over the
	// chip without becoming part of what the button copies -- an address that
	// reads as <someone@example.com> when dragged across, while the button still
	// puts the bare address on the clipboard.
	After      templ.Component
	Attributes templ.Attributes
	Before     templ.Component
	Class      string
	// Tooltip is the label shown above the chip; "Copy" when unset. It is a
	// visual label only, so the button carries the same words in aria-label.
	Tooltip string
	// Value is both what the chip shows and what a click puts on the clipboard.
	Value string
}

// CopyChip is a small bordered button that shows a value and copies it when
// clicked. It is the only affordance for that value, so it stays on show at
// every width and on every kind of input; the check that stands in for the
// copy glyph for a moment afterwards is the feedback, so no toast is needed.
// Not one flex box anywhere between the chip's outside and its text, and this is
// not cosmetic. A flex container blockifies its items, and a selection dragged
// across blockified boxes is serialised with a newline between each one, so a
// chip built out of flex copies as a column: the address on one line, the glyph
// on the next, and an affix meant to read as `<someone@example.com>` split three
// ways. Inline-level boxes have no such boundary, so a chip and everything around
// it copy as one run of text -- which is what lets a contact lane reach the
// clipboard as an address list with no script rewriting it afterwards.
//
// The gaps flex used to draw are margins now, and the vertical centring flex used
// to do is align-middle. The tooltip wrapper needs no class for this: it renders
// display: contents, so it draws no box of its own for a selection to be broken
// across and leaves the chip to take part in whatever layout it sat in.
templ CopyChip(props Props) {
	{{ label := utils.IfElse(props.Tooltip != "", props.Tooltip, "Copy") }}
	@tooltip.Tooltip(tooltip.Props{Text: label}) {
		<button
			type="button"
			class={ utils.TwMerge("squircle-pill inline-block max-w-full cursor-pointer border border-border px-[0.6em] py-[0.25em] type-caption-100 leading-none text-muted-foreground squircle-pill-max-[calc(0.75em+1px)] group/copy-chip hover:bg-muted/50 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none", props.Class) }
			data-slot="copy-chip"
			data-copy-value={ props.Value }
			aria-label={ label + " " + props.Value }
			{ copyAttrs()... }
			{ props.Attributes... }
		>
			// Hard against each other, with no newline between any two of them: templ
			// renders whitespace between two nodes as one space, and a space here is
			// copied, so `<someone@example.com>` would paste with the brackets held
			// off the address.
			<span class="inline-block max-w-full min-w-0" data-slot="copy-chip-text">@utils.Adjacent(props.Before)<span class="inline-block max-w-full truncate align-bottom" data-slot="copy-chip-value">{ props.Value }</span>@utils.Adjacent(props.After)</span><span class="ml-1.5 inline-block align-middle group-hover/copy-chip:text-foreground group-data-[copied=true]/copy-chip:hidden" data-slot="copy-chip-glyph" aria-hidden="true">@icons.Render(icons.Copy, icons.Props{Size: 12})</span><span class="ml-1.5 hidden align-middle text-primary group-data-[copied=true]/copy-chip:inline-block" data-slot="copy-chip-copied" aria-hidden="true">@icons.Render(icons.Done, icons.Props{Size: 12})</span>
		</button>
	}
}

func copyAttrs() templ.Attributes {
	return templ.Attributes{"data-copy-chip": true}
}
