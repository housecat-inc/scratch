package linkchip

import "github.com/housecat-inc/scratch/ui/icons"

type In struct {
	Attributes templ.Attributes
	Context string
	Label string
	URL string
}

templ Chip(in In) {
	<span data-slot="link-chip-surface" class="squircle-pill inline-flex max-w-full border border-border bg-muted align-middle hover:bg-selected has-[>a:focus-visible]:outline-2 has-[>a:focus-visible]:outline-ring">
		<a { in.Attributes... } data-slot="link-chip" title={ in.URL } class="inline-flex max-w-full min-w-0 items-center gap-1 px-1.5 py-0.5 type-caption-100 text-primary outline-none">
			@icons.Render(icons.Mail, icons.Props{Class: "size-3 shrink-0"})
			<span class="min-w-0 truncate">{ in.Label }<span class="text-muted-foreground">{ chipContext(in.Context) }</span></span>
		</a>
	</span>
}

func chipContext(context string) string {
	if context == "" { return "" }
	return " · " + context
}
