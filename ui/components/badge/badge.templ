// Package badge is a short label beside the thing it describes. A status --
// a task's state, a run's outcome, Archived -- takes a Variant, which says
// what kind of status it is, and its colour follows from the theme's status
// tokens, so it reads the same in light and dark and on every page. A label
// whose colour means nothing by itself -- one someone picked, like a Gmail
// label's or a CRM status's -- takes a Background and a Foreground instead.
package badge

import (
	"context"
	"io"
	"slices"

	"github.com/cockroachdb/errors"

	"github.com/housecat-inc/scratch/ui/components/button"
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

type Variant string

const (
	// VariantNeutral is a state that needs no attention: Archived, Draft.
	VariantNeutral Variant = "neutral"
	// VariantInfo is something in motion: Running, Scheduled.
	VariantInfo Variant = "info"
	// VariantSuccess is done or healthy: Done, Active, Connected.
	VariantSuccess Variant = "success"
	// VariantWarning wants a look soon: Waiting, Paused, Expiring.
	VariantWarning Variant = "warning"
	// VariantDanger has gone wrong: Failed, Disconnected.
	VariantDanger Variant = "danger"
)

// Variants lists every variant, in the order the storybook shows them.
var Variants = []Variant{VariantNeutral, VariantInfo, VariantSuccess, VariantWarning, VariantDanger}

type Size string

const (
	// SizeDefault is 20px tall.
	SizeDefault Size = "default"
	// SizeSm is 18px tall, a mail row's label chip.
	SizeSm Size = "sm"
)

// Sizes lists every size, largest first.
var Sizes = []Size{SizeDefault, SizeSm}

type Props struct {
	// Attributes land on the link when the badge has an Href, else on the
	// badge. A data-slot among them replaces the badge's own.
	Attributes templ.Attributes
	// Background and Foreground paint the badge in colours that say nothing
	// by themselves, unlike a Variant's: red here is whatever the person who
	// picked it meant. Each is any CSS colour -- #1e53b8, rgb(30 83 184),
	// var(--tint-red) -- and goes into the badge's style as it is, so it has
	// to come from code or data the caller trusts. One left empty is the
	// neutral variant's. A badge with either takes no Variant.
	Background string
	// Class lands on the box the badge paints, which for a link is the
	// surface around it, so a width cap or a margin set here holds either way.
	Class      string
	Foreground string
	// Href makes the whole badge a link. Paint worklets do not run beneath a
	// link, so the pill is painted on a surface around it, as Button's is,
	// and the link is stretched over the surface.
	Href string
	// Icon draws before the label, 12px, in the badge's colour.
	Icon icons.Name
	// ID lands on the link when the badge has an Href, else on the badge.
	ID string
	// Logo is an image drawn before the label, after any Icon, 14px: a
	// company's logo. It is decoration, so the label has to name the thing.
	Logo string
	Size Size
	// Target is the link's target. A link that opens a new tab carries
	// rel="noopener", so the page it opens cannot reach back into this one.
	Target  string
	Variant Variant
}

// Badge is a pill of the variant's tint, or its own colours, with its label, and an
// icon or logo if given. Its children are the label. A label that may run
// long cuts itself: a width cap in Class, and a min-w-0 truncate span as the
// child, hold it to the cap with an ellipsis.
//
// A badge inside a link of its own, a row that links somewhere, cannot have
// its pill painted, so there it draws a native pill instead.
func Badge(p Props) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		if err := p.validate(); err != nil {
			return err
		}
		if p.Href != "" {
			return errors.Wrap(badgeLink(p).Render(ctx, w), "rendering linked badge")
		}
		return errors.Wrap(badgeBox(p).Render(ctx, w), "rendering badge")
	})
}

templ badgeBox(p Props) {
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Attributes["data-slot"] == nil {
			data-slot="badge"
		}
		{ p.dataAttributes()... }
		if s := p.style(); s != "" {
			style={ s }
		}
		class={ p.classes() }
		{ p.Attributes... }
	>
		@badgeContent(p) {
			{ children... }
		}
	</span>
}

// badgeLink is a linked badge: the surface paints the pill and the link,
// stretched over it, takes the pointer and the focus. The surface's ring
// shows the link's keyboard focus, as Button's does.
templ badgeLink(p Props) {
	<span
		data-slot="badge-surface"
		{ p.dataAttributes()... }
		if s := p.style(); s != "" {
			style={ s }
		}
		class={ p.classes() }
	>
		<a
			if p.ID != "" {
				id={ p.ID }
			}
			href={ templ.URL(p.Href) }
			if p.Target != "" {
				target={ p.Target }
			}
			if p.Target == "_blank" {
				rel="noopener"
			}
			class={ linkClass }
			if p.Attributes["data-slot"] == nil {
				data-slot="badge"
			}
			{ p.Attributes... }
		>
			@badgeContent(p) {
				{ children... }
			}
		</a>
	</span>
}

// linkClass stretches a badge's link over its surface. static holds the
// stretched area to the surface where a row lifts its links with position
// and z-index (uikit's mail row does), which would otherwise shrink it to
// the link's own box and leave the pill's padding dead. overflow-hidden
// keeps the label and glyphs inside the pill when a narrow row squeezes it;
// the stretched area's containing block is the surface, so it is not clipped.
const linkClass = button.StretchedControlClass + " static overflow-hidden"

// badgeContent is the glyphs and the label, as the badge or its link holds
// them. It is one child of whichever holds it, since whitespace between two
// children of a component's children block renders as a space.
templ badgeContent(p Props) {
	if p.Icon != "" {
		@icons.Render(p.Icon, icons.Props{Class: "shrink-0", Size: 12})
	}
	if p.Logo != "" {
		<img class="size-3.5 shrink-0 rounded-[4px] bg-white/70 object-cover" src={ p.Logo } alt=""/>
	}
	{ children... }
}

func (p Props) validate() error {
	if p.ownColors() && p.Variant != "" {
		return errors.Newf("badge has colours of its own and variant %q; a badge takes one", p.Variant)
	}
	if p.Size != "" && !slices.Contains(Sizes, p.Size) {
		return errors.Newf("badge size %q is not one of %v", p.Size, Sizes)
	}
	return nil
}

func (p Props) ownColors() bool {
	return p.Background != "" || p.Foreground != ""
}

// dataAttributes name what the props resolved to on the painted box: its
// size, and its variant for a badge without colours of its own.
func (p Props) dataAttributes() templ.Attributes {
	out := templ.Attributes{"data-size": string(p.size())}
	if !p.ownColors() {
		out["data-variant"] = string(variantOr(p.Variant))
	}
	return out
}

// style hands the badge's own colours to its classes as --badge-bg and
// --badge-fg, as they were given. templ's sanitizer would turn away any
// colour but a bare hex one, so they go through as trusted (see Props).
func (p Props) style() templ.SafeCSS {
	var out templ.SafeCSS
	if p.Background != "" {
		out += templ.SanitizeCSS("--badge-bg", templ.SafeCSSProperty(p.Background))
	}
	if p.Foreground != "" {
		out += templ.SanitizeCSS("--badge-fg", templ.SafeCSSProperty(p.Foreground))
	}
	return out
}

func (p Props) classes() string {
	return utils.TwMerge(
		"squircle-pill inline-flex shrink-0 items-center gap-1 type-caption-100-medium whitespace-nowrap",
		utils.IfElse(p.size() == SizeSm, "h-[18px] px-[7px]", "h-5 px-2"),
		p.linkClasses(),
		utils.IfElse(p.ownColors(), p.colorClass(), variantClass(p.Variant)),
		p.Class,
	)
}

// linkClasses are a linked badge's surface's hover and focus, or for a
// plain badge, the native pill it draws inside a link of its own.
func (p Props) linkClasses() string {
	if p.Href == "" {
		return "in-[:any-link]:rounded-full in-[:any-link]:bg-clip-border!"
	}
	return "relative isolate has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring " + p.hoverClass()
}

func (p Props) size() Size {
	if p.Size == "" {
		return SizeDefault
	}
	return p.Size
}

func (p Props) hoverClass() string {
	if p.Background != "" {
		return ownHoverClass
	}
	return variantHoverClass(p.Variant)
}

func variantOr(v Variant) Variant {
	if v == "" {
		return VariantNeutral
	}
	return v
}

func variantClass(v Variant) string {
	switch variantOr(v) {
	case VariantInfo:
		return "bg-info/12 text-info"
	case VariantSuccess:
		return "bg-success/12 text-success"
	case VariantWarning:
		return "bg-warning/15 text-warning"
	case VariantDanger:
		return "bg-destructive/10 text-destructive"
	default:
		return "bg-muted text-muted-foreground"
	}
}

// variantHoverClass deepens a linked badge's tint under the pointer. Each
// arm is a literal so Tailwind's scanner finds it.
func variantHoverClass(v Variant) string {
	switch variantOr(v) {
	case VariantInfo:
		return "hover:bg-info/20"
	case VariantSuccess:
		return "hover:bg-success/20"
	case VariantWarning:
		return "hover:bg-warning/24"
	case VariantDanger:
		return "hover:bg-destructive/16"
	default:
		return "hover:bg-secondary-hover"
	}
}

// colorClass paints the badge's own colours, the neutral variant's where
// it has none of one.
func (p Props) colorClass() string {
	return utils.IfElse(p.Background != "", "bg-(--badge-bg)", "bg-muted") + " " +
		utils.IfElse(p.Foreground != "", "text-(--badge-fg)", "text-muted-foreground")
}

// ownHoverClass deepens a linked badge's own background under the pointer,
// a tenth of the way to its text's colour, whatever the two are.
const ownHoverClass = "hover:bg-[color-mix(in_oklab,var(--badge-bg),currentColor_10%)]"
