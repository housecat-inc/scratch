// Package radio is a radio button: the native input drawn as the kit's round
// box, or visually hidden for a label that draws its state.
package radio

import "github.com/housecat-inc/scratch/ui/utils"

type Props struct {
	Attributes templ.Attributes
	// Bare draws no box and hides the input visually, keeping it focusable
	// and in the arrow-key group, for a label that shows the choice itself.
	Bare     bool
	Checked  bool
	Class    string
	Disabled bool
	// Form is the id of the form the radio belongs to, for one outside it.
	Form string
	ID   string
	// Label names a radio whose only text is in its label's picture.
	Label string
	Name  string
	Value string
}

templ Radio(p Props) {
	if p.Bare {
		@input(p, "sr-only")
	} else {
		<span data-slot="radio" class={ utils.TwMerge("relative inline-flex shrink-0 items-center", p.Class) }>
			@input(p, "relative size-4 shrink-0 cursor-pointer appearance-none rounded-full border border-input bg-background shadow-xs transition-shadow outline-none peer checked:border-primary checked:bg-primary focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-input/30 dark:checked:bg-primary")
			<span aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 peer-checked:opacity-100">
				<span class="size-1.5 rounded-full bg-primary-foreground"></span>
			</span>
		</span>
	}
}

templ input(p Props, class string) {
	<input
		type="radio"
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		value={ p.Value }
		if p.Form != "" {
			form={ p.Form }
		}
		if p.Label != "" {
			aria-label={ p.Label }
		}
		checked?={ p.Checked }
		disabled?={ p.Disabled }
		data-slot="radio-control"
		class={ class }
		{ p.Attributes... }
	/>
}
