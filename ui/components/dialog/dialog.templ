// Based on the templUI v1.5.0 dialog anatomy used by app/ui/components/dialog.
// Native showModal() puts the content and backdrop in the browser top layer;
// the shared key router orders dismissal with popovers opened inside it.
package dialog

import (
	"context"

	"github.com/housecat-inc/scratch/ui/components/button"
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

type contextKey struct{}

type Props struct {
	Alert      bool
	Attributes templ.Attributes
	Class      string
	ID         string
	// Open shows the dialog as a modal as soon as it is in the document, for
	// one the server draws in answer to a request, such as a dialog htmx
	// swaps in (dialog.ts).
	Open       bool
}

type FooterProps struct {
	Attributes templ.Attributes
	Class      string
	ID         string
}

const FooterClass = "flex flex-col-reverse gap-2 sm:flex-row sm:justify-end [&_[data-slot=button-surface]]:button-size-default"

type ContentProps struct {
	Class           string
	HideCloseButton bool
}

type TriggerProps struct {
	For string
}

func idFrom(ctx context.Context) string {
	p, _ := ctx.Value(contextKey{}).(Props)
	return p.ID
}

templ Dialog(p Props) {
	{{ id := p.ID }}
	if id == "" {
		{{ id = utils.RandomID() }}
	}
	{{ p.ID = id }}
	{{ ctx = context.WithValue(ctx, contextKey{}, p) }}
	<dialog id={ id } role={ utils.IfElse(p.Alert, "alertdialog", "dialog") } aria-labelledby={ id+"-title" } data-slot="dialog" data-alert?={ p.Alert } data-open-on-insert?={ p.Open } class={ utils.TwMerge("m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-lg overflow-y-auto overscroll-contain rounded-lg border border-border scrim-dialog bg-background p-0 text-foreground shadow-lg", p.Class) } { p.Attributes... }>
		{ children... }
	</dialog>
}

templ Trigger(p TriggerProps) {
	<span class="contents" data-slot="dialog-trigger" data-dialog-target={ p.For }>{ children... }</span>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ hideCloseButton := p.HideCloseButton }}
	<div data-slot="dialog-content" class={ utils.TwMerge("relative grid gap-4 p-6", p.Class) }>
		{ children... }
		if p, _ := ctx.Value(contextKey{}).(Props); !p.Alert && !hideCloseButton {
			<div class="absolute top-3 right-3">
				@Close() {
					@button.ButtonIcon(button.IconProps{Icon: icons.Close, Size: button.IconSizeSm, Tooltip: "Close dialog"})
				}
			</div>
		}
	</div>
}

// Header pads its end clear of Content's close button, which stands 12px in
// from the corner: 16px past its 28px box (pr-8), and past the 44px it grows
// to on a touch screen below docked (pr-12).
templ Header() {
	<div data-slot="dialog-header" class="flex flex-col gap-2 pr-8 max-docked:pr-12">{ children... }</div>
}

templ Title() {
	<h2 id={ idFrom(ctx)+"-title" } data-slot="dialog-title" class="type-title-200">{ children... }</h2>
}

templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" { id={ p.ID } }
		data-slot="dialog-footer" class={ utils.TwMerge(FooterClass, p.Class) } { p.Attributes... }>{ children... }</div>
}

templ AlertDialog(p Props) {
	{{ p.Alert = true }}
	@Dialog(p) { { children... } }
}

templ Description() {
	<p id={ idFrom(ctx)+"-description" } data-slot="dialog-description" class="type-body-200 text-muted-foreground">{ children... }</p>
}

templ Close() {
	<span class="contents" data-slot="dialog-close">{ children... }</span>
}
