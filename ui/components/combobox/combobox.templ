package combobox

import (
	"bytes"
	"context"
	"io"

	"github.com/cockroachdb/errors"

	"github.com/housecat-inc/scratch/ui/components/button"
	"github.com/housecat-inc/scratch/ui/components/control"
	"github.com/housecat-inc/scratch/ui/components/listbox"
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

type RootProps struct {
	// Anchor is the id of the element the popup is placed against, and hands
	// focus back to, while the trigger has no box: a trigger hidden at this
	// width, with another control -- an item in a "More actions" menu --
	// opening the popup in its place. Empty, or while the trigger shows, it
	// is the trigger.
	Anchor     string
	Attributes templ.Attributes
	Class      string
	// Grid lays the options out in rows, so the arrow keys move along a row
	// (Left, Right) as well as down the rows (Up, Down), and Space chooses
	// while the input is empty.
	Grid bool
	// ID ties every part together. Unset, it is the field's id with
	// "-combobox" when the combobox is its field.Field's control, so the
	// markup is the same each render, and random otherwise.
	ID string
	// Items lets TriggerField name the chosen options; the list itself is the
	// Items rendered inside List.
	Items []Entry
	// Label is the combobox's one name: the trigger's, the popup's and the
	// list's, and TriggerIcon's tooltip. It is required: an empty Label
	// renders an empty aria-label, and the combobox has no accessible name.
	Label    string
	Multiple bool
	// Name is the form field the selection submits as: one hidden input per
	// chosen value when Multiple, exactly one otherwise. Empty means no
	// inputs.
	Name string
	// Remote leaves the options to the server: typing filters nothing here,
	// and the page replaces the List's content, after which the cursor is set
	// again. The page names the request on the input and the List.
	Remote bool
	// Required uses a validation input to block empty submissions and opens
	// the search popup on invalid submission. The enclosing field's Required
	// is inherited by its first control.
	Required bool
	// Value is the chosen values; Items whose Value is in it start selected.
	// A single combobox keeps only the first.
	Value []string
}

// Root holds the form values and renders no box of its own, so the trigger
// lays out as a child of whatever holds the Root.
func Root(props RootProps) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		r := newRoot(ctx, props)
		inner := context.WithValue(templ.ClearChildren(ctx), rootKey, r)
		var body bytes.Buffer
		if err := templ.GetChildren(ctx).Render(inner, &body); err != nil {
			return errors.Wrap(err, "render combobox control")
		}
		return rootBox(props, r, templ.Raw(body.String())).Render(inner, w)
	})
}

// Scope renders its children with a Root's context and no box, for the options
// a server renders on their own into a List: they get the ids and the selected
// state the Root with the same ID and Value gives them.
func Scope(props RootProps) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		inner := context.WithValue(templ.ClearChildren(ctx), rootKey, newRoot(ctx, props))
		return templ.GetChildren(ctx).Render(inner, w)
	})
}

templ rootBox(props RootProps, r root, body templ.Component) {
	{{ required := r.required }}
	{{ value := r.value }}
	<div
		class={ utils.TwMerge("contents", utils.If(required, "relative block"), props.Class) }
		data-slot="combobox"
		if props.Anchor != "" {
			data-anchor={ props.Anchor }
		}
		data-grid?={ props.Grid }
		data-remote?={ props.Remote }
		if props.Multiple {
			data-multiple
		}
		if props.Name != "" {
			data-name={ props.Name }
		}
		{ props.Attributes... }
	>
		if props.Name != "" {
			if props.Multiple {
				for _, v := range value {
					<input type="hidden" name={ props.Name } value={ v } disabled?={ *r.disabled } data-slot="combobox-form-value"/>
				}
			} else {
				<input type="hidden" name={ props.Name } value={ firstOr(value) } disabled?={ *r.disabled } data-slot="combobox-form-value"/>
			}
		}
		if required {
			@control.RequiredProxy(control.RequiredProps{Disabled: *r.disabled, ID: r.id + "-required", Slot: "combobox-required", Value: firstOr(value)})
		}
		@body
	</div>
}

func firstOr(values []string) string {
	if len(values) == 0 {
		return ""
	}
	return values[0]
}

type TriggerProps struct {
	Attributes templ.Attributes
	Class      string
}

// Trigger is the unstyled trigger: a button carrying TriggerAttributes, with
// the caller's children and class. TriggerField and TriggerIcon are the
// styled defaults on top of it.
templ Trigger(props TriggerProps) {
	{{ triggerDisabled(ctx, props.Attributes, false) }}
	@button.ButtonUnstyled(button.ButtonUnstyledProps{Attributes: utils.MergeAttributes(TriggerAttributes(ctx), props.Attributes), Class: props.Class}) {
		{ children... }
	}
}

type TriggerFieldProps struct {
	Attributes  templ.Attributes
	Class       string
	Look        Look
	Placeholder string
	Size        Size
}

// TriggerField is selectbox's field trigger: the chosen labels, or
// Placeholder, and a chevron. combobox.ts rewrites the value as the
// selection changes.
templ TriggerField(props TriggerFieldProps) {
	{{ r := rootFrom(ctx) }}
	@FieldTrigger(props) {
		<span class="min-w-0 truncate" data-slot="combobox-value" data-placeholder={ props.Placeholder }>{ r.valueText(props.Placeholder) }</span>
	}
}

// FieldTrigger is TriggerField's box and chevron around the caller's children,
// for a value that is more than text, such as an icon the page keeps in step
// with the selection. Class sets its width: it spans its container otherwise.
templ FieldTrigger(props TriggerFieldProps) {
	@Trigger(TriggerProps{Attributes: utils.MergeAttributes(templ.Attributes{"data-size": props.Size.Name()}, props.Attributes), Class: listbox.FieldTriggerClass(props.Size, props.Look, props.Class)}) {
		{ children... }
		<span aria-hidden="true" class={ listbox.FieldChevronClass(props.Look) }>
			@icons.Render(icons.ExpandAll, icons.Props{Size: props.Size.Chevron()})
		</span>
	}
}

// TriggerIcon is the kit's icon button as the trigger: the toolbar look and
// tooltip, with Root's Label as the tooltip and name. States are dropped,
// since a stateful icon button replaces its aria-label and would strip the
// combobox's name.
templ TriggerIcon(props button.IconProps) {
	{{ triggerDisabled(ctx, props.Attributes, props.Disabled) }}
	{{ props.States = nil }}
	{{ props.State = "" }}
	{{ props.Tooltip = rootFrom(ctx).label }}
	{{ props.Attributes = utils.MergeAttributes(TriggerAttributes(ctx), props.Attributes) }}
	@button.ButtonIcon(props)
}

type PositionerProps struct {
	Align      Align
	Attributes templ.Attributes
	Class      string
	Side       Side
	SideOffset int
}

// Positioner is listbox.Positioner under the combobox's slot and id.
templ Positioner(props PositionerProps) {
	{{ r := rootFrom(ctx) }}
	@listbox.Positioner(listbox.PositionerProps{
		Align:      props.Align,
		Attributes: props.Attributes,
		Class:      props.Class,
		ID:         r.positionerID(),
		Side:       props.Side,
		SideOffset: props.SideOffset,
		Slot:       "combobox-positioner",
	}) {
		{ children... }
	}
}

type PopupProps struct {
	Attributes templ.Attributes
	Class      string
}

// Popup is the dialog the trigger opens, painted like the app's menus. It is
// at least 16rem wide, or the trigger's width if wider, since an icon trigger
// is narrower than any useful list. It does not scroll: List does, so the
// input stays in view.
templ Popup(props PopupProps) {
	{{ r := rootFrom(ctx) }}
	<div
		id={ r.popupID() }
		role="dialog"
		aria-label={ r.label }
		class={ utils.TwMerge(listbox.PopupSurfaceClass, "flex min-w-[max(16rem,var(--anchor-width))] flex-col", props.Class) }
		data-slot="combobox-popup"
		{ props.Attributes... }
	>
		if r.required {
			@control.RequiredError(r.id + "-validation-error")
		}
		{ children... }
	</div>
}

type InputProps struct {
	Attributes templ.Attributes
	Class      string
	// Label names the input where "Search icons" says more than Root's Label,
	// which is the combobox's name; unset, it is Root's Label.
	Label       string
	Placeholder string
}

// Input is the search field, the combobox the list belongs to. It exists
// only inside the open popup, so it is always expanded. Its corners are the
// popup's minus the popup's border and padding, so they sit snugly inside.
templ Input(props InputProps) {
	{{ r := rootFrom(ctx) }}
	{{ label := utils.IfElse(props.Label != "", props.Label, r.label) }}
	<input
		type="text"
		id={ r.inputID() }
		role="combobox"
		aria-autocomplete="list"
		aria-controls={ r.listID() }
		aria-expanded="true"
		aria-label={ label }
		autocomplete="off"
		spellcheck="false"
		placeholder={ props.Placeholder }
		class={ utils.TwMerge("mb-1 w-full squircle-[calc(var(--radius-md)-5px)] border bg-background px-2 py-1 type-body-200 outline-none focus-visible:ring-2 focus-visible:ring-ring", props.Class) }
		form=""
		data-slot="combobox-input"
		{ props.Attributes... }
	/>
}

type ListProps struct {
	Attributes templ.Attributes
	Class      string
}

// List is the listbox, and the part of the popup that scrolls.
templ List(props ListProps) {
	{{ r := rootFrom(ctx) }}
	<div
		id={ r.listID() }
		role="listbox"
		aria-label={ r.label }
		if r.multiple {
			aria-multiselectable="true"
		}
		class={ utils.TwMerge(listbox.PopupScrollClass, props.Class) }
		data-slot="combobox-list"
		{ props.Attributes... }
	>
		{ children... }
	</div>
}

type ItemProps struct {
	Attributes templ.Attributes
	Class      string
	// Description is secondary text under the label.
	Description string
	// Group is the Value of the Group the option belongs under. It is how
	// insertItem files an option rendered alone into its group; an Item
	// rendered inside a Group should carry that Group's Value too.
	Group string
	// Indicator is how the option shows it is selected: IndicatorCheck, the
	// default, a check on the right; IndicatorCheckbox a checkbox on the
	// left, empty until the option is selected. Either is drawn from the
	// option's data-selected and hidden from assistive technology, since
	// aria-selected already says it.
	Indicator Indicator
	// Label is the option's text, what the filter matches and what keeps
	// the list in label order.
	Label string
	// Value identifies the option in Root's Value, the events and the form.
	// It is part of the option's element id, so it must be id-safe: no
	// whitespace.
	Value string
}

// Item is one option, selected when its Value is in Root's Value.
templ Item(props ItemProps) {
	{{ r := rootFrom(ctx) }}
	{{ selected := r.selected(props.Value) }}
	<div
		id={ r.itemID(props.Value) }
		role="option"
		aria-selected={ utils.IfElse(selected, "true", "false") }
		class={ utils.TwMerge(listbox.ItemClass, utils.IfElse(props.Indicator == IndicatorCheckbox, ItemCheckboxRowClass, ""), utils.IfElse(props.Indicator == IndicatorRing, ItemRingClass, ""), props.Class) }
		if props.Indicator == IndicatorRing {
			aria-label={ props.Label }
		}
		data-slot="combobox-item"
		data-value={ props.Value }
		data-label={ props.Label }
		if props.Group != "" {
			data-group={ props.Group }
		}
		data-selected?={ selected }
		{ props.Attributes... }
	>
		if props.Indicator == IndicatorRing {
			{ children... }
		} else {
			if props.Indicator == IndicatorCheckbox {
				<span aria-hidden="true" class={ ItemCheckboxClass } data-slot="combobox-item-checkbox">
					@icons.Render(icons.Done, icons.Props{Class: ItemCheckIconClass, Size: 12})
				</span>
			}
			<span class={ listbox.ItemTextClass } data-slot="combobox-item-text">{ props.Label }</span>
			if props.Description != "" {
				<span class={ listbox.ItemDescriptionClass } data-slot="combobox-item-description">{ props.Description }</span>
			}
			if props.Indicator != IndicatorCheckbox {
				@listbox.ItemIndicator(listbox.ItemIndicatorProps{Slot: "combobox-item-indicator"})
			}
		}
	</div>
}

type GroupProps struct {
	Attributes templ.Attributes
	Class      string
	// Label is the heading drawn above the group's options and its name.
	Label string
	// Value identifies the group to the Items that go under it, their Group.
	// It is part of the heading's element id, so it must be id-safe.
	Value string
}

// Group goes inside List and holds a run of options under a heading. It
// hides itself, heading and all, while it has no option showing: when the
// filter hides every option in it, or it has none yet. A page renders every
// group it may file into, empty or not, so insertItem has somewhere to put
// an option for an empty one.
templ Group(props GroupProps) {
	{{ r := rootFrom(ctx) }}
	<div
		role="group"
		aria-labelledby={ r.groupLabelID(props.Value) }
		class={ utils.TwMerge(GroupClass, props.Class) }
		data-slot="combobox-group"
		data-group={ props.Value }
		{ props.Attributes... }
	>
		<div id={ r.groupLabelID(props.Value) } class={ GroupLabelClass } data-slot="combobox-group-label">{ props.Label }</div>
		{ children... }
	</div>
}

type EmptyProps struct {
	Attributes templ.Attributes
	Class      string
}

// Empty is what shows when the filter leaves no option; combobox.ts shows and
// hides it.
templ Empty(props EmptyProps) {
	<div class={ utils.TwMerge(EmptyClass, props.Class) } data-slot="combobox-empty" hidden { props.Attributes... }>{ children... }</div>
}

type CreateItemProps struct {
	Attributes templ.Attributes
	Class      string
}

// CreateItem goes last inside List, so the input's aria-activedescendant
// always names an option of the listbox it controls. It is the option to
// create what was typed, shown when no option is called exactly that. It is
// an option like any other, so the keys reach it; choosing it fires
// combobox:create rather than changing the selection.
templ CreateItem(props CreateItemProps) {
	{{ r := rootFrom(ctx) }}
	<div
		id={ r.createID() }
		role="option"
		aria-selected="false"
		class={ utils.TwMerge(listbox.ItemClass, "flex-row items-center gap-2", props.Class) }
		data-slot="combobox-create"
		hidden
		{ props.Attributes... }
	>
		@icons.Render(icons.Add, icons.Props{Size: 14})
		<span class={ listbox.ItemTextClass }>Create "<span data-slot="combobox-create-query"></span>"</span>
	</div>
}
