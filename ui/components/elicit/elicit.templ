package elicit

import (
	"github.com/housecat-inc/scratch/ui/components/checkbox"
	"github.com/housecat-inc/scratch/ui/components/field"
	"github.com/housecat-inc/scratch/ui/components/textarea"
)

// Fields are a workflow's settings as form fields: a checkbox per boolean
// control, each with the hidden marker that says it is one, and the JSON
// editor for the rest. The caller holds them in its form and section, and
// shows something else when data is not Configurable.
templ Fields(data FormData) {
	for _, setting := range data.Checkboxes {
		<input type="hidden" name={ "setting_type." + setting.Key } value="bool"/>
		@field.Inline(field.Props{Error: data.Errors["setting."+setting.Key], ID: "setting-" + setting.Key, Label: setting.Label}) {
			@checkbox.Checkbox(checkbox.Props{Checked: setting.Checked, Name: "setting." + setting.Key, Value: "true"})
		}
	}
	if data.HasJSON {
		@field.Field(field.Props{Error: data.Errors["settings_json"], ID: "settings-json", Label: data.JSONLabel}) {
			@textarea.Textarea(textarea.Props{Attributes: templ.Attributes{"data-json-editor": true}, Class: "whitespace-pre", Mono: true, Name: "settings_json", Rows: 16, Value: data.SettingsJSON})
		}
	}
}
