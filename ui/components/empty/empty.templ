// Package empty is what a page or a list shows when it has nothing in it yet:
// an icon, what is missing, a line on how to get some, and the action that
// does. Default fills a page's content; Compact sits inside a list or a
// section, where a page-sized hole would be out of scale.
package empty

import (
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

type Size string

const (
	SizeDefault Size = "default"
	SizeCompact Size = "compact"
)

type Props struct {
	// Action is what fills the hole, such as a button that creates the first
	// item. It sits under the text.
	Action      templ.Component
	Attributes  templ.Attributes
	Class       string
	Description string
	// Icon is drawn above the text in a muted disc; a compact empty state
	// leaves it out.
	Icon  icons.Name
	ID    string
	Size  Size
	Title string
}

// Empty centres its text, and its action under it, in the space it is given.
templ Empty(p Props) {
	{{ compact := p.Size == SizeCompact }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty"
		data-size={ string(utils.IfElse(compact, SizeCompact, SizeDefault)) }
		class={ utils.TwMerge("flex flex-col items-center justify-center text-center", utils.IfElse(compact, "gap-2 px-4 py-6", "gap-3 px-6 py-12"), p.Class) }
		{ p.Attributes... }
	>
		if p.Icon != "" && !compact {
			<span data-slot="empty-icon" aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-muted text-muted-foreground">
				@icons.Render(p.Icon, icons.Props{Size: 20})
			</span>
		}
		<div class="flex max-w-sm flex-col gap-1">
			if p.Title != "" {
				<p data-slot="empty-title" class="type-body-200-medium text-foreground">{ p.Title }</p>
			}
			if p.Description != "" {
				<p data-slot="empty-description" class="type-body-200 text-muted-foreground">{ p.Description }</p>
			}
		</div>
		if p.Action != nil {
			<div data-slot="empty-action" class="mt-1 flex flex-wrap items-center justify-center gap-2">
				@p.Action
			</div>
		}
	</div>
}
