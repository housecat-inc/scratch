// Package field is a form's fields: Field puts a label over one control and
// its help and error under it, and Inline puts the label beside the control,
// for a checkbox. The controls are packages of their own -- input, textarea,
// checkbox, selectbox (whose Select is a form's usual select) and combobox --
// as Base UI's Checkbox, Select and Input are apart from its Field, and every
// one but checkbox draws control.Class's box, so the fields on a page line up.
//
// The control in a field wears the field's id unless it has its own, and the
// label points at whichever it wears. The field's help and error describe the
// control, and an error marks it invalid, so a screen reader reads them with
// it. Base UI's Field works the same way: Root hands its control the ids
// through context.
package field

import (
	"bytes"
	"context"
	"io"
	"strings"

	"github.com/cockroachdb/errors"

	"github.com/housecat-inc/scratch/ui/components/control"
	"github.com/housecat-inc/scratch/ui/utils"
)

// ControlClass is control.Class with control.Text, for a caller drawing its
// own control.
const ControlClass = control.Class + " " + control.Text

type Props struct {
	Attributes templ.Attributes
	Class      string
	// Error says what is wrong with the value. It shows under the control in
	// the destructive colour and marks the control aria-invalid.
	Error string
	// Help says what to enter, under the control.
	Help string
	// ID is the field's; its control wears it unless the control has an id of
	// its own. Random when unset.
	ID    string
	Label string
	// Required makes the control required.
	Required bool
}

// Field is a label, its control, then the control's help and error. Its
// children are the control. They render before the label, whose for= is the
// id the control chose to wear.
func Field(p Props) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		id := control.IDOr(p.ID)
		f := &control.Field{DescribedBy: describedBy(id, p), ID: id, Invalid: p.Error != "", Required: p.Required}
		if p.Label != "" {
			f.LabelID = id + "-label"
		}
		inner := templ.ClearChildren(ctx)
		var body bytes.Buffer
		if err := templ.GetChildren(ctx).Render(control.With(inner, f), &body); err != nil {
			return errors.Wrap(err, "render field control")
		}
		return fieldBox(p, f, templ.Raw(body.String())).Render(inner, w)
	})
}

templ fieldBox(p Props, f *control.Field, body templ.Component) {
	<div data-slot="field" class={ utils.TwMerge("flex min-w-0 flex-col gap-1.5", p.Class) } { p.Attributes... }>
		if p.Label != "" {
			<label id={ f.LabelID } for={ f.ControlID() } data-slot="field-label" class="type-body-200-medium text-foreground">{ p.Label }</label>
		}
		@body
		if p.Help != "" {
			<p id={ f.ID + "-help" } data-slot="field-help" class="type-caption-100 text-muted-foreground">{ p.Help }</p>
		}
		if p.Error != "" {
			<p id={ f.ID + "-error" } data-slot="field-error" class="type-caption-100 text-destructive">{ p.Error }</p>
		}
	</div>
}

func describedBy(id string, p Props) string {
	var ids []string
	if p.Help != "" {
		ids = append(ids, id+"-help")
	}
	if p.Error != "" {
		ids = append(ids, id+"-error")
	}
	return strings.Join(ids, " ")
}

type RowProps struct {
	Attributes templ.Attributes
	Class      string
}

// Row sets fields side by side, two to a row once there is room for them,
// such as a first name beside a last.
templ Row(props ...RowProps) {
	{{ var p RowProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div data-slot="field-row" class={ utils.TwMerge("grid gap-4 sm:grid-cols-2", p.Class) } { p.Attributes... }>
		{ children... }
	</div>
}

// Inline is a field whose label sits beside its control rather than over it,
// for a checkbox: the control first, then the label and, under it, the help
// and error. The whole row is the label, so a click anywhere on it toggles
// the control. Like Field, its children are the control, which wears the
// field's id and is described by its help and error.
func Inline(p Props) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		id := control.IDOr(p.ID)
		f := &control.Field{DescribedBy: describedBy(id, p), ID: id, Invalid: p.Error != "", Required: p.Required}
		inner := templ.ClearChildren(ctx)
		var body bytes.Buffer
		if err := templ.GetChildren(ctx).Render(control.With(inner, f), &body); err != nil {
			return errors.Wrap(err, "render inline field control")
		}
		return inlineBox(p, f, templ.Raw(body.String())).Render(inner, w)
	})
}

templ inlineBox(p Props, f *control.Field, body templ.Component) {
	<label data-slot="field" data-layout="inline" class={ utils.TwMerge("flex min-w-0 cursor-pointer items-start gap-3 has-disabled:cursor-not-allowed has-disabled:opacity-50", p.Class) } { p.Attributes... }>
		<span class="flex h-5 shrink-0 items-center">
			@body
		</span>
		<span class="flex min-w-0 flex-col gap-0.5">
			<span data-slot="field-label" class="type-body-200 text-foreground">{ p.Label }</span>
			if p.Help != "" {
				<span id={ f.ID + "-help" } data-slot="field-help" class="type-caption-100 text-muted-foreground">{ p.Help }</span>
			}
			if p.Error != "" {
				<span id={ f.ID + "-error" } data-slot="field-error" class="type-caption-100 text-destructive">{ p.Error }</span>
			}
		</span>
	</label>
}
