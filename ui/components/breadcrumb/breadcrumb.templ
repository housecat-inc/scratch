package breadcrumb

import (
	"github.com/housecat-inc/scratch/ui/components/selectbox"
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

// textTrimClass trims a text box to the span from its cap height to its
// baseline, so centring it in the trail centres it on its capitals and the
// separator chevron, a cap tall, lines up with them. A browser without
// text-box ignores it and centres on the line box instead.
const textTrimClass = "[text-box:trim-both_cap_alphabetic]"

type RootProps struct {
	Attributes templ.Attributes
	Class      string
	// Label names the navigation landmark; "Breadcrumb" when empty.
	Label string
}

// Root is the trail's landmark and the container its collapse is measured
// against. It is one line and may shrink to nothing, so a caller lays it out
// as a flex child with room to give.
templ Root(props RootProps) {
	<nav
		aria-label={ utils.IfElse(props.Label != "", props.Label, "Breadcrumb") }
		class={ utils.TwMerge("@container/breadcrumb flex min-w-0 items-center", props.Class) }
		data-slot="breadcrumb"
		{ props.Attributes... }
	>
		{ children... }
	</nav>
}

type ListProps struct {
	Attributes templ.Attributes
	Class      string
}

// List is the ordered trail, one line.
templ List(props ListProps) {
	<ol class={ utils.TwMerge("flex min-w-0 flex-1 items-center gap-1.5 whitespace-nowrap", props.Class) } data-slot="breadcrumb-list" { props.Attributes... }>
		{ children... }
	</ol>
}

type ItemProps struct {
	Attributes templ.Attributes
	Class      string
	// Collapse lets the item leave a narrow trail, the separator after it
	// too, for an Ellipsis to stand in for.
	Collapse bool
	// Pinned keeps the item whole however narrow the trail.
	Pinned bool
}

// Item is one crumb. It truncates to at least one character as the trail
// narrows; the last item truncates first, the current page's name being the
// one a reader can best spare.
templ Item(props ItemProps) {
	<li class={ itemClass(props) } data-slot="breadcrumb-item" { props.Attributes... }>
		{ children... }
	</li>
}

func itemClass(props ItemProps) string {
	c := "min-w-[1em] shrink overflow-x-clip text-ellipsis whitespace-nowrap last:min-w-16 last:shrink-[100] " + textTrimClass
	if props.Pinned {
		c = "inline-flex shrink-0 items-center *:[text-box:trim-both_cap_alphabetic]"
	}
	if props.Collapse {
		c += " @max-xs/breadcrumb:hidden @max-xs/breadcrumb:[&+[data-slot=breadcrumb-separator]]:hidden"
	}
	return utils.TwMerge(c, props.Class)
}

type LinkProps struct {
	// Attributes carry anything else the link needs, such as hx-* swap
	// attributes.
	Attributes templ.Attributes
	Class      string
	// Current marks a link to the page it is on, which a split crumb's
	// section is on the section's own page.
	Current bool
	Href    string
}

// Link is a crumb to a page above the current one.
templ Link(props LinkProps) {
	<a
		href={ templ.SafeURL(props.Href) }
		if props.Current {
			aria-current="page"
		}
		class={ utils.TwMerge(utils.IfElse(props.Current, "type-body-200-heavy text-foreground", "type-body-200 text-muted-foreground"), "hover:text-foreground hover:underline", textTrimClass, props.Class) }
		data-slot="breadcrumb-link"
		{ props.Attributes... }
	>
		{ children... }
	</a>
}

type PageProps struct {
	Attributes templ.Attributes
	Class      string
}

// Page is the current page, named but not linked.
templ Page(props PageProps) {
	<span aria-current="page" class={ utils.TwMerge("type-body-200-heavy text-foreground", textTrimClass, props.Class) } data-slot="breadcrumb-page" { props.Attributes... }>
		{ children... }
	</span>
}

type SeparatorProps struct {
	Attributes templ.Attributes
	Class      string
}

// Separator goes between items: a chevron a cap tall, centred on the
// crumbs' capitals, unless it has children.
templ Separator(props SeparatorProps) {
	<li role="presentation" aria-hidden="true" class={ utils.TwMerge("inline-flex shrink-0 items-center type-body-200 text-muted-foreground", props.Class) } data-slot="breadcrumb-separator" { props.Attributes... }>
		@separatorContent(ctx)
	</li>
}

type EllipsisProps struct {
	Attributes templ.Attributes
	Class      string
}

// Ellipsis stands in for the Collapse items after it while the trail is too
// narrow for them, with its own separator after it. It goes where the first
// of them would be.
templ Ellipsis(props EllipsisProps) {
	<li class={ utils.TwMerge("hidden shrink-0 items-center gap-1.5 type-body-200 text-muted-foreground @max-xs/breadcrumb:inline-flex", props.Class) } data-slot="breadcrumb-ellipsis" { props.Attributes... }>
		<span aria-hidden="true" class={ textTrimClass }>…</span>
		<span class="sr-only">More pages</span>
		<span aria-hidden="true" class="inline-flex items-center">
			@separatorChevron()
		</span>
	</li>
}

type SwitcherProps struct {
	Align      selectbox.Align
	Attributes templ.Attributes
	Class      string
	// Href is the section root the split chip's name links to. It is unused
	// unless Split is set.
	Href string
	// ID ties the trigger to its list; random when unset.
	ID string
	// Indicator puts a dot on the chevron, for news behind one of the
	// options.
	Indicator bool
	Items     []selectbox.Entry
	// Label is the trigger's accessible name, such as "Switch section".
	Label string
	// LinkAttributes carry anything else the split chip's link needs, such
	// as hx-* swap attributes.
	LinkAttributes templ.Attributes
	// Name is the form field the choice submits as; empty for none.
	Name string
	// Split divides the chip in two: the name links to Href and only the
	// chevron opens the list. Without it the whole chip opens the list, for
	// the section's own page, where linking to it would go nowhere.
	Split bool
	// Text is the section's name, drawn on the chip.
	Text  string
	Value string
}

// switcherChipClass is the outlined chip both variants draw, the dropdown
// trigger the settings header had before it was a breadcrumb. It is 32px
// tall with the label trimmed to its cap height and centred, so the trail's
// separators line up with it.
const switcherChipClass = "h-8 border bg-background text-foreground outline-none hover:bg-ghost-hover hover:text-foreground focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-ring"

// switcherTriggerClass overrides the selectbox field trigger's muted pill
// for the chip, and hides its up-down chevron for a down one.
const switcherTriggerClass = "relative " + switcherChipClass + " data-[popup-open]:bg-ghost-hover data-[popup-open]:text-foreground [&>span:last-child]:hidden"

// Switcher is the section crumb as a chip that opens a selectbox of the
// places it could be instead. Unsplit, the whole chip -- the name and a
// down chevron -- is the trigger. Split, the name is a plain crumb link to the
// section's root and a small chip holding only the chevron is the trigger.
// The chips replace the selectbox trigger's pill with squircle-md. Its
// children are selectbox.Item options, which may carry classes of their own,
// such as an indent for a child option.
templ Switcher(props SwitcherProps) {
	<span class={ utils.TwMerge("inline-flex shrink-0 items-center gap-1.5", props.Class) } data-slot="breadcrumb-switcher" { props.Attributes... }>
		if props.Split {
			<a
				href={ templ.SafeURL(props.Href) }
				class={ "type-body-200 text-muted-foreground hover:text-foreground hover:underline", textTrimClass }
				data-slot="breadcrumb-switcher-link"
				{ props.LinkAttributes... }
			>{ props.Text }</a>
		}
		@selectbox.Root(selectbox.RootProps{ID: props.ID, Items: props.Items, Label: props.Label, Name: props.Name, Value: props.Value}) {
			if props.Split {
				@selectbox.Trigger(selectbox.TriggerProps{Look: selectbox.LookPill, Class: "size-7 justify-center gap-0 squircle-md ps-0 pr-0 " + switcherTriggerClass}) {
					@switcherChevron(props.Indicator)
				}
			} else {
				@selectbox.Trigger(selectbox.TriggerProps{Look: selectbox.LookPill, Class: "gap-1 squircle-md ps-2.5 pr-2.5 type-body-200-heavy " + switcherTriggerClass}) {
					<span class={ "block", textTrimClass }>{ props.Text }</span>
					@switcherChevron(props.Indicator)
				}
			}
			@selectbox.Positioner(selectbox.PositionerProps{Align: props.Align}) {
				@selectbox.Popup(selectbox.PopupProps{}) {
					{ children... }
				}
			}
		}
	</span>
}

templ switcherChevron(indicator bool) {
	@icons.Render(icons.ExpandDown, icons.Props{Size: 14})
	if indicator {
		<span class="absolute top-1 right-1 size-1.5 rounded-full bg-amber-600" aria-hidden="true" data-slot="breadcrumb-switcher-indicator"></span>
	}
}

// separatorChevron is the default separator: a chevron one x-height tall,
// centred on the cap height. Lucide draws it in the middle half of its box,
// so the box is two x-heights square; the vertical margin pulls its layout
// height back to one cap, which the trail centres against its cap-trimmed
// text, and the horizontal margin trims the empty sides.
templ separatorChevron() {
	@icons.Render(icons.ExpandRight, icons.Props{Class: "mx-[-0.625ex] my-[calc((1cap-2ex)/2)] block size-[2ex]", StrokeWidth: "2"})
}
