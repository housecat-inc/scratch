package ai

import (
	"github.com/housecat-inc/scratch/ui/icons"
)

type TemplateItem struct {
	Description string
	Installed   bool
	Slug        string
	Title       string
}

type ChatData struct {
	ConversationID string
	Prompt         string
	Slug           string
	TemplateItems  []TemplateItem
}

templ ChatFull(data ChatData) {
	<div id="chat-welcome" class="flex flex-col items-center justify-center" style="height: 100%;" data-prompt={ data.Prompt }>
		<div class="w-full max-w-2xl space-y-6 px-6">
			<h1 class="text-center type-title-600-heavy">How can I help?</h1>
			<div class="grid grid-cols-2 gap-3">
				if len(data.TemplateItems) > 0 {
					for _, item := range data.TemplateItems {
						@TemplateCardItem(item)
					}
				} else {
					@ideaCard("Morning Briefing", "Generate and send a morning briefing every day with top priorities", "Create a project to generate and send morning briefing every day with my top priorities for the day")
					@templateCard("Track Tasks", "Automatically create tasks based on email and meeting activity", "tasks")
					@templateCard("Meeting Prep", "Automatically create prep and follow-up tasks based on your calendar and meeting notes", "meetings")
					@templateCard("Email Follow-ups", "Search and save important emails, threads, and follow-ups to track", "emails")
				}
			</div>
			<div>
				<textarea
					id="chat-input"
					placeholder="Ask me anything..."
					class="min-h-[100px] w-full resize-none rounded-lg border bg-background p-4 focus:ring-2 focus:ring-ring"
					rows="3"
				></textarea>
				<div class="mt-3 flex items-center justify-end">
					<button id="send-btn" class="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 type-body-200-medium whitespace-nowrap text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50">
						Send
						@icons.Render(icons.Sent, icons.Props{Size: 14, Class: "ml-1"})
					</button>
				</div>
			</div>
		</div>
	</div>
	<template data-script="chat-full"></template>
}

templ ideaCard(title, subtitle, prompt string) {
	<button class="idea-card flex flex-col justify-start rounded-lg border p-3 text-left type-body-200 transition-colors hover:bg-muted/50" data-prompt={ prompt }>
		<b>{ title }</b>
		<span class="mt-1 type-caption-100 text-muted-foreground">{ subtitle }</span>
	</button>
}

templ templateCard(title, subtitle, template string) {
	<button data-slot="project-template-card" class="template-card flex flex-col justify-start rounded-lg border p-3 text-left type-body-200 transition-colors hover:bg-muted/50" data-template={ template }>
		<b>{ title }</b>
		<span class="mt-1 type-caption-100 text-muted-foreground">{ subtitle }</span>
	</button>
}

templ TemplateCardItem(item TemplateItem) {
	if item.Installed {
		<button data-slot="project-template-card" class="template-card flex flex-col justify-start rounded-lg border border-green-500 bg-green-50 p-3 text-left type-body-200 transition-colors hover:bg-green-100 dark:bg-green-950/20 dark:hover:bg-green-950/40" data-template={ item.Slug }>
			<span class="flex items-center gap-1.5 type-bold text-green-700 dark:text-green-400">
				@icons.Render(icons.Complete, icons.Props{Size: 14})
				{ item.Title }
			</span>
			if item.Description != "" {
				<span class="mt-1 type-caption-100 text-muted-foreground">{ item.Description }</span>
			}
		</button>
	} else {
		<button data-slot="project-template-card" class="template-card flex flex-col justify-start rounded-lg border p-3 text-left type-body-200 transition-colors hover:bg-muted/50" data-template={ item.Slug }>
			<b>{ item.Title }</b>
			if item.Description != "" {
				<span class="mt-1 type-caption-100 text-muted-foreground">{ item.Description }</span>
			}
		</button>
	}
}
