package uikit

import (
	"net/mail"
	"strings"

	"github.com/housecat-inc/scratch/ui/components/avatar"
	"github.com/housecat-inc/scratch/ui/components/collapsible"
	"github.com/housecat-inc/scratch/ui/components/copychip"
	"github.com/housecat-inc/scratch/ui/icons"
	"github.com/housecat-inc/scratch/ui/utils"
)

type ThreadEntryMeta struct {
	Attrs templ.Attributes
	Label string
	Value string
}

type ContactProps struct {
	AvatarURL string
	Email     string
	Kind      string
	Name      string
}

type ThreadEntryProps struct {
	Actions          templ.Component
	Bcc              string
	BccContacts      []ContactProps
	BodyClass        string
	BodyExpandable   bool
	BodyOpen         bool
	Cc               string
	CcContacts       []ContactProps
	ExpandedMeta     []ThreadEntryMeta
	From             string
	FromContacts     []ContactProps
	HeaderBadge      string
	HeaderBadgeAttrs templ.Attributes
	Kind             string
	Meta             string
	MetaAttrs        templ.Attributes
	// MetaOpen replaces Meta while the entry is expanded, from sm up -- the full
	// send time in place of the short date -- so the exact time is on show
	// without a line of its own in the header. A narrow screen keeps the short
	// date whatever the state; the full one would not fit beside the title.
	MetaOpen         string
	MetaOpenAttrs    templ.Attributes
	PrefixIcon       icons.Name
	PrefixLabel      string
	PrefixLabelClass string
	RootAttrs        templ.Attributes
	RootClass        string
	Snippet          string
	SnippetComponent templ.Component
	// Source names where the entry came from. It draws the accent gutter and names
	// the entry for anything selecting on [data-source].
	Source            string
	Style             map[string]templ.SafeCSSProperty
	SubtitleComponent templ.Component
	Subtitle          string
	SubtitleHref      string
	Title             string
	To                string
	ToContacts        []ContactProps
}

templ ThreadEntry(props ThreadEntryProps) {
	{{ entryID := threadEntryID(props) }}
	{{ contentID := entryID + "-content" }}
	<article
		class={ "group/entry hc-thread-entry relative block border-b", props.RootClass }
		style={ props.Style }
		data-slot="hc-thread-entry"
		data-thread-entry
		data-thread-entry-kind={ props.Kind }
		if props.Source != "" {
			data-source={ props.Source }
		}
		{ props.RootAttrs... }
	>
		@EntrySourceAccent(props.Source)
		<div data-slot="hc-thread-entry-frame">
			@collapsible.Collapsible(collapsible.Props{Attributes: templ.Attributes{"data-slot": "hc-thread-entry-main"}, Class: "min-w-0 flex-1 group/collapsible", ID: entryID + "-main", Open: threadEntryOpen(props)}) {
				if threadEntryToggleable(props) {
					// Every control nested in the header carries utils.OwnEvents(), so
					// a click on one is its own and still reaches every listener on the
					// document; nothing in the entry stops an event.
					@collapsible.Trigger(collapsible.TriggerProps{Class: threadEntryColumns + " " + HoverActionsRow + " " + threadEntryFocusRing + " min-w-0 cursor-pointer overflow-clip pl-[var(--entry-list-p-l)] pr-[var(--entry-list-p-r)] pt-3 pb-3", Attributes: threadEntryTriggerAttrs(props, contentID)}) {
						@ThreadEntryHeader(props)
					}
					// Visibility keys off the collapsible's own state, which the server
					// renders, so an entry is correct on first paint and after a swap with
					// no script involved. Below docked the body spans the avatar's column too,
					// inset only by the list's padding, so a phone reads the message at
					// nearly full width. Plain-text and HTML bodies share that inset; any
					// further padding is the sender's own markup.
					@collapsible.Content(collapsible.ContentProps{ID: contentID, Class: "hidden min-w-0 pr-[var(--entry-list-p-r)] pb-3 pl-[var(--entry-list-p-l)] group-data-[tui-collapsible-state=open]/collapsible:block", Attributes: templ.Attributes{"data-slot": "hc-thread-entry-content"}}) {
						<div class={ threadEntryColumns }>
							<div class={ threadEntryBodyClass("col-start-2 max-docked:col-span-2 max-docked:col-start-1"), threadEntryFrameInsets, props.BodyClass } data-slot="hc-thread-entry-body" data-thread-entry-body>
								{ children... }
							</div>
						</div>
					}
				} else {
					// An entry with nothing to expand shows its header and summary only; the
					// body it was given has no state to reveal it in.
					<div class={ threadEntryColumns + " " + HoverActionsRow + " min-w-0 overflow-clip pl-[var(--entry-list-p-l)] pr-[var(--entry-list-p-r)] py-3" }>
						@ThreadEntryHeader(props)
					</div>
				}
			}
		</div>
	</article>
}

// The entry is two columns -- the avatar's gutter, then everything else -- and
// the second column is two rows stacked: the sender line against its date, then
// whatever the entry's state has to say against the actions. Each row is its own
// flex container, so the date and the actions are laid out by the row they
// belong to rather than by a shared right-hand column, and neither has to be
// positioned to stay put.
templ ThreadEntryHeader(props ThreadEntryProps) {
	<div class="col-span-2 grid grid-cols-subgrid items-start" data-slot="hc-thread-entry-header" data-thread-entry-header>
		@ThreadEntryAvatar(props)
		<div class="col-start-2 flex min-w-0 flex-col gap-1" data-slot="hc-thread-entry-headline">
			// items-baseline down the whole line: the badge is 11px inside an 18px
			// pill, the title 14px and the date 12px, so aligning their boxes left
			// three different text sizes sitting at three different heights. On the
			// baseline they read as one line, which is what they are.
			<div class="flex min-w-0 items-baseline gap-2" data-slot="hc-thread-entry-head-row">
				<div class="flex min-w-0 grow items-baseline gap-2" data-slot="hc-thread-entry-title-row">
					@ThreadEntryHeaderBadge(props, "hc-thread-entry-collapsed-badge")
					@ThreadEntryHeaderTitle(props)
				</div>
				@ThreadEntryDate(props)
			</div>
			@ThreadEntrySummary(props)
		</div>
	</div>
}

// ThreadEntrySummary is the second row. Its left side is whichever account of
// the message the state calls for -- the one-line preview while the entry is
// shut, the From/To/CC lanes once it is open -- and the actions sit to the right
// of both. The two never show at once, so they share the one column rather than
// occupying separate rows that would each have to reserve height.
//
// The row survives expanding even though the preview does not: the actions
// belong to the message in either state.
templ ThreadEntrySummary(props ThreadEntryProps) {
	if props.Snippet != "" || props.SnippetComponent != nil || props.Actions != nil || threadEntryHeaderExpandable(props) || props.PrefixLabel != "" {
		// items-start, not items-center: the actions are taller than a line of
		// preview text, so centred content would slide as they appeared. Anchored
		// to the top the preview stays put whatever else the row is holding.
		//
		// min-h-8 is the height of the tallest action an entry carries, a
		// ButtonIcon at IconSizeMd, held whether or not the actions are on show.
		// The reservation has to track that size: set lower, a row whose Actions
		// render nothing is a line of preview tall while its neighbours are a
		// button tall, and the list gains a step wherever an entry has no
		// controls.
		<div class="flex min-h-8 min-w-0 items-start gap-2" data-slot="hc-thread-entry-body-summary">
			<div class="min-w-0 grow">
				<div class="pt-1">
					@ThreadEntryHeaderDetails(props)
				</div>
				@ThreadEntrySnippet(props)
			</div>
			@ThreadEntryHeaderActions(props)
		</div>
	}
}

// ThreadEntryDate is the sender line's right-hand end. It keeps the short date
// and, from sm up while the entry is open, swaps in the full send time.
templ ThreadEntryDate(props ThreadEntryProps) {
	if props.Meta != "" || props.MetaOpen != "" {
		<span class="shrink-0 type-caption-100 whitespace-nowrap text-muted-foreground" data-slot="hc-thread-entry-date">
			if props.Meta != "" {
				<span { threadEntryMetaAttrs(props)... }>{ props.Meta }</span>
			}
			if props.MetaOpen != "" {
				<span class="hidden sm:group-data-[tui-collapsible-state=open]/collapsible:inline" { props.MetaOpenAttrs... }>{ props.MetaOpen }</span>
			}
		</span>
	}
}

templ ThreadEntryAvatar(props ThreadEntryProps) {
	{{ contact := threadEntryAvatarContact(props) }}
	@avatar.Avatar(avatar.Props{
		Class:    "col-start-1 self-start",
		Email:    contact.Email,
		ImageURL: contact.AvatarURL,
		Name:     contact.Name,
	})
}

templ ThreadEntryHeaderDetails(props ThreadEntryProps) {
	<div class="hidden min-w-0 space-y-1 type-paragraph-200 select-text group-data-[tui-collapsible-state=open]/collapsible:block" data-slot="hc-thread-entry-meta" data-thread-entry-title-expanded>
		@ThreadEntryPrefixLabel(props)
		if threadEntryHasContacts(props) {
			@ThreadEntryContactLane("From", threadEntryFromContacts(props))
			@ThreadEntryContactLane("To", threadEntryToContacts(props))
			@ThreadEntryContactLane("CC", threadEntryCcContacts(props))
			@ThreadEntryContactLane("BCC", threadEntryBccContacts(props))
			for _, item := range props.ExpandedMeta {
				<div class="min-w-0" data-slot="hc-thread-entry-meta-line">
					if item.Label != "" {
						<b>{ item.Label + ": " }</b>
					}
					<span class="break-words select-text" { item.Attrs... }>{ item.Value }</span>
				</div>
			}
		} else {
			for _, item := range threadEntryExpandedMeta(props) {
				<div class="min-w-0" data-slot="hc-thread-entry-meta-line">
					if item.Label != "" {
						<b>{ item.Label + ": " }</b>
					}
					<span class="break-words select-text" { item.Attrs... }>{ item.Value }</span>
				</div>
			}
		}
	</div>
}

templ ThreadEntryPrefixLabel(props ThreadEntryProps) {
	if props.PrefixLabel != "" {
		<div class="flex min-w-0" data-slot="hc-thread-entry-meta-line">
			<span class={ "inline-flex max-w-full items-center gap-1 rounded px-1.5 py-0.5 type-body-100-medium", props.PrefixLabelClass } data-slot="hc-thread-entry-prefix-label">
				if props.PrefixIcon != "" {
					@icons.Render(props.PrefixIcon, icons.Props{Size: 12, Class: "shrink-0"})
				}
				<span class="truncate">{ props.PrefixLabel }</span>
			</span>
		</div>
	}
}

// threadEntryLaneColor is the muted grey a contact lane and everything in it
// renders in, including links -- a lane is a dense metadata row, not a place for
// primary-colored anchors.
const threadEntryLaneColor = "text-[color-mix(in_srgb,var(--gm-secondary)_78%,var(--gm-surface))]"

// ThreadEntryContactLane lists one header field's recipients. The recipients
// are a list, so they are a ul: a screen reader announces how many there are
// and which one it is on, which the run of spans it replaces could not say.
//
// The lane copies as `To: Jane Doe <jane@example.com>, <ops@example.com>` with
// no script involved. Everything that a mail client's recipient field needs and
// a reader does not -- the angle brackets, the comma between two contacts, the
// quotes around a name that holds one -- is in the markup as transparent text in
// a zero-width box, so the browser carries it the way it carries any other
// character and however much of the lane was selected.
//
// What the browser does not do on its own is keep it to one line, and that is
// what decides the boxes here. A selection dragged across block-level boxes is
// serialised with a newline between each, and a flex container makes its items
// block-level whatever they were, so the lane used to copy as a column: the
// label, then each name, then each address, one per line. Nothing between this
// div and the text inside a chip is a flex box any more. The lane is a plain
// block, the list and its items are inline, and the gaps flex used to draw are
// real spaces where the clipboard wants one and margins where it does not.
//
// Two lanes still copy one per line, which is what a mail header should do: they
// are block-level siblings, and that is the one newline worth having.
//
// list-none is not decoration: an li is display:list-item by default, so without
// it every contact draws a bullet.
templ ThreadEntryContactLane(label string, contacts []ContactProps) {
	if len(contacts) > 0 {
		<div class={ "min-w-0 type-body-200 leading-6", threadEntryLaneColor } data-slot="hc-thread-entry-contact-lane">
			<span class="type-body-200-medium" data-slot="hc-thread-entry-contact-label">{ label + ":" }</span>{ " " }<ul class="inline list-none" data-slot="hc-thread-entry-contact-list">
				// Only the contact itself owns its clicks -- its copy chip has a job to
				// do -- so the rest of the lane, label and gaps alike, still collapses
				// the entry like any other part of the trigger.
				//
				// mr-2 is the gap between two contacts, and the comma that separates
				// them for the clipboard takes up none of it. A margin cannot be
				// copied and the comma cannot be seen, which is the division of labour
				// the lane wants.
				for i, contact := range contacts {
					<li class={ utils.TwMerge("inline", utils.If(i < len(contacts)-1, "mr-2")) } data-slot="hc-thread-entry-contact-item" { utils.OwnEvents()... }>@Contact(contact)@utils.Adjacent(contactSeparator(i, len(contacts)))</li>
				}
			</ul>
		</div>
	}
}

// contactSeparator is the `, ` an address list needs between two recipients and
// the lane draws none of. Its trailing space survives because ZeroWidthMark
// holds every mark to whitespace-pre.
func contactSeparator(index, count int) templ.Component {
	if index >= count-1 {
		return nil
	}
	return ZeroWidthMark(", ", "text-transparent")
}

// Contact renders one name/email pair: the name as plain text, then the
// email in a CopyChip. A contact with no email has nothing to copy and renders
// as plain text.
//
// The space between the name and the chip is a real space rather than a gap,
// because an address list wants one there too. It leads the address rather than
// trailing the name so that an address standing on its own does not copy with a
// space in front of it -- and because an expression written after a component
// call is read as that component's children and never rendered at all.
templ Contact(props ContactProps) {
	{{ name, email := strings.TrimSpace(props.Name), strings.TrimSpace(props.Email) }}
	if name != "" || email != "" {
		<span class={ "inline-block max-w-full type-body-200", threadEntryLaneColor } data-slot="contact">
			if name != "" {
				@contactName(name)
			}
			if email != "" {
				{ utils.If(name != "", " ") }@copychip.CopyChip(copychip.Props{
					After:   ZeroWidthMark(">", "text-transparent"),
					Before:  ZeroWidthMark("<", "-translate-x-full text-transparent"),
					Tooltip: "Copy email",
					Value:   email,
				})
			}
		</span>
	}
}

// A plain inline box, and it has to be one. The lane is a line of text and the
// name has to sit on its baseline, but an inline-block that clips its overflow --
// which is what truncate is -- reports its bottom margin edge as its baseline
// instead of its text's, so it cannot align with the label beside it however it
// is nudged. Inline text needs no such rule and simply sits where the rest of the
// line does.
//
// What that gives up is the ellipsis. A long name wraps to the next line now,
// which the lane was already free to do, and reads in full rather than being cut
// short -- break-words is there for the one word too long to wrap out of.
// Each branch says its own select- rule rather than overriding one here: the two
// are the same Tailwind property and a class list carrying both would be settled
// by their order in the stylesheet, not by the one written last.
const contactNameClass = "break-words text-foreground"

// contactName draws the display name as it reads and copies it as RFC 5322 needs
// it read back. An unquoted name that holds a comma is two broken recipients when
// pasted, so a name that needs quoting gets its quotes the same way the address
// gets its brackets: transparent, in a zero-width box, on either side of a name
// that still copies as itself.
//
// A name carrying a quote or a backslash cannot be handled that way, because the
// escaping RFC 5322 asks for changes the characters of the name itself and the
// name on screen has to stay the name. There the visible copy stands aside --
// select-none, so it never reaches a clipboard -- and the whole escaped form
// travels in a mark instead.
//
// That mark is the one that must not paint its selection. Every other mark is a
// character or two wide, so the highlight a selection gives it reads as the
// punctuation it stands for; this one is as long as the name and takes no width,
// so its highlight lands square on top of the address beside it. selection
// transparent leaves the name unlit while it is dragged over, which is quiet
// beside a block of colour sitting over the address.
templ contactName(name string) {
	if !contactNameNeedsQuoting(name) {
		<span class={ contactNameClass, "select-text" } data-slot="contact-name">{ name }</span>
	} else if !strings.ContainsAny(name, `\"`) {
		@ZeroWidthMark(`"`, "-translate-x-full text-transparent")<span class={ contactNameClass, "select-text" } data-slot="contact-name">{ name }</span>@ZeroWidthMark(`"`, "text-transparent")
	} else {
		<span class={ contactNameClass, "select-none" } data-slot="contact-name">{ name }</span>@ZeroWidthMark(contactQuotedName(name), "text-transparent selection:bg-transparent")
	}
}

// contactNameNeedsQuoting reports whether an address list would read the name as
// anything other than one display name. RFC 5322 gives each of these characters
// a meaning of its own in the surrounding grammar.
func contactNameNeedsQuoting(name string) bool {
	return strings.ContainsAny(name, `()<>[]:;@\,."`)
}

var contactNameEscaper = strings.NewReplacer(`\`, `\\`, `"`, `\"`)

func contactQuotedName(name string) string {
	return `"` + contactNameEscaper.Replace(name) + `"`
}

// ZeroWidthMark is punctuation that reads as part of the line but takes no part
// in its measurements: the outer box is w-0 and the glyph overflows it, so
// adding one cannot move anything along or wrap a lane that would otherwise
// have fitted.
//
// It is real text in the DOM, which is the point -- a selection dragged over it
// carries it the way it carries any other character, with no script involved and
// no dependence on how much of the lane was selected.
//
// The inner span is what lets a mark sit to the *left* of where it is anchored.
// A w-0 box overflows rightwards, which is right for a closing bracket and wrong
// for an opening one -- that would paint over the first character rather than
// before it. -translate-x-full moves the glyph back by exactly its own width,
// whatever that width turns out to be, which a margin in ch could only
// approximate.
//
// class is also where a mark says it should not be seen. All of them are
// text-transparent: the lane draws no punctuation of its own, and these exist so
// that a selection dragged over an address copies as <someone@example.com>
// rather than as a bare address. Transparent rather than clipped or hidden,
// because clipped and hidden text is a guess about how a browser serialises a
// selection, while a transparent glyph is plainly text and plainly selectable.
//
// aria-hidden: a screen reader announcing "less than" around every address would
// be reading punctuation that is not really there.
// whitespace-pre is load-bearing twice over, and both times because the box is
// w-0. A zero-width box offers its contents zero width to lay out in, so a mark
// of more than one word wraps to one word per line and grows a line box that
// pushes everything below it down -- invisibly, since the text is transparent.
// And collapsible whitespace at the end of a box is dropped, which cost the
// separator between two contacts its space and ran two addresses together.
templ ZeroWidthMark(text string, class string) {
	<span class="inline-block w-0 whitespace-pre" aria-hidden="true" data-slot="zero-width-mark"><span class={ "inline-block select-text", class }>{ text }</span></span>
}

templ ThreadEntryHeaderTitle(props ThreadEntryProps) {
	<span class="min-w-0" data-slot="hc-thread-entry-title" data-thread-entry-title>
		<span class="block truncate type-body-200-medium">
			if from, to := threadEntryTitleParts(props); to != "" {
				{ from }
				<span class="type-body-200 text-muted-foreground">to</span>
				{ to }
			} else {
				{ threadEntryTitle(props) }
			}
		</span>
		if props.SubtitleComponent != nil {
			@props.SubtitleComponent
		} else if props.Subtitle != "" {
			if props.SubtitleHref != "" {
				<a href={ templ.SafeURL(props.SubtitleHref) } class="mt-0 flex min-w-0 items-center gap-1 type-body-100 text-primary hover:underline" target="_blank" rel="noopener noreferrer" { utils.OwnEvents()... }>
					<span class="truncate">{ props.Subtitle }</span>
				</a>
			} else {
				<span class="mt-0 block truncate type-caption-100 text-muted-foreground">{ props.Subtitle }</span>
			}
		}
	</span>
}

// threadEntryFocusRing draws the row's keyboard focus inset into the row rather
// than around it: the row runs edge to edge inside a scrolling reader, so
// anything drawn outside it is clipped to a sliver. It is drawn on a
// pseudo-element stacked above the actions cluster, because the cluster and
// its backdrop are positioned at z-index 2 and paint over the row's own
// outline or shadow wherever they overlap the edge.
const threadEntryFocusRing = "relative focus-visible:outline-none" +
	" after:pointer-events-none after:absolute after:inset-0 after:z-[3] after:content-['']" +
	" focus-visible:after:ring-2 focus-visible:after:ring-inset focus-visible:after:ring-ring"

// threadEntryColumns is the entry's two-column track: the --reader-gutter the
// avatar sits in, then the message. Declared once so the trigger, the header
// and the body cannot drift apart. The entry's horizontal padding rides on the
// column contents rather than on a wrapper, so the whole row -- gutter included
// -- falls inside the trigger and is clickable.
const threadEntryColumns = "grid grid-cols-[var(--reader-gutter)_minmax(0,1fr)] gap-x-[var(--entry-list-gap)]"

// threadEntryFrameInsets lets an email's frame in the body span the whole
// card: it bleeds out to the card's edges by the space between them and the
// body -- the content's padding, plus the avatar's column and gap where the
// body sits beside it from docked up -- and keeps that space inside the email
// instead, so the email's text still starts where it did: at the sender's name
// from docked up, at the avatar's edge below docked, where the body spans the
// avatar's column. The bottom inset is the content's pb-3. See
// app/ui/mail/frame.templ.
const threadEntryFrameInsets = "[--mail-frame-inset-left:calc(var(--entry-list-p-l)_+_var(--reader-gutter)_+_var(--entry-list-gap))]" +
	" max-docked:[--mail-frame-inset-left:var(--entry-list-p-l)]" +
	" [--mail-frame-inset-right:var(--entry-list-p-r)] [--mail-frame-inset-bottom:0.75rem]"

func threadEntryToggleable(props ThreadEntryProps) bool {
	return props.BodyExpandable || threadEntryHeaderExpandable(props)
}

// ThreadEntryDOMIDIn carries the ids an entry may be known by. The first one
// set names the entry.
type ThreadEntryDOMIDIn struct {
	DraftID   string
	GmailID   string
	ItemID    string
	MessageID string
	SendID    string
}

// ThreadEntryDOMID mints the id an entry carries on its root. A re-render of the
// same entry has to produce the same id, because that is what lets a morph swap
// pair the old node with the new one instead of replacing it, and every caller
// has to agree on it, so they all come through here.
func ThreadEntryDOMID(in ThreadEntryDOMIDIn) string {
	switch {
	case in.GmailID != "":
		return "msg-" + in.GmailID
	case in.MessageID != "":
		return "message-" + in.MessageID
	case in.SendID != "":
		return "send-" + in.SendID
	case in.DraftID != "":
		return "draft-" + in.DraftID
	case in.ItemID != "":
		return "item-" + in.ItemID
	}
	return ""
}

func threadEntryID(props ThreadEntryProps) string {
	if id, ok := props.RootAttrs["id"].(string); ok && id != "" {
		return id
	}
	return utils.RandomID()
}

func threadEntryOpen(props ThreadEntryProps) bool {
	return props.BodyOpen && props.BodyExpandable
}

func threadEntryTriggerAttrs(props ThreadEntryProps, contentID string) templ.Attributes {
	return templ.Attributes{
		"aria-controls": contentID,
		"aria-expanded": threadEntryBool(threadEntryOpen(props)),
		"aria-label":    "Expand message",
		"data-slot":     "hc-thread-entry-trigger",
		"role":          "button",
		"tabindex":      "0",
	}
}

// threadEntryMetaAttrs hides the short date while the entry is open only when
// there is a full one to take its place, and only where it does.
func threadEntryMetaAttrs(props ThreadEntryProps) templ.Attributes {
	attrs := templ.Attributes{}
	for k, v := range props.MetaAttrs {
		attrs[k] = v
	}
	if props.MetaOpen != "" {
		attrs["class"] = "sm:group-data-[tui-collapsible-state=open]/collapsible:hidden"
	}
	return attrs
}

templ ThreadEntryHeaderBadge(props ThreadEntryProps, slot string) {
	if props.HeaderBadge != "" {
		@DraftBadge(DraftBadgeProps{Attributes: threadEntryBadgeAttrs(props), Button: props.HeaderBadgeAttrs != nil, Class: "shrink-0", Slot: slot, Text: props.HeaderBadge})
	}
}

// threadEntryBadgeAttrs gives a badge that opens the draft the entry's own
// events, so its click reaches the draft rather than toggling the entry.
func threadEntryBadgeAttrs(props ThreadEntryProps) templ.Attributes {
	if props.HeaderBadgeAttrs == nil {
		return nil
	}
	attrs := templ.Attributes{}
	for k, v := range utils.OwnEvents() {
		attrs[k] = v
	}
	for k, v := range props.HeaderBadgeAttrs {
		attrs[k] = v
	}
	return attrs
}

// threadEntryActions is the cluster in the flow of the summary row rather than
// an overlay above it. Nothing is positioned and nothing paints a backdrop: the
// buttons take their own width and the preview beside them gives it up, which is
// why the preview has to be able to shrink.
//
// A resting row spends no width on it, but it is never display:none and never
// hidden: that would take the buttons out of the tab order, and a control you
// cannot reach with the keyboard is not a control. It is laid out at all times
// and merely clipped to nothing, which leaves it focusable, in the accessibility
// tree, and reachable by Tab. Tabbing into it is itself a reveal -- the entry
// then has focus within it -- so the buttons are on screen by the time they take
// focus rather than being operated blind.
//
// interpolate-size is what makes w-max animatable; a keyword width is otherwise
// not interpolable and the cluster would snap to full width. It is set here
// rather than on :root because it inherits, and every other intrinsic size in
// the app should keep behaving as it does now.
//
// The reveal is a wipe rather than a slide: the box grows leftwards from a right
// edge the growing preview beside it has already pushed it to, and the buttons
// do not move while it does -- it simply clips what it has yet to reach. The
// inner row is what keeps its width meanwhile: flex items shrink by default and
// at width 0 would collapse rather than overflow, which is a squeeze and not a
// wipe.
//
// The padding keeps the clip edge off the buttons, so the focus ring -- a
// box-shadow painted outside the border box -- is not shaved off. The negative
// margin cancels it again, leaving the layout where it was.
//
// Both come off again at rest, and have to: a border box cannot shrink below its
// own padding, so a box asked for zero width still measured 6px and showed a 3px
// edge of the nearest button on every resting row. At rest there is no ring to
// protect, so the pair is only carried while the cluster is open.
//
// dir=rtl on the clip box is how the content is held against the right edge.
// justify-content: flex-end reads as the obvious way to do it and is not: it
// puts the overflow on the flex container's start edge, which the spec calls
// unreachable and browsers are free to clamp away, and a browser that clamps
// parks the row past the right edge where no width ever reveals it. Reversing
// the direction makes the right edge the *start* edge, so the content sits
// there by default and overflows left as ordinary, well-defined overflow. The
// inner row carries dir=ltr so the buttons keep their own order.
//
// It opens on hover, on the entry itself taking keyboard focus, on keyboard
// focus reaching anything inside the entry, and on focus of any kind reaching
// the cluster. An expanded entry holds it open outright: the reader is working
// with that message, so its actions stay on screen without a hover. That test
// reads the collapsible's own state attribute, so a server-rendered open entry
// shows its actions on first paint.
//
// The first two are separate tests and both are needed: :has() only looks at
// descendants, so has-[:focus-visible] says nothing about the entry having focus
// itself, and without focus-visible beside it tabbing onto a row leaves the
// cluster shut until focus moves on into it.
//
// Against the entry the test is focus-visible either way, because the entry is
// focusable and keeps focus after a mouse click -- focus-within there would
// leave the cluster on show long after the pointer had gone. Against the cluster
// it is focus-within, because focus inside the cluster means one of these
// buttons holds it however it got there, and a cluster closing over the control
// you are on is the one case worth ruling out.
//
// No opacity in the transition. At zero width there is nothing to see anyway, so
// fading as well only softens the edge the wipe is supposed to have.
//
// The wipe is a size change, which is exactly the kind of motion a reader who
// asks for less of it means. motion-reduce drops the transition and leaves the
// reveal itself alone: the buttons still appear, they just stop sliding open.
//
// Every state is written out in full. Tailwind finds classes by scanning source
// text, so a variant assembled at run time is invisible to it.
const threadEntryActionsClass = "flex min-w-0 shrink-0 overflow-hidden p-[3px] -m-[3px]" +
	" [interpolate-size:allow-keywords] transition-[width] duration-150 ease-out motion-reduce:transition-none" +
	" [@media(hover:hover)]:w-0 [@media(hover:hover)]:p-0 [@media(hover:hover)]:m-0" +
	" group-hover/hover-actions:[@media(hover:hover)]:w-max" +
	" group-hover/hover-actions:[@media(hover:hover)]:p-[3px]" +
	" group-hover/hover-actions:[@media(hover:hover)]:-m-[3px]" +
	" group-focus-visible/hover-actions:[@media(hover:hover)]:w-max" +
	" group-focus-visible/hover-actions:[@media(hover:hover)]:p-[3px]" +
	" group-focus-visible/hover-actions:[@media(hover:hover)]:-m-[3px]" +
	" group-has-[:focus-visible]/hover-actions:[@media(hover:hover)]:w-max" +
	" group-has-[:focus-visible]/hover-actions:[@media(hover:hover)]:p-[3px]" +
	" group-has-[:focus-visible]/hover-actions:[@media(hover:hover)]:-m-[3px]" +
	" focus-within:[@media(hover:hover)]:w-max" +
	" focus-within:[@media(hover:hover)]:p-[3px]" +
	" focus-within:[@media(hover:hover)]:-m-[3px]" +
	" group-data-[tui-collapsible-state=open]/collapsible:[@media(hover:hover)]:w-max" +
	" group-data-[tui-collapsible-state=open]/collapsible:[@media(hover:hover)]:p-[3px]" +
	" group-data-[tui-collapsible-state=open]/collapsible:[@media(hover:hover)]:-m-[3px]"

templ ThreadEntryHeaderActions(props ThreadEntryProps) {
	if props.Actions != nil {
		<div class={ threadEntryActionsClass } dir="rtl" data-slot="hc-thread-entry-actions" { utils.OwnEvents()... }>
			<div class="flex w-max shrink-0 items-center gap-0.5" dir="ltr" data-slot="hc-thread-entry-actions-row">
				@props.Actions
			</div>
		</div>
	}
}

// threadEntryShutOnly takes a box out of the flow once the entry opens. Both
// branches of the preview carry it, because both are the shut account of the
// message and the expanded lanes are the open one, and the two share the summary
// row's left cell. The row itself used to hold this for either branch; it cannot
// any more, since the actions beside them survive expanding and the row does not.
// Leaving it off the component branch showed a linked subtitle over the open body.
const threadEntryShutOnly = "group-data-[tui-collapsible-state=open]/collapsible:hidden"

// block, not the inline a span defaults to: truncate is overflow-hidden plus an
// ellipsis, and neither applies to an inline box. The preview used to be a flex
// item, which blockified it for free; inside the summary row's shared cell it
// has to ask. Without this it lays out at its full natural width, runs past the
// entry, and the actions appear to sit on top of it rather than shortening it.
templ ThreadEntrySnippet(props ThreadEntryProps) {
	if props.SnippetComponent != nil {
		<span class={ "block min-w-0", threadEntryShutOnly }>
			@props.SnippetComponent
		</span>
	} else if props.Snippet != "" {
		<span class={ "block min-w-0 truncate type-body-200 text-muted-foreground", threadEntryShutOnly } data-slot="hc-thread-entry-snippet">{ props.Snippet }</span>
	}
}

func threadEntryExpandedMeta(props ThreadEntryProps) []ThreadEntryMeta {
	if len(props.ExpandedMeta) > 0 {
		return props.ExpandedMeta
	}
	items := []ThreadEntryMeta{}
	if strings.TrimSpace(props.From) != "" {
		items = append(items, ThreadEntryMeta{Label: "From", Value: threadEntryAddressList(props.From)})
	}
	if strings.TrimSpace(props.To) != "" {
		items = append(items, ThreadEntryMeta{Label: "To", Value: threadEntryAddressList(props.To)})
	}
	if strings.TrimSpace(props.Cc) != "" {
		items = append(items, ThreadEntryMeta{Label: "CC", Value: threadEntryAddressList(props.Cc)})
	}
	if strings.TrimSpace(props.Bcc) != "" {
		items = append(items, ThreadEntryMeta{Label: "BCC", Value: threadEntryAddressList(props.Bcc)})
	}
	return items
}

// threadEntryAvatarContact picks the face of the entry: the sender when the
// entry has one, otherwise the title, so notes and workflow bubbles still get a
// letter rather than a blank circle.
func threadEntryAvatarContact(props ThreadEntryProps) ContactProps {
	if from := threadEntryFromContacts(props); len(from) > 0 {
		return from[0]
	}
	return ContactProps{Name: props.Title}
}

// threadEntryBodyClass drops the padding the body would otherwise inherit: its
// gutters come from the content wrapper, at every width.
func threadEntryBodyClass(base string) string {
	return utils.TwMerge(base, "p-0")
}

func threadEntryHeaderExpandable(props ThreadEntryProps) bool {
	return threadEntryHasContacts(props) || len(threadEntryExpandedMeta(props)) > 0
}

// threadEntryTitleParts splits the conversation line so "to" can be rendered in
// the muted token rather than at the same weight as the names either side of it.
// An entry with an explicit Title, or with no recipient, has no join to dim.
func threadEntryTitleParts(props ThreadEntryProps) (string, string) {
	if strings.TrimSpace(props.Title) != "" {
		return props.Title, ""
	}
	from := contactListDisplay(threadEntryFromContacts(props))
	to := contactListDisplay(threadEntryToContacts(props))
	if from == "" || to == "" {
		return threadEntryTitle(props), ""
	}
	return from, to
}

func threadEntryTitle(props ThreadEntryProps) string {
	if strings.TrimSpace(props.Title) != "" {
		return props.Title
	}
	from := contactListDisplay(threadEntryFromContacts(props))
	to := contactListDisplay(threadEntryToContacts(props))
	if from != "" && to != "" {
		return from + " to " + to
	}
	if from != "" {
		return from
	}
	return to
}

func threadEntryAddressList(raw string) string {
	raw = strings.TrimSpace(raw)
	if raw == "" {
		return ""
	}
	if list, err := mail.ParseAddressList(raw); err == nil && len(list) > 0 {
		out := make([]string, 0, len(list))
		for _, addr := range list {
			out = append(out, threadEntryAddress(addr))
		}
		return strings.Join(out, ", ")
	}
	if addr, err := mail.ParseAddress(raw); err == nil {
		return threadEntryAddress(addr)
	}
	return raw
}

func threadEntryAddress(addr *mail.Address) string {
	name := strings.TrimSpace(addr.Name)
	email := strings.TrimSpace(addr.Address)
	if name != "" {
		return name
	}
	return email
}

func threadEntryHasContacts(props ThreadEntryProps) bool {
	return len(threadEntryFromContacts(props))+len(threadEntryToContacts(props))+len(threadEntryCcContacts(props))+len(threadEntryBccContacts(props)) > 0
}

func threadEntryFromContacts(props ThreadEntryProps) []ContactProps {
	return contactsOrParse(props.FromContacts, props.From)
}

func threadEntryToContacts(props ThreadEntryProps) []ContactProps {
	return contactsOrParse(props.ToContacts, props.To)
}

func threadEntryCcContacts(props ThreadEntryProps) []ContactProps {
	return contactsOrParse(props.CcContacts, props.Cc)
}

func threadEntryBccContacts(props ThreadEntryProps) []ContactProps {
	return contactsOrParse(props.BccContacts, props.Bcc)
}

func contactsOrParse(contacts []ContactProps, raw string) []ContactProps {
	if len(contacts) > 0 {
		return contacts
	}
	return ParseContacts(raw)
}

func ParseContacts(raw string) []ContactProps {
	raw = strings.TrimSpace(raw)
	if raw == "" {
		return nil
	}
	if list, err := mail.ParseAddressList(raw); err == nil && len(list) > 0 {
		out := make([]ContactProps, 0, len(list))
		for _, addr := range list {
			out = append(out, ContactProps{Name: strings.TrimSpace(addr.Name), Email: strings.TrimSpace(addr.Address)})
		}
		return out
	}
	if addr, err := mail.ParseAddress(raw); err == nil {
		return []ContactProps{{Name: strings.TrimSpace(addr.Name), Email: strings.TrimSpace(addr.Address)}}
	}
	return []ContactProps{{Name: raw}}
}

func contactListDisplay(contacts []ContactProps) string {
	out := make([]string, 0, len(contacts))
	for _, contact := range contacts {
		if label := contactDisplayName(contact); label != "" {
			out = append(out, label)
		}
	}
	return strings.Join(out, ", ")
}

func contactDisplayName(contact ContactProps) string {
	if strings.TrimSpace(contact.Name) != "" {
		return strings.TrimSpace(contact.Name)
	}
	return strings.TrimSpace(contact.Email)
}

func threadEntryBool(v bool) string {
	if v {
		return "true"
	}
	return "false"
}
