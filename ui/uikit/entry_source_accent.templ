package uikit

// EntrySourceAccent is the coloured gutter down the left edge of a thread entry
// that says where the entry came from -- a draft, a note, a Slack message.
//
// A real element rather than a ::before, so it can carry a slot, be found in the
// DOM, and be styled like anything else. It colours itself: data-source both
// names the source and selects the custom property holding that source's colour,
// so the entry above it has nothing to pass down.
//
// The entry it sits in supplies the positioning context -- mark it `relative`.
templ EntrySourceAccent(source string) {
	if source != "" {
		<span
			class="pointer-events-none absolute inset-y-0 left-0 w-1 bg-[var(--hc-source-accent,var(--source-default))]"
			data-slot="entry-source-accent"
			data-source={ source }
			aria-hidden="true"
		></span>
	}
}
